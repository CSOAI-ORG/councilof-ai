{
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://35.242.143.249/api/:path*" },
    { "source": "/mcp/:path*", "destination": "http://35.242.143.249/mcp/:path*" },
    { "source": "/verify/:path*", "destination": "http://35.242.143.249/verify/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
