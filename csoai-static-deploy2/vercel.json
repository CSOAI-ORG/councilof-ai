{
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {"key": "Content-Type", "value": "text/plain; charset=utf-8"}
      ]
    }
  ]
}
