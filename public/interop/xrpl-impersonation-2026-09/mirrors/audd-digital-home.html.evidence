				<div class="elementor-element elementor-element-426f47be elementor-widget__width-inherit elementor-widget elementor-widget-accordion" data-id="426f47be" data-element_type="widget" data-widget_type="accordion.default">
				<div class="elementor-widget-container">
			<style>/*! elementor - v3.14.0 - 26-06-2023 */
