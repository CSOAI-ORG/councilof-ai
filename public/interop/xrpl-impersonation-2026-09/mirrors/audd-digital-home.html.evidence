				<div class="elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-398b1f5a elementor-hidden-mobile" data-id="398b1f5a" data-element_type="column" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
