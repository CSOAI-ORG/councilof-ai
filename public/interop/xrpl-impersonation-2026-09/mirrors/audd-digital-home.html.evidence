				<div class="elementor-widget-container">
															<img decoding="async" width="58" height="48" src="https://www.audd.digital/wp-content/uploads/2022/08/Icon-Scale.png" class="attachment-large size-large wp-image-23" alt="Scale icon" style="width:100%;height:82.76%;max-width:58px" />															</div>
