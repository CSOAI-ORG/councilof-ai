<script>
function initAccordionCSS() {
  document.querySelectorAll('[data-accordion-css-init]').forEach((accordion) => {
    const closeSiblings = accordion.getAttribute('data-accordion-close-siblings') === 'true';

    accordion.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-accordion-toggle]');
      if (!toggle) return; // Exit if the clicked element is not a toggle

      const singleAccordion = toggle.closest('[data-accordion-status]');
      if (!singleAccordion) return; // Exit if no accordion container is found

      const isActive = singleAccordion.getAttribute('data-accordion-status') === 'active';
      singleAccordion.setAttribute('data-accordion-status', isActive ? 'not-active' : 'active');
      
      // When [data-accordion-close-siblings="true"]
      if (closeSiblings && !isActive) {
        accordion.querySelectorAll('[data-accordion-status="active"]').forEach((sibling) => {
          if (sibling !== singleAccordion) sibling.setAttribute('data-accordion-status', 'not-active');
        });
      }
    });
  });
}

// Initialize Accordion CSS
document.addEventListener('DOMContentLoaded', () => {
  initAccordionCSS();
});
</script>
<script>
// ============================================
// WEBFLOW DOWNLOAD TRACKER - COOKIE FUNCTIONS
// ============================================

// Cookie helper functions
function setCookie(name, value, hours) {
  const date = new Date();
  date.setTime(date.getTime() + (hours * 60 * 60 * 1000));
  const expires = "expires=" + date.toUTCString();
  document.cookie = name + "=" + value + ";" + expires + ";path=/";
}

function getCookie(name) {
  const nameEQ = name + "=";
  const ca = document.cookie.split(';');
  for(let i = 0; i < ca.length; i++) {
    let c = ca[i];
    while (c.charAt(0) == ' ') c = c.substring(1, c.length);
    if (c.indexOf(nameEQ) == 0) {
      const value = c.substring(nameEQ.length, c.length);
      return value;
    }
  }
  return null;
}

function validateEmail(email) {
  const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const isValid = re.test(String(email).toLowerCase());
  return isValid;
}
</script>

<script>
// ============================================
// HUBSPOT FORMS API FUNCTIONS
// ============================================

// REPLACE THESE WITH YOUR ACTUAL VALUES
const HUBSPOT_PORTAL_ID = '20743511';
const HUBSPOT_FORM_GUID = 'ae6e43eb-1f04-414f-af20-7022d921d051';

// Submit form to HubSpot (creates/updates contact)
async function submitToHubSpot(email) {
  const url = `https://api.hsforms.com/submissions/v3/integration/submit/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_GUID}`;
  const hubspotUtk = getCookie('hubspotutk');
  
  const data = {
    fields: [
      {
        name: 'email',
        value: email
      }
    ],
    context: {
      hutk: hubspotUtk || undefined,
      pageUri: window.location.href,
      pageName: document.title
    }
  };
  
  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(data)
    });
    
    if (response.ok) {
      const result = await response.json();
      return true;
    } else {
      return false;
    }
  } catch (error) {
    return false;
  }
}

// Track download by submitting form again with custom property
async function trackDownload(email, assetName) {
  const now = new Date();
  const dateStr = now.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
  
  const downloadNote = `Downloaded ${assetName} on ${dateStr}`;
  
  const url = `https://api.hsforms.com/submissions/v3/integration/submit/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_GUID}`;
  const hubspotUtk = getCookie('hubspotutk');
  
  const data = {
    fields: [
      {
        name: 'email',
        value: email
      },
      {
        name: 'gated_form_last_downloaded_asset',
        value: downloadNote
      }
    ],
    context: {
      hutk: hubspotUtk || undefined,
      pageUri: window.location.href,
      pageName: document.title
    },
    skipValidation: true
  };
  
  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(data)
    });
  } catch (error) {
    // Silent fail
  }
}
</script>

<script>
// ============================================
// MODAL CONTROLS & DOWNLOAD LOGIC
// ============================================

const COOKIE_NAME = 'hubspot_verified';
const COOKIE_HOURS = 24;

// Modal elements
let modal, form, emailInput, closeButton, modalTitle;
let currentDownload = null;

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  // Get modal elements
  modal = document.getElementById('gated-modal');
  form = document.getElementById('wf-form-gated-form');
  emailInput = document.getElementById('user-email');
  closeButton = document.getElementById('gated-close-modal');
  modalTitle = document.getElementById('gatedModalTitle');
  
  // Check if all elements exist
  if (!modal || !form || !emailInput || !closeButton || !modalTitle) {
    return;
  }
  
  // Setup event listeners
  setupEventListeners();
});

function setupEventListeners() {
  // Close modal when X is clicked
  closeButton.addEventListener('click', function(e) {
    e.preventDefault();
    hideModal();
  });
  
  // Close modal when clicking outside
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      hideModal();
    }
  });
  
  // Handle form submission
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    handleFormSubmit();
  });
  
  // Listen for all download button clicks
  document.addEventListener('click', function(e) {
    const target = e.target.closest('[data-gated-trigger="true"]');
    if (target) {
      e.preventDefault();
      handleDownloadClick(target);
    }
  });
}

function showModal() {
  modal.style.display = 'flex';
  emailInput.value = '';
  emailInput.focus();
}

function hideModal() {
  modal.style.display = 'none';
}

function handleDownloadClick(button) {
  const assetName = button.getAttribute('data-gated-asset');
  const downloadUrl = button.getAttribute('data-gated-url');
  const externalUrl = button.getAttribute('data-gated-external-url');
  const modalTitleText = button.getAttribute('data-gated-modal-title');
  
  // Determine which URL to use (prioritize internal/Webflow file first)
  const finalUrl = downloadUrl && downloadUrl.trim() !== '' ? downloadUrl : externalUrl;
  
  if (!assetName || !finalUrl) {
    return;
  }
  
  // Store current download info
  currentDownload = {
    assetName: assetName,
    downloadUrl: finalUrl
  };
  
  // Update modal title if specified
  if (modalTitleText && modalTitle) {
    modalTitle.textContent = modalTitleText;
  }
  
  // Check for existing cookie
  const userEmail = getCookie(COOKIE_NAME);
  
  if (userEmail) {
    processDownload(userEmail, assetName, finalUrl);
  } else {
    showModal();
  }
}

async function handleFormSubmit() {
  const email = emailInput.value.trim();
  
  // Validate email
  if (!validateEmail(email)) {
    alert('Please enter a valid email address');
    return;
  }
  
  // Disable submit button
  const submitBtn = document.getElementById('submit-gated-form');
  const originalText = submitBtn.textContent;
  submitBtn.disabled = true;
  submitBtn.textContent = 'Processing...';
  
  // Submit to HubSpot Forms API
  const success = await submitToHubSpot(email);
  
  if (success) {
    setCookie(COOKIE_NAME, email, COOKIE_HOURS);
    hideModal();
    
    if (currentDownload) {
      await processDownload(email, currentDownload.assetName, currentDownload.downloadUrl);
    }
  } else {
    alert('Something went wrong. Please try again.');
  }
  
  // Re-enable submit button
  submitBtn.disabled = false;
  submitBtn.textContent = originalText;
}

async function processDownload(email, assetName, downloadUrl) {
  await trackDownload(email, assetName);
  
  const link = document.createElement('a');
  link.href = downloadUrl;
  link.download = '';
  link.target = '_blank';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  
  currentDownload = null;
}
</script>
<script>
(function () {
  'use strict';

  /* ---------- Config ---------- */

  var CONFIG = {
    // Update if the CN subdirectory changes, e.g. /^\/(cn|zh|zh-HK)(\/|$)/
    pathPattern: /^\/(cn)(\/|$)/,
    gated: ['HK', 'MO'],
    gateSelector: '#geoGate',
    openClass: 'is-open',
    lockClass: 'geo-gate-locked',
    storageKey: 'sx_cn_geo_ack',
    ttlDays: 30,            // 0 = per session only
    fallbackUrl: '/',       // used when there is no history to return to
    timeoutMs: 2000,        // per provider
    failOpen: true,         // true = show the site if all lookups fail
    debug: false            // true = verbose console logging
  };

  var PROVIDERS = [
    { url: 'https://api.country.is/',                 pick: function (d) { return d && d.country; } },
    { url: 'https://get.geojs.io/v1/ip/country.json', pick: function (d) { return d && (d.country || d.countryCode); } },
    { url: 'https://free.freeipapi.com/api/json',     pick: function (d) { return d && d.countryCode; } }
  ];

  /* ---------- Helpers ---------- */

  function isStaging() {
    return window.location.hostname.indexOf('webflow.io') > -1;
  }

  function log() {
    if (!CONFIG.debug || !window.console) return;
    var args = Array.prototype.slice.call(arguments);
    args.unshift('[geo-gate]');
    console.log.apply(console, args);
  }

  function isGated(cc) {
    return CONFIG.gated.indexOf(cc) > -1;
  }

  /* ---------- Guard ---------- */

  if (!CONFIG.pathPattern.test(window.location.pathname)) return;
  log('path matched', window.location.pathname);

  function findGate() {
    return document.querySelector(CONFIG.gateSelector) || document.querySelector('.geo-gate');
  }

  /* ---------- Init ---------- */

  function init(gate) {
    var accept = gate.querySelector('[data-geo-gate="accept"]') || gate.querySelector('.geo-gate_btn-accept');
    var decline = gate.querySelector('[data-geo-gate="decline"]') || gate.querySelector('.geo-gate_btn-decline');

    if (!accept || !decline) {
      log('buttons missing. accept:', !!accept, 'decline:', !!decline);
      return;
    }

    if (!gate.id) gate.id = 'geoGate';
    if (gate.style.display) gate.style.display = '';

    var lastFocused = null;

    /* ---------- Storage ---------- */

    function acknowledged() {
      try {
        var raw = JSON.parse(window.localStorage.getItem(CONFIG.storageKey) || 'null');
        if (!raw || !raw.t) return false;
        if (!CONFIG.ttlDays) return true;
        return (Date.now() - raw.t) < CONFIG.ttlDays * 864e5;
      } catch (e) {
        return false;
      }
    }

    function remember() {
      try {
        window.localStorage.setItem(CONFIG.storageKey, JSON.stringify({ t: Date.now(), v: 1 }));
      } catch (e) {
        log('localStorage unavailable, gate will reappear next visit');
      }
    }

    /* ---------- Open / close ---------- */

    function open(country) {
      log('opening, country:', country || 'unknown');
      lastFocused = document.activeElement;
      gate.classList.add(CONFIG.openClass);
      gate.setAttribute('aria-hidden', 'false');
      document.body.classList.add(CONFIG.lockClass);
      accept.focus();
    }

    function close() {
      gate.classList.remove(CONFIG.openClass);
      gate.setAttribute('aria-hidden', 'true');
      document.body.classList.remove(CONFIG.lockClass);
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    /* ---------- Actions ---------- */

    accept.addEventListener('click', function (e) {
      e.preventDefault();
      remember();
      close();
    });

    decline.addEventListener('click', function (e) {
      e.preventDefault();

      var ref = document.referrer || '';
      var cameFromElsewhere = false;

      if (ref) {
        try {
          // Only go back if the previous page was not itself on the CN site
          cameFromElsewhere = !CONFIG.pathPattern.test(new URL(ref).pathname);
        } catch (err) {
          cameFromElsewhere = false;
        }
      }

      log('declined. referrer:', ref || '(none)', 'goingBack:', cameFromElsewhere);

      if (cameFromElsewhere && window.history.length > 1) {
        window.history.back();
        // If history.back() does not move us, fall back shortly after
        window.setTimeout(function () {
          if (CONFIG.pathPattern.test(window.location.pathname)) {
            window.location.replace(CONFIG.fallbackUrl);
          }
        }, 400);
      } else {
        window.location.replace(CONFIG.fallbackUrl);
      }
    });

    // Keep focus inside the dialog while it is open
    gate.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab' || !gate.classList.contains(CONFIG.openClass)) return;
      if (e.shiftKey && document.activeElement === decline) {
        e.preventDefault();
        accept.focus();
      } else if (!e.shiftKey && document.activeElement === accept) {
        e.preventDefault();
        decline.focus();
      }
    });

    /* ---------- Geo lookup with fallback chain ---------- */

    function lookup(index) {
      if (index >= PROVIDERS.length) {
        log('all providers failed. failOpen:', CONFIG.failOpen);
        if (!CONFIG.failOpen) open('unknown');
        return;
      }

      var provider = PROVIDERS[index];
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timer = window.setTimeout(function () {
        if (controller) controller.abort();
      }, CONFIG.timeoutMs);

      var opts = { cache: 'no-store' };
      if (controller) opts.signal = controller.signal;

      window.fetch(provider.url, opts)
        .then(function (res) {
          if (!res.ok) throw new Error('status ' + res.status);
          return res.json();
        })
        .then(function (data) {
          window.clearTimeout(timer);
          var cc = String(provider.pick(data) || '').toUpperCase();
          if (!/^[A-Z]{2}$/.test(cc)) throw new Error('no country code');
          log('resolved', cc, 'gated:', isGated(cc));
          if (isGated(cc)) open(cc);
        })
        .catch(function (err) {
          window.clearTimeout(timer);
          log('provider failed:', provider.url, err && err.message);
          lookup(index + 1);
        });
    }

    // Manual handle, staging only
    if (isStaging()) {
      window.geoGate = { open: open, close: close, lookup: lookup, config: CONFIG };
    }

    /* ---------- Run ---------- */

    if (acknowledged()) {
      log('already acknowledged, staying closed');
      return;
    }

    // QA override on staging only, e.g. straitsx.webflow.io/cn?geo=HK
    if (isStaging()) {
      var forced = null;
      try {
        forced = new URLSearchParams(window.location.search).get('geo');
      } catch (e) {}
      if (forced) {
        var cc = String(forced).toUpperCase();
        log('staging override:', cc);
        if (isGated(cc)) open(cc);
        return;
      }
    }

    if (typeof window.fetch !== 'function') {
      log('fetch unsupported');
      if (!CONFIG.failOpen) open('unsupported');
      return;
    }

    lookup(0);
  }

  /* ---------- Boot, tolerant of markup arriving late ---------- */

  function boot() {
    var gate = findGate();
    if (gate) return init(gate);

    var tries = 0;
    var poll = window.setInterval(function () {
      tries++;
      var found = findGate();
      if (found) {
        window.clearInterval(poll);
        init(found);
      } else if (tries >= 30) {
        window.clearInterval(poll);
        log('gate never appeared after 3s');
      }
    }, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script><script type="text/javascript">
$(document).ready(function () {
  $.ajax({
    url: "https://api.straitsx.com/public/landing-pages/xsgd",
    dataType: "json",
    success: function ({ transferred, market_cap, count_of_transfer, active_address }) {
      $("#transferred").attr("data-target", transferred);
      $("#market-cap").attr("data-target", market_cap);
      $("#total-transfers").attr("data-target", count_of_transfer);
      $("#active-addresses").attr("data-target", active_address);

      runCounters();
    },
    error: function () {
      // If the API fails, use the existing data-targets (fallbacks set in Webflow)
      console.warn("API failed — using fallback data-target values.");
      runCounters(); // still run animation based on existing attributes
    }
  });
});

function runCounters() {
  const { animate } = window.Motion;
  const counters = document.querySelectorAll('[data-motion="counter"]');

  counters.forEach((el) => {
    const end = parseFloat(el.dataset.target) || 0;
    const duration = parseFloat(el.dataset.duration) || 2;

    animate(0, end, {
      duration,
      ease: "circOut",
      onUpdate: (latest) => {
        el.textContent = Math.round(latest).toLocaleString();
      }
    });
  });
}
</script>
<!--- Copy Function -->
<script>
document.querySelectorAll('.stablecoin_copy').forEach(button => {
  button.addEventListener('click', (e) => {
    e.preventDefault();

    // Find the closest wrapper
    const wrapper = button.closest('.stablecoin_address-wrapper');
    const target = wrapper?.querySelector('.stablecoin_contract-address');

    if (target) {
      const text = target.textContent.trim();
      navigator.clipboard.writeText(text).then(() => showToast("Copied!"));
    }
  });
});

// Show toast
function showToast(message) {
  const toast = document.getElementById('copy-toast');
  if (!toast) return;

  toast.textContent = message;
  toast.style.opacity = '1';

  clearTimeout(toast.hideTimeout);
  toast.hideTimeout = setTimeout(() => {
    toast.style.opacity = '0';
  }, 1500);
}
</script>
<!-- Accordion Script 
<script type="module">
  const { animate, press } = window.Motion
  const transition = { duration: 0.3 }

  // Cleanup any initial "is-open" classes
  document.querySelectorAll(".accordion-content.is-open").forEach(el => el.classList.remove("is-open"))

  function toggleAccordion(button, isOpen) {
    const item = button.closest(".accordion-item")
    const content = item.querySelector(".accordion-content")
    const contentInner = content.querySelector("div")
    const verticalBar = button.querySelector(".icon-plusminus-bar.vertical")

    // Close all other accordion items
    document.querySelectorAll(".accordion .accordion-item button").forEach(btn => {
      if (btn !== button) {
        btn.dataset.isOpen = "false"
        btn.setAttribute("aria-expanded", false)
        const otherItem = btn.closest(".accordion-item")
        const otherContent = otherItem.querySelector(".accordion-content")
        const otherInner = otherContent.querySelector("div")
        const otherBar = btn.querySelector(".icon-plusminus-bar.vertical")

        animate(otherContent, { height: 0, maskImage: "linear-gradient(to bottom, black 50%, transparent 100%)" }, transition)
        animate(otherInner, { filter: "blur(2px)", opacity: 0 }, transition)
        if (otherBar) animate(otherBar, { scaleY: 1 }, transition)
      }
    })

    // Open or close the clicked item
    button.dataset.isOpen = isOpen
    button.setAttribute("aria-expanded", isOpen)

    animate(
      content,
      isOpen
        ? { height: "auto", maskImage: "linear-gradient(to bottom, black 100%, transparent 100%)" }
        : { height: 0, maskImage: "linear-gradient(to bottom, black 50%, transparent 100%)" },
      transition
    )

    animate(
      contentInner,
      isOpen
        ? { filter: "blur(0px)", opacity: 1 }
        : { filter: "blur(2px)", opacity: 0 },
      transition
    )

    if (verticalBar) {
      animate(verticalBar, { scaleY: isOpen ? 0 : 1 }, transition)
    }
  }

  // Handle click interaction
  press(".accordion .accordion-item button", (button) => () => {
    const isOpen = button.dataset.isOpen !== "true"
    toggleAccordion(button, isOpen)
  })

  // Auto open a default item if marked
  window.addEventListener("DOMContentLoaded", () => {
    const defaultBtn = document.querySelector('.accordion .accordion-item button[data-default-open="true"]')
    if (defaultBtn) toggleAccordion(defaultBtn, true)
  })
</script>--><script src="https://hubspotv2.use1-marketplace-1p-apps-prod-red.if.webflow.services/static/loader.js" type="text/javascript" async="" defer=""></script></body></html>