{
  "schema": "openapi/3.0.0",
  "info": {
    "title": "Council of AI (CSOAI)",
    "version": "1.1.0",
    "description": "AI measurement and evidence surfaces. Live counts come from /api/state and /api/gspc; no frozen axis count is authoritative here.",
    "contact": {
      "name": "Nicholas Templeman",
      "url": "https://councilof.ai/"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://councilof.ai/api",
      "description": "Council OS API"
    }
  ],
  "paths": {
    "/x402": {
      "get": {
        "summary": "The x402 paid attestation catalog",
        "operationId": "getX402Catalog",
        "responses": {
          "200": {
            "description": "x402 catalog"
          }
        }
      }
    },
    "/gspc": {
      "get": {
        "summary": "The live GSPC board — read the current count from the response",
        "operationId": "getGspcBoard",
        "responses": {
          "200": {
            "description": "GSPC board"
          }
        }
      }
    },
    "/state": {
      "get": {
        "summary": "The one live state surface — quote values by field name",
        "operationId": "getState",
        "responses": {
          "200": {
            "description": "State"
          }
        }
      }
    },
    "/learn-loop": {
      "post": {
        "summary": "Emit a 3KB signed card from an end-user interaction",
        "operationId": "postLearnLoop",
        "responses": {
          "200": {
            "description": "Card emitted"
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Verify any signed card",
        "operationId": "postVerify",
        "responses": {
          "200": {
            "description": "Verification"
          }
        }
      }
    },
    "/report": {
      "post": {
        "summary": "File a correction report",
        "operationId": "postReport",
        "responses": {
          "200": {
            "description": "Report"
          }
        }
      }
    },
    "/claims/register": {
      "get": {
        "summary": "Claim Maintenance register — evidence states, never a score",
        "operationId": "getClaimMaintenanceRegister",
        "responses": {
          "200": {
            "description": "Claim Maintenance register"
          }
        }
      }
    },
    "/corrections": {
      "get": {
        "summary": "Public corrections ledger — append history of CSOAI defects and fixes",
        "operationId": "getCorrections",
        "responses": {
          "200": {
            "description": "Corrections ledger"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "x402",
      "description": "x402 paid attestation"
    },
    {
      "name": "gspc",
      "description": "Live GSPC measurement; read counts from the response"
    },
    {
      "name": "anchor",
      "description": "OTS / Rekor / EAS anchoring"
    },
    {
      "name": "verify",
      "description": "Card verification"
    }
  ],
  "x-canonical-openapi": "https://councilof.ai/api/openapi.json",
  "x-compatibility-note": "Legacy compatibility manifest. Prefer /api/openapi.json for current public read surfaces. This file must not freeze board counts or invent routes."
}
