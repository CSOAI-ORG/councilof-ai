{
  "$defs": {
    "AuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "authority_epoch": {
          "title": "Authority Epoch",
          "type": "string"
        },
        "delegation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "limits_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limits Digest"
        },
        "policy_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Uri"
        },
        "principal": {
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "authority_epoch"
      ],
      "title": "AuthorityBinding",
      "type": "object"
    },
    "DependencyState": {
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "title": "Dependency Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "required_for_resume": {
          "default": true,
          "title": "Required For Resume",
          "type": "boolean"
        }
      },
      "required": [
        "dependency_id",
        "digest",
        "kind"
      ],
      "title": "DependencyState",
      "type": "object"
    },
    "DigestRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
