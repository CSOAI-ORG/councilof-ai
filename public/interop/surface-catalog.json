{
  "schema": "csoai.surface-catalog/1",
  "as_of": "2026-08-26",
  "purpose": "Every live public surface, machine-readable — the single catalog of all sites, endpoints, datasets and rails. Strangers and lanes quote from here; GET /api/gspc and GET /api/state hold the counts. Counts are a pointer, never a typed integer.",
  "doctrine": "measurement not certification; never certify/accredit/enforce/endorse/tokenize.",
  "sites": {
    "web": ["https://councilof.ai", "https://csoai.org", "https://www.csoai.org"],
    "hf_org": "https://huggingface.co/csoai",
    "gh_org": "https://github.com/CSOAI-ORG",
    "council_os_spine": "https://github.com/CSOAI-ORG/council-os",
    "ci_action": "https://github.com/CSOAI-ORG/action-verify-attestation"
  },
  "api": [
    "/api/gspc (living board; quote totals.public_count from the endpoint)", "/api/state (derived counts — the only quotable numbers)",
    "/api/cards", "/api/axis-register", "/api/detect (Art 50 C2PA verifier)",
    "/api/checkout (configured:false, public_prices:false)", "/api/fulfill", "/api/interop-bulk",
    "/api/methodology (signed)"],
  "interop": [
    "/interop/attestation-corpus.json",
    "/interop/financial-measure-run-v2.json", "/interop/evm-control-facts.json",
    "/interop/ai-economy-index.v0.1.json", "/interop/human-labour-index.v0.1.json",
    "/interop/mcp-security-scorecard.json", "/interop/rwa-attest-index.json",
    "/interop/eas-attestation-batch.json", "/interop/jail-peritem-v3.json",
    "/interop/jailbreak-asr-evidence-pack.json",
    "/interop/coverage-register.json", "/interop/sboum-councilof-ai.json",
    "/interop/surface-catalog.json (this file)", "/interop/xrpl-attest-run.json",
    "/interop/card-store-verification.json"],
  "signed": ["/signed/board_living.json", "/signed/gspc-measurement.json",
             "/signed/card_index.json (n_cards is the file's own field; do not type it here)"],
  "signals": ["/signals/*.signed.json (axis count from GET /api/gspc, not from this catalog)"],
  "docs": ["/docs/MASTER_PLAN_2026-08-26.md", "/docs/INSURER_PILOT_PITCH_2026-08-26.md",
           "/docs/NIST_CAISI_INPUT_2026-08-26.md"],
  "datasets": ["csoai/rwa-attest", "csoai/gspc-jail-goldbank",
               "csoai/gspc-board", "csoai/gspc-boards", "csoai/gspc-signed-boards",
               "csoai/mcp-scoreboard", "csoai/gspc-*"],
  "rails": ["EAS off-chain (payloads ready)", "XRPL (devnet proof; mainnet facts measured)",
            "OpenTimestamps (planned)", "x402/HTTP 402 (meta rail live)"],
  "public_artifacts": {
    "paper": "docs/operations/paper/FAIR_TIES_DRAFT_2026-08-26.md",
    "verifier": "scripts/verify_signed.py + action-verify-attestation",
    "scorecard_engine": "harness/mcp/security-scorecard",
    "rwa_engine": "harness/rwa-attest"
  },
  "honesty": "Catalog is a pointer. If a count here disagrees with GET /api/gspc or card_index.json, the endpoint and the signed file win. Unverified rails stay planned."
}
