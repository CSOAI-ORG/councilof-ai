  "controls": [
    {
      "id": "CH-01",
      "name": "Trusted identity binding",
      "articles": [
        7,
        21,
        22,
        28
      ],
      "rule": "subject_id, tenant_id and harness_id must be supplied by a trusted host context and remain identical through authorization and execution."
    },
    {
      "id": "CH-02",
      "name": "No self-authorization",
      "articles": [
        1,
        4,
        5
      ],
      "rule": "a requester, model, tool, payment, training result or measurement may not create or expand its own authority."
    },
    {
      "id": "CH-03",
      "name": "Bounded authority",
      "articles": [
        11,
        12,
        18,
        48,
        49,
        50,
        51
      ],
      "rule": "authority must be capability-, resource-, budget-, epoch- and time-bounded; expansion requires an independently supplied maximum and review."
    },
    {
      "id": "CH-04",
      "name": "Pre-effect commitment",
      "articles": [
        2,
        24,
        25,
        27
      ],
      "rule": "effectful execution requires an exact action/resource/argument-or-body commitment, current authority and pre-effect policy decision."
    },
    {
      "id": "CH-05",
      "name": "Revocation and resume",
      "articles": [
        18,
        48,
        49,
        50,
        51
      ],
      "rule": "revocation, expiry, policy/dependency change and resume must be rechecked at the effect boundary; uncertain effects must not be blindly replayed."
    },
    {
      "id": "CH-06",
      "name": "Measurement independence",
      "articles": [
        2,
        24,
        25,
        27
      ],
      "rule": "execution evidence is not a GSPC measurement; measurement requires an independently bound instrument/checker/result and separate admission."
    },
    {
      "id": "CH-07",
      "name": "Signature and publication separation",
      "articles": [
        13,
        17,
        25
      ],
      "rule": "eligibility to request signing, transparency registration or publication is not signing, registration, publication, certification or correctness."
    },
    {
      "id": "CH-08",
      "name": "Payment separation",
      "articles": [
        33,
        41
      ],
      "rule": "payment authorization and settlement never imply measurement quality, authority, delivery acceptance, certification or a favourable result."
    },
    {
      "id": "CH-09",
      "name": "Privacy and rights gate",
      "articles": [
        21,
        23,
        29,
        30,
        35,
        40,
        43
      ],
      "rule": "private, personal, customer or controlled material requires explicit permitted purpose/rights before processing, learning, reuse or publication; unknown rights hold for review."
    },
    {
      "id": "CH-10",
      "name": "Security and secret minimization",
      "articles": [
        22,
        25,
        28
      ],
      "rule": "raw credentials and unnecessary secrets must not enter general agent context, public receipts or evidence projections; endpoint-bound handles are preferred."
    },
    {
      "id": "CH-11",
      "name": "Appeal and understandable reasons",
      "articles": [
        18,
        26,
        41
      ],
      "rule": "denials/holds exposed to a person must provide a bounded reason, evidence pointer when available and an appropriate review route; accessibility does not change authority."
    },
    {
      "id": "CH-12",
      "name": "Learning is not authority",
      "articles": [
        29,
        35,
        40
      ],
      "rule": "course completion, simulation, gameplay, benchmark participation or inferred demographic membership never grants execution, legal or compliance authority."
    },
    {
      "id": "CH-13",
      "name": "No regulatory determination",
      "articles": [
        19,
        42,
        47,
        48
      ],
      "rule": "CSOAI may measure and publish scoped evidence but this harness must deny requests to make regulatory determinations, certify compliance or override competent legal authority."
    },
