# Cloudflare Pages _headers
# Fingerprinted build chunks: cache forever, immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shell: always revalidate (no blanket s-maxage — legacy-shadow incident).
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate
