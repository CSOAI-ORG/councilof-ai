  "entries": [
    {
      "identifier": "urn:air:councilof.ai:mcp:gspc",
      "type": "application/mcp-server-card+json",
      "url": "https://councilof.ai/.well-known/mcp/server.json",
      "tags": ["mcp", "measurement", "verification"],
      "extensions": {
        "ai.councilof.catalog-note": {
          "card_format": "MCP Registry server.json (schema 2025-12-11). The MCP Server Card (SEP-2127, draft) for the same server is served at https://councilof.ai/mcp/server-card; this document is the registry-shaped card.",
          "remote": "https://councilof.ai/mcp",
          "free_tools_only": "https://councilof.ai/mcp/free",
          "extended_card": "https://councilof.ai/.well-known/mcp/server-card.json"
        }
      }
    },
    {
      "identifier": "urn:air:councilof.ai:mcp:gspc:server-card",
      "displayName": "GSPC MCP Server Card (full door)",
      "type": "application/mcp-server-card+json",
      "url": "https://councilof.ai/mcp/server-card",
      "description": "MCP Server Card at the location SEP-2127 reserves (<streamable-http-url>/server-card) for https://councilof.ai/mcp: identity, remote endpoint and protocol revisions. SEP-2127 is a draft in no released MCP spec version; the card says so.",
      "tags": ["mcp", "server-card", "sep-2127-draft"],
      "extensions": {
        "ai.councilof.catalog-note": {
          "spec_status": "draft SEP-2127, unreleased",
          "remote": "https://councilof.ai/mcp"
        }
      }
    },
    {
      "identifier": "urn:air:councilof.ai:mcp:gspc-free:server-card",
      "displayName": "GSPC MCP Server Card (free door)",
      "type": "application/mcp-server-card+json",
      "url": "https://councilof.ai/mcp/free/server-card",
      "description": "MCP Server Card for https://councilof.ai/mcp/free, the read-only door with no sign-in. SEP-2127 is a draft in no released MCP spec version; the card says so.",
      "tags": ["mcp", "server-card", "sep-2127-draft", "read-only"],
      "extensions": {
        "ai.councilof.catalog-note": {
          "spec_status": "draft SEP-2127, unreleased",
          "remote": "https://councilof.ai/mcp/free"
        }
      }
    },
    {
      "identifier": "urn:air:councilof.ai:a2a:measurement-agent",
      "type": "application/a2a-agent-card+json",
      "url": "https://councilof.ai/.well-known/agent-card.json",
      "tags": ["a2a", "measurement"],
      "extensions": {
        "ai.councilof.catalog-note": {
          "endpoint": "https://councilof.ai/api/a2a",
          "binding": "JSONRPC"
        }
      }
    },
    {
      "identifier": "urn:air:councilof.ai:ag-ui:run",
      "displayName": "AG-UI run endpoint (descriptor)",
      "type": "application/json",
      "url": "https://councilof.ai/api/agui",
      "description": "Descriptor for the AG-UI endpoint: POST https://councilof.ai/api/agui/run streams AG-UI events. Deterministic routing onto the MCP tools; no model in the path.",
      "tags": ["ag-ui", "chat", "streaming"]
    },
    {
      "identifier": "urn:air:councilof.ai:a2ui:run",
      "displayName": "A2UI renderer surface",
      "type": "application/json",
      "url": "https://councilof.ai/api/a2ui",
      "description": "Descriptor for the A2UI surfaces. GET /api/a2ui/board (the board card) and GET or POST /api/a2ui/verify (a verify result) emit A2UI v0.9.1, the current A2UI release; ?version=v1.0 gives the v1.0 Candidate form. POST /api/a2ui/run returns grounded Council OS answers as A2UI v1.0 Candidate NDJSON; GET /api/a2ui/gspc projects the living GSPC state.",
      "tags": ["a2ui", "agent-ui", "streaming"],
      "extensions": {
        "ai.councilof.catalog-note": {
          "protocol_status": "A2UI v0.9.1 (current) for /board and /verify; v1.0 Candidate for /run and /gspc",
          "run": "https://councilof.ai/api/a2ui/run",
          "living_gspc": "https://councilof.ai/api/a2ui/gspc",
          "source": "https://councilof.ai/api/gspc"
        }
      }
    },
    {
      "identifier": "urn:air:councilof.ai:chat:talk",
      "displayName": "Chat endpoint",
      "type": "application/json",
      "data": {
        "endpoint": "https://councilof.ai/api/chat",
        "method": "POST",
        "input": {"message": "<plain text>"},
        "output": "JSON with an answer quoted from a named MCP tool's output",
        "note": "POST only; a GET returns 404."
      },
      "tags": ["chat"]
    },
    {
      "identifier": "urn:air:councilof.ai:dataset:gspc-board",
      "displayName": "GSPC board (live JSON)",
      "type": "application/json",
      "url": "https://councilof.ai/api/gspc",
      "description": "The live measurement board. Quote its own totals; an unmeasured slot is published as unmeasured.",
      "tags": ["dataset", "measurement"]
    },
    {
      "identifier": "urn:air:councilof.ai:dataset:huggingface-listing",
      "displayName": "Public datasets on the Hugging Face Hub (author csoai)",
      "type": "application/json",
      "url": "https://huggingface.co/api/datasets?author=csoai&limit=1000",
      "description": "The Hub's own listing of every public dataset under the csoai account; read it rather than a count typed here.",
      "tags": ["dataset", "huggingface"]
    },
    {
      "identifier": "urn:air:councilof.ai:catalog:api",
      "displayName": "API catalog (RFC 9727 linkset)",
      "type": "application/linkset+json",
      "url": "https://councilof.ai/.well-known/api-catalog",
      "tags": ["api-catalog"]
    }
  ],
  "extensions": {
    "ai.councilof.catalog-note": {
      "spec": "https://ai-catalog.io/ (Agent-Card/ai-catalog, specification/ai-catalog.md at 04a99cd, 2026-09-05)",
      "conformance": "Level 2 (Discoverable). No trustManifest is claimed.",
      "doctrine": "Measurement, not certification. A listing is never adoption."
    }
  }
