{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://councilof.ai/schemas/csoai-certificate-0.1.schema.json",
  "title": "CSOAI Paid-Entitlement Certificate",
  "description": "A wrapper doc {payload, certificate_id, sig_ed25519} issued to a paying customer on successful settlement. The signer hashes the canonical payload (sorted keys, compact separators, ensure_ascii=False) to produce certificate_id, and signs the same canonical payload bytes with Ed25519 under did:web:csoai.org#board-attestation-1. It is a measurement credential — never a certification, accreditation, or conformity assessment. A revocation record (csoai.refund-record/0.1) supersedes the certificate without erasing history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "certificate_id",
    "issued_at",
    "issuer_did",
    "payload",
    "sig_ed25519",
    "limits"
  ],
  "properties": {
    "schema": { "const": "csoai.certificate/0.1" },
    "certificate_id": {
      "type": "string",
      "description": "Stable identifier: sha256 of canonical payload bytes (sorted keys, compact separators, ensure_ascii=False).",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_did": {
      "type": "string",
      "pattern": "^did:web:.+#"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "entitlement", "scope", "verification"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["account", "license"] },
            "id": { "type": "string", "minLength": 1 },
            "email_hash": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "entitlement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "tier", "issued_via"],
          "properties": {
            "sku": { "type": "string", "minLength": 1 },
            "tier": { "enum": ["free", "proof", "feed"] },
            "issued_via": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel"],
              "properties": {
                "channel": { "enum": ["paddle_settlement", "operator_manual", "self_test"] },
                "settlement_reference": { "type": ["string", "null"] }
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_set"],
          "properties": {
            "tool_set": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "free_calls_per_day": { "type": ["integer", "null"] },
            "expires_at": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "did_document": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "sig_ed25519": {
      "type": "string",
      "description": "Ed25519 signature over the canonical payload bytes, hex-encoded.",
      "pattern": "^[0-9a-f]{128}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_certification", "non_promotion", "writes_board"],
      "properties": {
        "non_certification": { "const": true, "description": "Always true; cert is a measurement credential, never a certification." },
        "non_promotion": { "const": true, "description": "Always true; cert is not an endorsement." },
        "writes_board": { "const": false, "description": "Always false; issuance does not modify the public board." }
      }
    }
  }
}
