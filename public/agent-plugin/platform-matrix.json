    {
      "id": "hermes",
      "label": "Hermes",
      "family": "mcp-only",
      "state": "present",
      "mcp": {
        "format": "yaml",
        "file": "~/.hermes/config.yaml",
        "key": "mcp_servers",
        "merge": true
      },
      "install": {
        "type": "none"
      },
      "note": "Hermes already runs mcp_servers.busabase. The two Council servers sit beside it in the same map."
    },
    {
      "id": "windsurf",
