        "type": "agent-file",
        "to": "~/.qwen/QWEN.md"
      }
    },
    {
      "id": "openclaw",
      "label": "OpenClaw",
      "family": "agent-file",
      "state": "present",
      "mcp": {
        "format": "json",
        "file": "~/.openclaw/mcp.json",
        "key": "mcpServers",
        "merge": true
