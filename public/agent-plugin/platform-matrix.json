  "surface": {
    "public_matrix_url": "https://councilof.ai/api/plugin/platforms",
    "public_install_url": "https://councilof.ai/api/plugin",
    "board_url": "https://councilof.ai/api/gspc",
    "verify_url": "https://councilof.ai/verify",
    "mcp_url": "https://councilof.ai/mcp"
  },
  "doctrine": [
    "The board and verification stay free, forever, for everyone.",
    "We measure; we never certify. No public prices on any surface.",
    "A plugin that cannot be measured is an unmeasured plugin, not a working one.",
    "Absence is an answer: a platform with no install target is CATALOGUED, not LIVE."
  ]
