  "resource": {
    "google_cloud_run_service": {
      "google_cloud_run_service_demeter_conscience": {
        "name": "sov-hive-demeter-conscience",
        "location": "us-central1",
        "template": {
          "spec": {
            "containers": [
              {
                "image": "us-docker.pkg.dev/csoai-sovereign-foundation/sov-hives/demeter-conscience:latest",
                "resources": {
                  "limits": {
                    "memory": 256,
                    "cpu": 1
                  }
                },
                "env": [
                  {
                    "name": "HIVE_NAME",
                    "value": "demeter-conscience"
                  },
                  {
                    "name": "HIVE_DESC",
                    "value": "Care Floor firewall"
                  },
                  {
                    "name": "CARE_FLOOR",
                    "value": "0.95"
                  },
                  {
                    "name": "BFT_MAJORITY",
                    "value": "8"
                  },
                  {
                    "name": "SIGIL_ALGO",
                    "value": "ed25519+pqc-ml-dsa-65"
                  },
                  {
                    "name": "LICENSE",
                    "value": "MIT+CC0"
                  }
                ]
              }
            ]
          }
        }
      },
