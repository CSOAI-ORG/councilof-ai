    "hive_metadata": {
      "demeter-conscience": [
        "tiny",
        256,
        1,
        3,
        50,
        "us-central1",
        "Care Floor firewall"
      ],
      "olm-autonomy": [
        "large",
        "8G",
        4,
        1,
        8,
        "europe-west4",
        "Humanoid RL"
