{
  "name": "csoai-platform",
  "version": "1.0.0",
  "description": "CSOAI - Council of Safety of AI Platform. The world's first AI safety infrastructure.",
  "type": "module",
  "license": "MIT",
  "author": "CSOAI Team",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/resolve-app-tsx.mjs && node scripts/build-card-matrix.mjs && node scripts/build-root-history.mjs && node scripts/generate-cards-bundle.mjs && node scripts/build-findings-index.mjs && node scripts/pages-size-guard.mjs public && node scripts/refutation-count-lint.mjs && node scripts/counter-lint.mjs && node scripts/mcp-probe.mjs --check && node scripts/generate-sitemap.mjs && node scripts/generate-redirects.mjs && node scripts/redirects-guard.mjs public/_redirects && node scripts/generate-signed-index.mjs && node scripts/generate-route-manifest.mjs && vite build --config client/vite.config.ts && node scripts/strip-datasectors-preload.mjs && node -e \"require('fs').cpSync('functions','dist/client/functions',{recursive:true})\"",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "lint:counters": "node scripts/counter-lint.mjs",
    "mcp:probe": "node scripts/mcp-probe.mjs",
    "mcp:check": "node scripts/mcp-probe.mjs --check",
    "mcp:selftest": "node scripts/mcp-probe.mjs --selftest && python3 scripts/mcp-stdio-probe.py --selftest",
    "mcp:probe:stdio": "python3 scripts/mcp-stdio-probe.py",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:planned-ready": "node --test council-os/planned-ready.lock.test.mjs council-os/embed-escape.node-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:shell": "playwright test --config e2e/playwright.shell.config.ts",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:pre-deploy": "npx vite preview --config client/vite.config.ts --port 4173 --strictPort & PREVIEW_PID=$!; sleep 3; BASE_URL=http://localhost:4173 npx playwright test --config e2e/playwright.config.ts e2e/tests/pre-deploy-smoke.spec.ts --project=chromium --reporter=line; RC=$?; kill $PREVIEW_PID 2>/dev/null; wait $PREVIEW_PID 2>/dev/null; exit $RC",
    "deploy:prod": "npm run build:client && npm run prerender && bash scripts/deploy-prod.sh",
    "deploy:prod:dry": "bash scripts/deploy-prod.sh --dry",
    "deploy:prod:skip-test": "npm run build:client && bash scripts/deploy-prod.sh --skip-test",
    "deploy:prod:rollback": "bash scripts/deploy-prod.sh --rollback",
    "deploy:staging": "npm run build:client && bash scripts/deploy-staging.sh",
    "deploy:staging:dry": "bash scripts/deploy-staging.sh --dry",
    "deploy:staging:skip-test": "npm run build:client && bash scripts/deploy-staging.sh --skip-test",
    "deploy:staging:rollback": "bash scripts/deploy-staging.sh --rollback",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "hive:recon": "node scripts/hive-recon.mjs",
    "sov:personas": "node scripts/persona-e2e.mjs",
    "prerender": "node scripts/prerender.mjs",
    "prerender:lane": "bash scripts/prerender-run.sh",
    "sov:stack": "node scripts/sov-stack-e2e.mjs",
    "ts-ratchet": "node scripts/ts-ratchet.mjs",
    "smoke:evidence": "node scripts/smoke-evidence.mjs",
    "lint:refutations": "node scripts/refutation-count-lint.mjs",
    "deploy": "bash scripts/deploy-verified.sh",
    "redirects": "node scripts/generate-redirects.mjs",
    "guard:redirects": "node scripts/redirects-guard.mjs --selftest && node scripts/redirects-guard.mjs public/_redirects",
    "deploy:site": "bash scripts/deploy-site.sh",
    "deploy:site:preflight": "bash scripts/deploy-site.sh --preflight",
    "signed:index": "node scripts/generate-signed-index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
