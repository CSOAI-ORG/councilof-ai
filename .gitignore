# unsigned board snapshot — intermediate for the custody re-sign, never published
.gspc-work/

# A build artifact regenerated every run. Tracking it let a stale report survive a
# crashed build and claim 582 routes rendered when 5 files existed. Evidence of a build
# belongs to that build, not to git history.
prerender-report.json

# Local wrangler scratch — build artefacts, never product.
.wrangler/

# Hub census listings — 1.59GB. SUMMARY only. Never upload.
listings.jsonl
**/listings.jsonl
scripts/census/**/listings.jsonl

# Private trade-secret catalogue — the crown-jewel inventory + redacted infra
# coordinates. NEVER commit (this repo is public). Its public counterpart is
# docs/what-we-publish-and-what-we-dont.md.
TRADE-SECRETS.md

# Generated SKU-2 evidence packs (scripts/evidence-pack-generate.mjs) — reproducible
# outputs assembled from already-signed cards; regenerate rather than commit.
evidence-packs/
