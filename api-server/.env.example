# CSOAI API — copy to .env on the VM and fill in. NEVER commit the real .env.
PORT=8080
APP_ORIGIN=https://councilof.ai
ALLOWED_ORIGINS=https://councilof.ai,https://www.councilof.ai,https://csoai.org,https://csoai-v2-app.vercel.app
# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.csoai.org/api/oauth/github/callback
# Webhook HMAC signing secret (generate: openssl rand -hex 32)
WEBHOOK_SIGNING_SECRET=
# Sovereign Town signed feed
SOV_EXPORT_BASE=https://proofof-site.vercel.app/sovereign-town
