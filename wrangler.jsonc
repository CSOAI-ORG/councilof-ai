{
  // Cloudflare Pages config for THIS repo's deploy target: the councilof-ai project
  // (live at councilof.ai). wrangler prefers wrangler.jsonc over wrangler.toml, so this
  // file is the single source of truth — do not add a wrangler.toml alongside.
  // (A stale "csoai" name here broke deploys the moment the CLI --project-name flag
  // was removed; keep name/output/date in sync with the live project.)
  //
  // Bindings are config-managed (dashboard binding edits are disabled) — they MUST live here.
  //
  // functions/ is auto-discovered — each functions/api/<name>.ts becomes /api/<name>.
  // SPA fallback for client routes is the `/* /index.html 200` catch-all in public/_redirects.
  "name": "councilof-ai",
  "compatibility_date": "2026-07-29",
  "pages_build_output_dir": "./dist/client",

  // SOV_ARENA_STATE feeds /api/sov-arena/rounds.jsonl — live arena evidence from
  // sov_arena.py (oracle-micro), synced to KV by the Mac-side cron. Same namespace
  // the csoai-site project binds (created 2026-08-09, EAT lane).
  "kv_namespaces": [
    {
      "binding": "SOV_ARENA_STATE",
      "id": "00634697bf5744edba3625905a922e96"
    },
    // REVENUE_KV — the replay/tally store behind /api/revenue (functions/api/revenue.ts).
    // Namespace `revenue` created 2026-09-03 on account 52092e4d…f2528. Without this binding the
    // revenue counts stay null (never 0) — null is the honest value for "not counted", and
    // /api/revenue says so itself. Binding it does NOT invent revenue: the number stays null
    // until a facilitator receipt actually settles.
    {
      "binding": "REVENUE_KV",
      "id": "91e1b7a78f2a4edbbe5f67459b2a79db"
    },
    // WITNESS_KV — the /api/witness queue (functions/api/witness.ts). Namespace `witness` created
    // 2026-09-03. The endpoint answered 503 {"status":"NOT_YET"} until now. STILL OUTSTANDING:
    // set the GitHub Actions variable WITNESS_KV_NAMESPACE_ID to this same id so
    // scripts/adapters/witness_queue.py can read the queue at publish time.
    {
      "binding": "WITNESS_KV",
      "id": "8244f80354c24a9ebadd227a8192a045"
    }
  ]
}
