{
  // Cloudflare Pages config for THIS repo's deploy target: the councilof-ai project
  // (live at councilof.ai). NOTE: wrangler prefers wrangler.jsonc over wrangler.toml,
  // so this file is the single source of truth — do not add a wrangler.toml alongside
  // (a stale "csoai" name in this file once broke deploys the moment the CLI
  // --project-name flag was removed; keep name/output/date in sync with the project).
  //
  // The dashboard marks this project's bindings as config-managed, so bindings MUST
  // live here — dashboard binding edits are disabled.
  //
  // functions/ is auto-discovered by Cloudflare Pages — each functions/api/<name>.ts
  // exporting onRequestGet/onRequestPost becomes /api/<name>. SPA fallback for client
  // routes is the `/* /index.html 200` catch-all in public/_redirects (static +
  // prerendered files and Functions take precedence).
  "name": "councilof-ai",
  "compatibility_date": "2026-07-29",
  "pages_build_output_dir": "./dist/client",

  // SOV_ARENA_STATE feeds /api/sov-arena/rounds.jsonl — live arena evidence from
  // sov_arena.py (oracle-micro), synced to KV by the Mac-side cron. Same namespace
  // the csoai-site project binds (created 2026-08-09, EAT lane).
  "kv_namespaces": [
    {
      "binding": "SOV_ARENA_STATE",
      "id": "00634697bf5744edba3625905a922e96"
    }
  ]
}
