{
  // The live CSOAI site on Cloudflare. FIXED 2026-08-04: the previous config was "static assets
  // only — no Worker script", so EVERY /api/* route fell through to the SPA and returned HTML
  // instead of JSON (the P0 the independent briefing flagged, confirmed live: /api/tools?q=governance
  // and /api/og both returned 200 text/html). Cloudflare Pages Functions in functions/api/*.ts are
  // now the deploy target, so /api/tools, /api/mcp, /api/assess, /api/og etc. execute server-side.
  //
  // not_found_handling stays single-page-application for CLIENT routes (wouter does client-side
  // routing; /provenance-finding must boot the app on cold load). But because functions/ now
  // exists, Cloudflare matches /api/* to a Function FIRST and only falls back to the SPA for
  // non-function paths — which is exactly the behaviour the Claims-E2E test asserts.
  "name": "csoai",
  "compatibility_date": "2026-07-29",
  "pages_build_output_dir": "./dist/client"
  // SPA fallback for CLIENT routes is handled by the `/* /index.html 200` catch-all in
  // public/_redirects (static + prerendered files take precedence, so /api/* hits Functions
  // and prerendered routes serve their own HTML; only truly-unknown paths boot the SPA).
  // The earlier `assets{ not_found_handling }` block was Workers-Static-Assets syntax and
  // `wrangler pages deploy` rejects it ("Pages projects does not support 'assets'") — which is
  // why no deploy had shipped since the migration and the prerender never reached production.
  //
  // functions/ is auto-discovered by Cloudflare Pages — no extra config needed. Each
  // functions/api/<name>.ts exporting onRequestGet/onRequestPost becomes /api/<name>.
}
