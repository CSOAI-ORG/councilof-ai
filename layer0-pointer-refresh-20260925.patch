+def write_witness_pointer(
+    pointer_path: Path, side: dict, latest: Path, dated: Path, repo_root: Path, drift: dict
+) -> dict:
+    """Write only fields derived from this witness; old pointer prose can be obsolete."""
+    ots = side["witnesses"]["ots"]
+    ptr = {
+        "kind": "csoai.root-witness-pointer/v0",
+        "as_of": now(),
+        "note": "Timestamped pointer for the witnessed root. Drift is an observation at checked_at, not a standing all-clear. Existence/time of bytes — not certification, not endorsement, not a rank sale. Never mint a token.",
+        "live_root": side["artifact"],
+        "witness_sidecar": {
+            "url": "https://councilof.ai/interop/root-witness-latest.json",
+            "path": str(latest.relative_to(repo_root)),
+            "status": "PUBLISHED",
+            "dated_copy": str(dated.relative_to(repo_root)),
+        },
+        "drift": drift,
+        "conflict": side["conflict"],
+        "corpus_scope": side["corpus_scope"],
+        # A pending proof has no Bitcoin header, so its own observation time
+        # remains authoritative until the proof is upgraded.
+        "witness_status_observed_at": ots.get("observed_at") or (ots.get("bitcoin_header") or {}).get("verified_at") or side["as_of"],
+        "witnesses": {
+            "rekor": side["witnesses"]["rekor"].get("status"),
+            "ots": ots.get("status"),
+            "eas_base": side["witnesses"]["eas_base"].get("status", "UNCHECKABLE"),
+            "xrpl_memo": "NOT_YET",
+        },
+    }
+    pointer_path.write_text(json.dumps(ptr, indent=1, ensure_ascii=False) + "\n")
+    return ptr
+
+
 def main() -> int:
     parser = argparse.ArgumentParser()
     parser.add_argument("--selftest", action="store_true")
