@@ -0,0 +1,49 @@
+"""Regression coverage for refreshing a public-root witness pointer."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from scripts.witness_public_root import write_witness_pointer
+
+
+class WitnessPointerTest(unittest.TestCase):
+    def test_new_witness_drops_instructions_from_prior_root(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repo = Path(directory)
+            interop = repo / "public" / "interop"
+            interop.mkdir(parents=True)
+            pointer = interop / "root-witness-pointer.json"
+            pointer.write_text(json.dumps({
+                "kind": "csoai.root-witness-pointer/v0",
+                "hard_stops": ["Do not claim the published OTS/Rekor verify current live root bytes."],
+                "old_root_only": True,
+            }))
+            latest = interop / "root-witness-latest.json"
+            dated = interop / "root-witness-2026-09-23-ae8bbfce.json"
+            side = {
+                "as_of": "2026-09-23T05:23:04Z",
+                "artifact": {"sha256": "ae" * 32, "merkle_root": "40" * 32},
+                "conflict": {"status": "NONE"},
+                "corpus_scope": {"ots_covers": "PUBLIC_ROOT_BYTES_ONLY"},
+                "witnesses": {
+                    "rekor": {"status": "WITNESSED"},
+                    "ots": {"status": "CONFIRMED_BITCOIN", "observed_at": "2026-09-23T05:23:04Z"},
+                    "eas_base": {"status": "NOT_YET"},
+                },
+            }
+            drift = {"status": "MATCH", "checked_at": "2026-09-23T05:26:34Z"}
+
+            written = write_witness_pointer(pointer, side, latest, dated, repo, drift)
+            saved = json.loads(pointer.read_text())
+            self.assertEqual(saved, written)
+            self.assertNotIn("hard_stops", saved)
+            self.assertNotIn("old_root_only", saved)
+            self.assertEqual(saved["live_root"], side["artifact"])
+            self.assertEqual(saved["drift"], drift)
+            self.assertEqual(saved["witnesses"]["ots"], "CONFIRMED_BITCOIN")
+            self.assertEqual(saved["witness_sidecar"]["path"], "public/interop/root-witness-latest.json")
+
+
+if __name__ == "__main__":
+    unittest.main()
