@id("p001")
@source("platform:always-blocked-addresses")
forbid (principal, action == OpenShell::Action::"connect", resource)
when { resource has ip && (resource.ip.isLoopback() || resource.ip.isInRange(ip("169.254.0.0/16")) || resource.ip.isInRange(ip("fe80::/10")) || resource.ip.isInRange(ip("0.0.0.0/32")) || resource.ip.isInRange(ip("::/128"))) };

@id("p002")
@source("platform:always-blocked-addresses")
forbid (principal, action == OpenShell::Action::"http_request", resource)
when { resource has ip && (resource.ip.isLoopback() || resource.ip.isInRange(ip("169.254.0.0/16")) || resource.ip.isInRange(ip("fe80::/10")) || resource.ip.isInRange(ip("0.0.0.0/32")) || resource.ip.isInRange(ip("::/128"))) };

@id("p003")
@source("platform:always-blocked-addresses")
forbid (principal, action == OpenShell::Action::"connect", resource)
when { resource.host == "localhost" };

@id("p004")
@source("platform:always-blocked-addresses")
forbid (principal, action == OpenShell::Action::"http_request", resource)
when { resource.host == "localhost" };

@id("p005")
@source("platform:control-plane-ports")
forbid (principal, action == OpenShell::Action::"connect", resource)
when { [2379, 2380, 6443, 10250, 10255].contains(resource.port) };

@id("p006")
