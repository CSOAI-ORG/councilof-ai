async function onRequestGet({ env }) {
  if (!env.SOV_ARENA_STATE) {
    return new Response(
      JSON.stringify({
        error: "no live rounds",
        detail: "KV binding SOV_ARENA_STATE is not visible to this function (deployment config)",
        label: "DESIGN"
