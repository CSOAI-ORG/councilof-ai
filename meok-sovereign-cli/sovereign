def call_mcp(mcp_name: str, tool_name: str, **kwargs) -> dict:
    """Call any sovereign MCP tool by name."""
    module_name = MCP_MODULES.get(mcp_name)
    if not module_name:
        return {"error": f"unknown MCP: {mcp_name}", "available": list(MCP_MODULES.keys())}
    try:
        # Import the module's directory, not the package name, to keep crypto
        # resolution independent of import order.
        import importlib.util as _ilu
        import importlib as _il
        # First try normal import
        try:
            module = _il.import_module(module_name)
        except ImportError:
            # Fall back: load directly from the package directory
            for p in MCP_PATHS:
                candidate = os.path.join(p, module_name)
                if os.path.isdir(candidate):
                    spec = _ilu.spec_from_file_location(
                        module_name,
                        os.path.join(candidate, "__init__.py"),
                    )
                    module = _ilu.module_from_spec(spec)
                    spec.loader.exec_module(module)
                    break
            else:
                return {"error": f"module {module_name} not importable"}
        # Smart tool name resolution
        direct = f"sov_{tool_name.replace('-', '_')}"
        mcp_prefixed = f"sov_{mcp_name.replace('-', '_')}_{tool_name.replace('-', '_')}"
        if hasattr(module, direct):
            func = getattr(module, direct)
        elif hasattr(module, mcp_prefixed):
            func = getattr(module, mcp_prefixed)
        else:
            available = sorted([a[4:] for a in dir(module) if a.startswith("sov_")])
            return {"error": f"tool {tool_name} not in {mcp_name}", "available": available}
        return func(**kwargs)
    except Exception as e:
        return {"error": str(e), "mcp": mcp_name, "tool": tool_name}


