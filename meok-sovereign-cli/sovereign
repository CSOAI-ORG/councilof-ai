def main():
    if len(sys.argv) < 2:
        cmd_discovery(None)
        return

    cmd = sys.argv[1]
    if cmd in ("discovery", "list", "test"):
        if cmd == "test":
            cmd_test_all(sys.argv[2:])
        elif cmd == "list":
            cmd_list(sys.argv[2:])
        else:
            cmd_discovery(sys.argv[2:])
        return

    # sovereign <mcp> <tool> [args...]
    if len(sys.argv) < 3:
        print(f"Usage: sovereign {cmd} <tool> [args...]")
        return

    mcp_name = cmd
    tool_name = sys.argv[2]
    # Smart tool name resolution: try sov_tool, then sov_mcp_tool
    module_name = MCP_MODULES.get(mcp_name)
    if module_name:
        try:
            module = __import__(module_name, fromlist=[""])
            # If direct sov_tool doesn't exist, try sov_mcp_tool
            direct = f"sov_{tool_name.replace('-', '_')}"
            mcp_prefixed = f"sov_{mcp_name.replace('-', '_')}_{tool_name.replace('-', '_')}"
            if hasattr(module, direct) and not hasattr(module, mcp_prefixed):
                tool_name = tool_name  # use direct
            elif hasattr(module, mcp_prefixed):
                tool_name = mcp_prefixed.replace("sov_", "")
            # else: keep original, will error
        except Exception:
            pass

    rest = sys.argv[3:]

    # Parse remaining args (key=value, --key value, or JSON)
    kwargs = {}
    positional = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a.startswith("--"):
            key = a[2:].replace("-", "_")
            if i + 1 < len(rest) and not rest[i+1].startswith("--"):
                v = rest[i+1]
                try:
                    v = json.loads(v)
                except Exception:
                    pass
                kwargs[key] = v
                i += 2
            else:
                kwargs[key] = True
                i += 1
        elif "=" in a:
            k, v = a.split("=", 1)
            try:
                v = json.loads(v)
            except Exception:
                pass
            kwargs[k.replace("-", "_")] = v
            i += 1
        else:
            try:
                positional.append(json.loads(a))
            except Exception:
                positional.append(a)
            i += 1

    # First positional = first kwarg
    if positional and tool_name in ("create", "scan", "store", "log", "audit", "speak", "emergency", "actuate", "quarantine", "estop", "register", "unregister", "search", "retrieve", "verify", "validate", "evaluate", "match", "ingest", "query", "audit_article_50", "worm_scan"):
        # The first positional is usually the main input (e.g. text, content, description)
        # Try common parameter names
        for pname in ("text", "content", "description", "input", "message", "code_or_system", "action", "scene_id", "record_id"):
            if pname in kwargs:
                break
        else:
            # Use first positional as "text" by default
            if positional:
                kwargs.setdefault("text", positional[0])
                positional = positional[1:]
    # Add remaining positional as positional args
    result = call_mcp(mcp_name, tool_name, *positional, **kwargs)
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
