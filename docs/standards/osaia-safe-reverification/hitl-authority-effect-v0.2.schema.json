{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://councilof.ai/schemas/hitl-authority-effect-v0.2.json",
  "title": "HITL authority-to-effect record, v0.2",
  "description": "Vendor-neutral record binding a human or explicitly authorized principal decision to one scoped invocation, its observed effect, and separate verification. v0.2 supersedes v0.1 (the v0.1 bytes are preserved unchanged). v0.2 adds two bindings that v0.1 left to the consumer: (1) a claim that is not CURRENT cannot authorize a consequential execution, and (2) an APPROVE decision must be bound to a current external authority record carrying the operational baseline, scope, authority epoch, validity window, expiry and revocation state. The record does not require GSPC, OpenShell, OpenBMC, LFX, or any specific runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile","record_id","issued_at","request","authority","invocation","effect","verification","limits"],
  "properties": {
    "profile": {"const":"csoai.hitl-authority-effect/0.2"},
    "record_id": {"type":"string","minLength":1},
    "issued_at": {"type":"string","format":"date-time"},
    "request": {
      "type":"object","additionalProperties":false,
      "required":["request_id","subject_ref","action","resource_ref","proposal_digest"],
      "properties":{
        "request_id":{"type":"string","minLength":1},
        "subject_ref":{"type":"string","minLength":1},
        "tenant_ref":{"type":["string","null"]},
        "action":{"type":"string","minLength":1},
        "resource_ref":{"type":"string","minLength":1},
        "proposal_digest":{"$ref":"#/$defs/digest"},
        "intent_ref":{"type":["string","null"]}
      }
    },
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["decision_id","decision","decided_at","principal_ref","authority_epoch","scope_digest","operational_baseline","validity_window","release_state","revocation_state","external_record_ref","external_record_digest","review_kind"],
      "properties":{
        "decision_id":{"type":"string","minLength":1},
        "decision":{"enum":["APPROVE","DENY","REVOKE"]},
        "decided_at":{"type":"string","format":"date-time"},
        "principal_ref":{"type":"string","minLength":1},
        "authority_epoch":{"type":"string","minLength":1},
        "scope_digest":{"$ref":"#/$defs/digest"},
        "operational_baseline":{
          "description":"The operational baseline the authority was granted against: the state of the subject and its dependencies at the moment the decision was taken. A decision that does not name the baseline it was taken against cannot be checked against what actually held.",
          "type":"object","additionalProperties":false,
          "required":["baseline_digest","observed_at"],
          "properties":{
            "baseline_digest":{"$ref":"#/$defs/digest"},
            "observed_at":{"type":"string","format":"date-time"},
            "scope_note":{"type":["string","null"]}
          }
        },
        "validity_window":{
          "description":"The interval during which this release of authority is valid. not_after is the expiry. The record states the window; a consumer checks that the invocation fell inside it.",
          "type":"object","additionalProperties":false,
          "required":["not_before","not_after"],
          "properties":{
            "not_before":{"type":"string","format":"date-time"},
            "not_after":{"type":"string","format":"date-time"}
          }
        },
        "release_state":{
          "description":"Whether this release of authority is still live. ACTIVE means it still authorizes; SUPERSEDED, SUSPENDED, EXPIRED and REVOKED mean it does not, and a record may still truthfully carry one of them alongside a historical execution.",
          "enum":["ACTIVE","SUPERSEDED","SUSPENDED","EXPIRED","REVOKED"]
        },
        "revocation_state":{
          "description":"The revocation state of the external authority record this decision is bound to, as known to the issuer of this record. REVOCATION_UNKNOWN fails closed: an unknown revocation state cannot support an APPROVE.",
          "enum":["NOT_REVOKED","REVOKED","REVOCATION_UNKNOWN"]
        },
        "external_record_ref":{
          "description":"Reference to the current external authority record this action release is bound to. The decision is bound to a record, not to a chat, a ticket or a person present at the time.",
          "type":"string","minLength":1
        },
        "external_record_digest":{"$ref":"#/$defs/digest"},
        "review_kind":{"enum":["HUMAN_REVIEW","AUTHORIZED_PRINCIPAL_REVIEW","PREAUTHORIZED_POLICY_WITH_HUMAN_MAXIMUM"]},
        "constraints":{"type":"array","maxItems":64,"items":{"type":"string","minLength":1}},
        "revokes_decision_id":{"type":["string","null"]}
      }
    },
    "invocation": {
      "type":"object","additionalProperties":false,
      "required":["state"],
      "properties":{
        "state":{"enum":["NOT_INVOKED","REJECTED","EXECUTED","FAILED_BEFORE_EFFECT"]},
        "executor_ref":{"type":["string","null"]},
        "tool_ref":{"type":["string","null"]},
        "invoked_at":{"type":["string","null"],"format":"date-time"},
        "invocation_digest":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},
        "failure_stage":{"type":["string","null"]}
      }
    },
    "effect": {
      "type":"object","additionalProperties":false,
      "required":["state"],
      "properties":{
        "state":{"enum":["NONE","UNKNOWN","OBSERVED","PARTIAL"]},
        "observed_at":{"type":["string","null"],"format":"date-time"},
        "effect_digest":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},
        "effect_ref":{"type":["string","null"]},
        "failure_stage":{"type":["string","null"]}
      }
    },
    "verification": {
      "type":"object","additionalProperties":false,
      "required":["state","evidence_refs"],
      "properties":{
        "state":{"enum":["NOT_RUN","UNCHECKABLE","VERIFIED","FAILED","PARTIAL"]},
        "verified_at":{"type":["string","null"],"format":"date-time"},
        "verifier_ref":{"type":["string","null"]},
        "method_ref":{"type":["string","null"]},
        "evidence_refs":{"type":"array","maxItems":128,"items":{"type":"string","minLength":1}}
      }
    },
    "claim_maintenance": {
      "type":"object","additionalProperties":false,
      "required":["watch_state"],
      "properties":{
        "claim_ref":{"type":["string","null"]},
        "reverification_record_ref":{"type":["string","null"]},
        "watch_state":{
          "description":"The live watch state of the claim this action depends on. Only CURRENT supports a live authorization; RETEST_DUE, STALE, UNMEASURED and NOT_WATCHED do not.",
          "enum":["CURRENT","RETEST_DUE","STALE","UNMEASURED","NOT_WATCHED"]
        },
        "watch_state_at_decision":{
          "description":"The watch state of the claim at the moment the authority decision was taken. It is a historical fact, kept separate from the live watch state so that a later staleness does not require rewriting the decision. An APPROVE decision requires this to have been CURRENT.",
          "enum":["CURRENT","RETEST_DUE","STALE","UNMEASURED","NOT_WATCHED",null]
        },
        "watch_state_at_invocation":{
          "description":"The watch state of the claim at the moment the action was invoked. An EXECUTED invocation requires this to have been CURRENT: a stale, due-for-retest or unmeasured claim is not authority to act.",
          "enum":["CURRENT","RETEST_DUE","STALE","UNMEASURED","NOT_WATCHED",null]
        },
        "next_review_condition":{"type":["string","null"]}
      }
    },
    "provenance": {
      "type":"object","additionalProperties":false,
      "properties":{
        "receipt_ref":{"type":["string","null"]},
        "signature_ref":{"type":["string","null"]},
        "transparency_ref":{"type":["string","null"]},
        "timestamp_ref":{"type":["string","null"]},
        "otel_trace_ref":{"type":["string","null"]},
        "ocsf_record_ref":{"type":["string","null"]}
      }
    },
    "limits":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}}
  },
  "allOf":[
    {
      "if":{"properties":{"authority":{"properties":{"decision":{"enum":["DENY","REVOKE"]}},"required":["decision"]}}},
      "then":{"properties":{"invocation":{"properties":{"state":{"enum":["NOT_INVOKED","REJECTED","FAILED_BEFORE_EFFECT"]}}}}}
    },
    {
      "if":{"properties":{"invocation":{"properties":{"state":{"const":"EXECUTED"}},"required":["state"]}}},
      "then":{"properties":{
        "authority":{"properties":{"decision":{"const":"APPROVE"}}},
        "invocation":{
          "required":["executor_ref","invoked_at","invocation_digest"],
          "properties":{
            "executor_ref":{"type":"string","minLength":1},
            "invoked_at":{"type":"string","format":"date-time"},
            "invocation_digest":{"$ref":"#/$defs/digest"}
          }
        }
      }}
    },
    {
      "if":{"properties":{"effect":{"properties":{"state":{"enum":["OBSERVED","PARTIAL"]}},"required":["state"]}}},
      "then":{"properties":{"effect":{
        "required":["observed_at","effect_digest"],
        "properties":{
          "observed_at":{"type":"string","format":"date-time"},
          "effect_digest":{"$ref":"#/$defs/digest"}
        }
      }}}
    },
    {
      "if":{"properties":{"verification":{"properties":{"state":{"enum":["VERIFIED","FAILED","PARTIAL"]}},"required":["state"]}}},
      "then":{"properties":{"verification":{"required":["verified_at","verifier_ref","method_ref"],"properties":{"verified_at":{"type":"string","format":"date-time"},"verifier_ref":{"type":"string","minLength":1},"method_ref":{"type":"string","minLength":1},"evidence_refs":{"minItems":1}}}}}
    },
    {
      "$comment":"Binding 1a — an APPROVE decision must rest on an authority that is not known to be revoked. An unknown revocation state fails closed.",
      "if":{"properties":{"authority":{"properties":{"decision":{"const":"APPROVE"}},"required":["decision"]}}},
      "then":{"properties":{"authority":{"properties":{"revocation_state":{"const":"NOT_REVOKED"}}}}}
    },
    {
      "$comment":"Binding 1b — a live release cannot rest on a claim that is not CURRENT. A release that has stopped being live may still truthfully carry a non-current watch state beside a historical execution.",
      "if":{"properties":{"authority":{"properties":{"release_state":{"const":"ACTIVE"}},"required":["release_state"]}},"required":["claim_maintenance"]},
      "then":{"properties":{"claim_maintenance":{"properties":{"watch_state":{"const":"CURRENT"}}}}}
    },
    {
      "$comment":"Binding 1c — a decision taken while the claim was not current is not an authorization.",
      "if":{"properties":{"authority":{"properties":{"decision":{"const":"APPROVE"}},"required":["decision"]}},"required":["claim_maintenance"]},
      "then":{"properties":{"claim_maintenance":{"properties":{"watch_state_at_decision":{"const":"CURRENT"}}}}}
    },
    {
      "$comment":"Binding 1d — an execution carried out while the claim was not current is not a conforming execution. This is what makes stale, due-for-retest and unmeasured claims non-authorizing.",
      "if":{"properties":{"invocation":{"properties":{"state":{"const":"EXECUTED"}},"required":["state"]}},"required":["claim_maintenance"]},
      "then":{"properties":{"claim_maintenance":{"properties":{"watch_state_at_invocation":{"const":"CURRENT"}}}}}
    }
  ],
  "$defs":{
    "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "digest":{"type":"object","additionalProperties":false,"required":["alg","value"],"properties":{"alg":{"const":"sha256"},"value":{"$ref":"#/$defs/hex64"}}}
  }
}
