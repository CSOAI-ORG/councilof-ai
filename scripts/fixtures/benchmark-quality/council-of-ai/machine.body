SOV-PQC — post-quantum readiness of signing formats\n\t\n\nSOV-PQC — a post-quantum readiness bank for signing formats, not for models.\npqcbench.json defines five deterministic criteria — algorithm agility (every signed record names its\nalgorithm), hybrid readiness (two signatures over one payload), an RFC 3161 trusted timestamp, RFC 4998\nevidence-record renewal, and a selectable PQC algorithm (ML-DSA, COSE −48/−49/−50) — and records a pass/fail\nper criterion for each signing subject… See the full description on the dataset page: https://huggingface.co/datasets/csoai/asisec-bench.","downloads":141,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-04T05:04:37.000Z","key":""},{"_id":"6a71973e8671154cd7be319a","id":"csoai/gspc-gov","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"GSPC — governance bank (GovBench)","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","governance","family-gspc","govbench","llm-evaluation","frozen-bank","model-comparison"],"task_categories":["question-answering","text-generation"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"items.jsonl"}]},{"config_name":"axis_live","data_files":[{"split":"train","path":"axis-live.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-06T06:56:48.000Z","likes":0,"trendingScore":0,"private":false,"sha":"2ea3fe816c75ba99d09e024ad816134a0afc2496","description":"\