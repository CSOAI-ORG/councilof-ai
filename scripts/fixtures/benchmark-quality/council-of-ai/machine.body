-by-4.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","board","signed"],"createdAt":"2026-08-23T09:17:24.000Z","key":""},{"_id":"6a8abbc62bc15bf4b0ea22d3","id":"csoai/gspc-sim-cards","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"Smoke-test simulation cards (no inference)","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["1K<n<10K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"sim_cards.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:53:08.000Z","likes":0,"trendingScore":0,"private":false,"sha":"67e774c8c346968d6f1c8f98a88eaffa945348c9","description":"\n\t\n\t\t\n\t\n\t\n\t\tSmoke-test simulation cards (no inference)\n\t\n\nSimulated cards from the smoke-test harness — no model inference happened. Each row\nof sim_cards.jsonl carries the card file, timestamp, axis, the question q, a canned policy answer a\n(\"Policy applied by smoke-test with calibrated confidence 0.60\"), an answer hash ah and a signed flag.\nPublished so the harness's plumbing is auditable; these are not measurements and must never be pooled\nwith a bank.\n\n\n\t\n\t\t\n\t\n\t\n\t\tThe live board is the… See the full description on the dataset page: https://huggingface.co/datasets/csoai/gspc-sim-cards.","downloads":133,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:1K<n<10K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-23T09:22:14.000Z","key":""},{"_id":"6a8b1d0e39eb84b2b26305cc","id":"csoai/arena-rounds","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"Arena Rounds","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","arena"],"task_categories":["other"],"size_categories":["1K<n<10K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"rounds.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:52:53.000Z","likes":0,"trendingScore":0,"private":false,"sha":"98964ae0f0d947829d0de4a6b44fae761d78d5de","description":"\n\t\n\t\t\n\t\n\t\n\t\tArena Rounds\n\t\n\nMeasurement data, never a ranking of vendors.\n\nNOTICE — Measurement, not certification. This dataset is a record of\ndeterministic, referee-based measurement. It is not a certification, a\nguarantee, an endorsement, or a ranking of any vendor, model, or system. No\nmodel in this dataset is \"certified\", \"approved\", \"audited\", or \"guaranteed\"\nsafe, aligned, or fit for any purpose. CSOAI disclaims any and all\nrepresentations of fitness for a particular purpose. Use at… See the full description on the dataset page: https://huggingface.co/datasets/csoai/arena-rounds.","downloads":107,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:1K<n<10K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","arena"],"createdAt":"2026-08-23T16:17:18.000Z","key":""},{"_id":"6a8b1d11f802c2dbfd3175ab","id":"csoai/arena-elo-by-axis","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"Arena Elo by axis (not a board score)","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","arena"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:52:51.000Z","likes":0,"trendingScore":0,"private":false,"sha":"b137090fc58878e74e6166928fa817f9c35e0d33","description":"\n\t\n\t\t\n\t\n\t\n\t\tArena Elo by axis (not a board score)\n\t\n\nA pairwise-arena Elo reference computed per axis. elo_reference.json carries the\naxis list, a content_id over the payload, and a leaderboard row per model: elo, games, winrate and a\nconfidence interval. This is an arena number over head-to-head rounds — it is not a GSPC board score and\ndoes not write to any slot.\n\n\n\t\n\t\t\n\t\n\t\n\t\tThe live board is the authority\n\t\n\n\n\n\nGET https://councilof.ai/api/gspc — quote totals.public_count. This Hub card is… See the full description on the dataset page: https://huggingface.co/datasets/csoai/arena-elo-by-axis.","downloads":109,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency","arena"],"createdAt":"2026-08-23T16:17:21.000Z","key":""},{"_id":"6a8b219f08c38fe0aef51ac0","id":"csoai/measured-vs-reported","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"Measured vs reported — the empty table, on purpose","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:53:12.000Z","likes":0,"trendingScore":0,"private":false,"sha":"118220135bc6aa22cecfce510360c4e580bc7211","description":"\n\t\n\t\t\n\t\n\t\n\t\tMeasured vs reported — the empty table, on purpose\n\t\n\nAn honesty artefact, and deliberately close to empty. overlap.json would map\nour measured Elo against third-party reported numbers, but its state reads \"UNKNOWN — no verified\ncross-platform Elo for our fleet models yet (honest, not fabricated)\", cells is [], and the gate is\nstated in the file: a reported cell is populated only when we hold a cited, attributed number for the same\nmodel we measured. Until that holds, the table… See the full description on the dataset page: https://huggingface.co/datasets/csoai/measured-vs-reported.","downloads":114,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-23T16:36:47.000Z","key":""},{"_id":"6a8b23809d54b03d2a341b36","id":"csoai/gspc-drift","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"GSPC drift rail — day-over-day consistency","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:53:01.000Z","likes":0,"trendingScore":0,"private":false,"sha":"772377c646325f8493c51720f17c952f2ec7916b","description":"\n\t\n\t\t\n\t\n\t\n\t\tGSPC drift rail — day-over-day consistency\n\t\n\nA longitudinal consistency signal over signed boards. drift_rail.json states its own\nmethod in the file: day-over-day best-score delta on MEASURED boards with n>=30, thin-n boards excluded,\nno model judges anywhere in the computation — the predicates are deterministic. Per axis it records the\nboards in the window, the window bounds, and the deltas between consecutive timestamps. Drift is a\nconsistency signal, not a certification.… See the full description on the dataset page: https://huggingface.co/datasets/csoai/gspc-drift.","downloads":135,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","doi:10.57967/hf/10111","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-23T16:44:48.000Z","key":""},{"_id":"6a8beb1cf77b919ed6b7587e","id":"csoai/gspc-axis-corpus","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"GSPC axis transcripts — prompts and full responses","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"gspc-axis.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:52:59.000Z","likes":0,"trendingScore":0,"private":false,"sha":"223fa37fd030ea6d823c82447eb7ccf3d98f8283","description":"\n\t\n\t\t\n\t\n\t\n\t\tGSPC axis transcripts — prompts and full responses\n\t\n\nThe transcript corpus behind graded runs. Each row of gspc-axis.jsonl carries the\naxis, the model, the prompt it was given and the full response it returned. This is the raw material\na grader reads — publishing it is what lets a stranger re-grade our runs instead of trusting our grades.\n\n\n\t\n\t\t\n\t\n\t\n\t\tThe live board is the authority\n\t\n\n\n\n\nGET https://councilof.ai/api/gspc — quote totals.public_count. This Hub card is a printer of… See the full description on the dataset page: https://huggingface.co/datasets/csoai/gspc-axis-corpus.","downloads":127,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:10K<n<100K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-24T06:56:28.000Z","key":""},{"_id":"6a8c705718643fbd8e599dc9","id":"csoai/eldorado-eval-results","author":"csoai","cardData":{"license":"cc-by-4.0","language":["en"],"pretty_name":"Eldorado — signed measurement receipts","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"data/measurements.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:52:56.000Z","likes":0,"trendingScore":0,"private":false,"sha":"f4f0264a3f84e677eec9f495624722b661bd7259","description":"\n\t\n\t\t\n\t\n\t\n\t\tEldorado — signed measurement receipts\n\t\n\nSigned measurement receipts. Each row of data/measurements.jsonl carries the\nregistry the measurement was taken against, the subject model and its subject_digest, the\nmeasured_count out of total_count and the resulting ratio, a content_hash over the payload, the\nreceipt_content_id, the anchor_time, and the DID that signed it\n(did:web:csoai.org#card-attestation-1). A ratio here is coverage of a registry, not an axis score.\n\n\n\t\n\t\t\n\t\n\t\n\t\tThe… See the full description on the dataset page: https://huggingface.co/datasets/csoai/eldorado-eval-results.","downloads":99,"tags":["task_categories:other","language:en","license:cc-by-4.0","size_categories:n<1K","format:json","modality:tabular","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-24T16:24:55.000Z","key":""},{"_id":"6a8c73c2187e6776388435a1","id":"csoai/eldorado-data-listing","author":"csoai","cardData":{"license":"apache-2.0","language":["en"],"pretty_name":"Eldorado data listing","tags":["gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"task_categories":["other"],"size_categories":["n<1K"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"data/qa.jsonl"}]},{"config_name":"manifest","data_files":[{"split":"train","path":"manifest.jsonl"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-04T05:52:55.000Z","likes":0,"trendingScore":0,"private":false,"sha":"97acfeb51d6bfac963273d0e82f417c26ee64d75","description":"\n\t\n\t\t\n\t\n\t\n\t\tEldorado data listing\n\t\n\nA measurement, never a certification. This is a licensable dataset of\nmeasurement-derived Q&A across the GSPC registry family. Each row is attributable to a\nsigned, RFC 3161-anchored measurement.\n\nRegister (verbatim): This data is derived from a measurement. It is not a\ncertification, endorsement, or conformity mark, and must not be presented as one.\n\nNeutrality: licenses the measured data, never the score. A buyer may license this\ndataset; nobody can buy a… See the full description on the dataset page: https://huggingface.co/datasets/csoai/eldorado-data-listing.","downloads":99,"tags":["task_categories:other","language:en","license:apache-2.0","size_categories:n<1K","format:json","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","gspc","council-of-ai","ai-governance","eu-ai-act","ai-safety","measurement","attestation","signed-evidence","responsible-ai","evaluation","benchmark","transparency"],"createdAt":"2026-08-24T16:39:30.000Z","key":""},{"_id":"6a8c7c08fc1d50a28f3f87a0","id":"csoai/gspc-board","author":"csoai","cardData":{"language":["en"],"license":"cc-by-4.0","tags":["governance","safety","measurement","gspc","ai-governance","council-of-ai"],"pretty_name":"GSPC Board Export","size_categories":["n<1K"],"task_categories":["text-classification"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"board.parquet"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-06T06:55:34.000Z","likes":0,"trendingScore":0,"private":false,"sha":"13701d202cbb7a26a81d8f957af44b6cd3460a27","description":"\n\t\n\t\t\n\t\n\t\n\t\tGSPC Board Export\n\t\n\nCouncil of AI · CSOAI Ltd (UK #16939677)\nSigned export of the GSPC governance measurement board. Live count, read from GET https://councilof.ai/api/gspc (totals.lid) at card-refresh time:\n\n22 axes measured · 14 model fleets · 3 public leader scores · 8 fact runs · TIE is TIE · not a certificate.\n\nThe “13 measured of 14” / 14-slot wording this line used to carry was the superseded canon. The board has been ruled at 22 axes; this card was still repeating the old… See the full description on the dataset page: https://huggingface.co/datasets/csoai/gspc-board.","downloads":370,"tags":["task_categories:text-classification","language:en","license:cc-by-4.0","size_categories:n<1K","format:parquet","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","doi:10.57967/hf/10114","region:us","governance","safety","measurement","gspc","ai-governance","council-of-ai"],"createdAt":"2026-08-24T17:14:48.000Z","key":""},{"_id":"6a8c7c9ca4a3e5e6ace36276","id":"csoai/gspc-bench-results","author":"csoai","cardData":{"language":["en"],"license":"cc-by-4.0","tags":["governance","benchmark","measurement","gspc","council-of-ai","transparency"],"pretty_name":"GSPC Bench Results","size_categories":["n<1K"],"task_categories":["text-classification"],"configs":[{"config_name":"default","data_files":[{"split":"train","path":"results.parquet"}]}]},"disabled":false,"gated":false,"lastModified":"2026-09-06T04:34:22.000Z","likes":0,"trendingScore":0,"private":false,"sha":"ee87e108add522417e7483bb4ff8b0359f5a84d6","description":"\n\t\n\t\t\n\t\n\t\n\t\tGSPC Bench Results\n\t\n\nPer-axis rows of the GSPC board, derived from GET https://councilof.ai/api/gspc at 2026-09-06T04:34:06Z into results.parquet — the only file the\ndataset viewer reads. The earlier files in this repository (gspc-bench-results.jsonl, results.json, results.csv,\nliving-board.json, eval.yaml) are the August 2026 export from the retired 14-slot count; they are kept as history,\nsuperseded by the live GET, and must not be quoted as the board. A row here is a printout… See the full description on the dataset page: https://huggingface.co/datasets/csoai/gspc-bench-results.","downloads":159,"tags":["task_categories:text-classification","language:en","license:cc-by-4.0","size_categories:n<1K","format:parquet","modality:text","library:datase