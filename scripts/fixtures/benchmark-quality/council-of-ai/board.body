<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The measurement board — every set, what it measures, what it does not</title>
    <meta name="description" content="One navigable board across every axis set this estate publishes. Each set states what it measures, over what, when, what it establishes and what it does not; evidence links preserve their actual signed or unsigned state.">

    <!-- SEO Meta Tags -->
    <meta name="keywords" content="AI safety, AI governance, EU AI Act, NIST AI RMF, AI compliance, AI risk management, responsible AI, AI ethics, AI regulation, PDCA, AI auditing">
    <meta name="author" content="CSOAI">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://councilof.ai/board">
    <!-- The feed is the estate's only return path. Without this tag it was reachable only at
         /api/feed.xml, which no reader or crawler guesses. -->
    <link rel="alternate" type="application/rss+xml" title="Council of AI — state changes" href="https://councilof.ai/feed.xml">
    <!-- The DERIVED feeds. /feed.xml above is a hand-maintained item list; these three are
         computed from the artifacts, so they cannot go stale between someone remembering to
         append. A feed nothing links to is the same as no feed — that was true of /api/feed.xml
         before it got its conventional aliases, and it was true of these until this line. -->
    <link rel="alternate" type="application/rss+xml" title="Council of AI — corrections ledger" href="https://councilof.ai/feeds/corrections.xml">
    <link rel="alternate" type="application/atom+xml" title="Council of AI — corrections ledger (Atom)" href="https://councilof.ai/feeds/corrections.atom">
    <link rel="alternate" type="application/rss+xml" title="Council of AI — newly signed measurement cards" href="https://councilof.ai/feeds/cards.xml">
    <link rel="alternate" type="application/rss+xml" title="Council of AI — public root" href="https://councilof.ai/feeds/roots.xml">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://councilof.ai/board">
    <meta property="og:title" content="Council of AI — we measure, we sign, we re-attest">
    <meta property="og:description" content="Independent measurement and signed attestation for AI governance. We measure and sign the evidence; regulators and accredited bodies decide. Every signed artefact verifies against a published public key.">
    <meta property="og:image" content="https://councilof.ai/og-image.png">
    <meta property="og:site_name" content="Council of AI">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://councilof.ai/board">
    <meta name="twitter:title" content="Council of AI — we measure, we sign, we re-attest">
    <meta name="twitter:description" content="Independent AI-governance measurement and signed attestation. Measurement, not certification. Artefacts verify against published public keys.">
    <meta name="twitter:image" content="https://councilof.ai/og-image.png">

    <!-- Additional SEO -->
    <meta name="theme-color" content="#000000">
    <meta name="application-name" content="Council of AI">
    <meta name="apple-mobile-web-app-title" content="Council of AI">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <!-- Structured Data / JSON-LD — canon entity graph (audit §4.3, 2026-08-14).
         One public name "Council of AI" + alternateName CSOAI; connected via @id.
         GovernmentOrganization REMOVED — CSOAI LTD is a UK private company, that type was
         factually false and a trust-penalty risk. Duplicate FAQ + cross-domain BreadcrumbList
         removed. SearchAction omitted until /search?q= is verified. -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://councilof.ai/#org",
      "name": "Council of AI",
      "alternateName": "CSOAI",
      "legalName": "CSOAI LTD",
      "identifier": [
        {"@type": "PropertyValue", "propertyID": "Companies House", "value": "16939677"},
        {"@type": "PropertyValue", "propertyID": "DID", "value": "did:web:csoai.org"}
      ],
      "url": "https://councilof.ai/",
      "logo": "https://councilof.ai/csoai-icon.svg",
      "description": "Council of AI (CSOAI LTD, UK) is a neutral AI measurement body. It issues verified measurement credentials — 3KB measurement cards signed with Ed25519 and SHA-256 hash-chained against did:web:csoai.org (OpenTimestamps anchoring is on the roadmap, not yet wired) — never certification, accreditation or conformity assessment.",
      "founder": {"@type": "Person", "name": "Nicholas Templeman"},
      "foundingDate": "2025",
      "sameAs": ["https://github.com/CSOAI-ORG", "https://huggingface.co/csoai", "https://www.wikidata.org/wiki/Q141128616"]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Council of AI",
      "url": "https://councilof.ai/",
      "publisher": {"@id": "https://councilof.ai/#org"},
      "inLanguage": "en"
    }
    </script>
    <!-- FAQPage JSON-LD removed from the shell (qa-sweep 2026-08-19): the shell ships on EVERY
         route, so this block (a) duplicated the page-level FAQPage nodes on pages that render a
         visible FAQ (home carried 3 FAQPage nodes), (b) claimed FAQ content on hundreds of pages
         with no visible FAQ, and (c) hardcoded stamp counts ("19 models", "127 provisions",
         "12 Aug") that drift — counts defer to GET /api/gspc. Page-level FaqBlock emits the
         FAQPage node for exactly what each page renders. -->


    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/csoai-icon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Google Fonts: Inter + Archivo + Source Serif 4 (editorial headlines) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&amp;display=swap" rel="stylesheet">

    <!-- Per-route self-canonical: each crawled URL canonicals to itself (not just the root).
         NB: during prerender (scripts/prerender.mjs) the captured markup's localhost origin is
         rewritten to the production origin, so static pages never ship a localhost canonical. -->
    <script>(function(){try{var u=location.origin+location.pathname.replace(/\/$/,"")||location.origin;var c=document.querySelector('link[rel=canonical]');if(c)c.href=u;var o=document.querySelector('meta[property="og:url"]');if(o)o.setAttribute("content",u);var t=document.querySelector('meta[name="twitter:url"]');if(t)t.setAttribute("content",u);}catch(e){}})();</script>
    <script type="module" crossorigin="" src="/assets/index.r2-CmE9TaOU.js"></script>
    <link rel="stylesheet" crossorigin="" href="/assets/index.r2-DHkxBzgi.css">
