      (function () {
        function fixHashLinks() {
          // In-page anchors scroll only — never write the hash or a history
          // entry, so Back always leaves the page. (ToC links do the same via
          // their own handler.) Targets that rely on `:target` opt out with
          // data-native-fragment and keep native fragment navigation.
          document
            .querySelectorAll('a[href^="#"]:not(.toc-nav-link)')
            .forEach(function (link) {
              link.addEventListener("click", function (e) {
                var hash = link.getAttribute("href");
                if (!hash || hash === "#") return;
                var target = document.querySelector(hash);
                if (target && !target.hasAttribute("data-native-fragment")) {
                  e.preventDefault();
                  target.scrollIntoView({ behavior: "smooth" });
                }
              });
            });
        }
        fixHashLinks();
        document.addEventListener("astro:page-load", fixHashLinks);
      })();
    </script> </body> </html>