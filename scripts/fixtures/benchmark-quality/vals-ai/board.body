      (function () {
        const root = document.documentElement;
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const faviconLink = document.getElementById("favicon");
        const forceLight = root.dataset.forceLight === "true";
        const storedTheme = localStorage.getItem("theme");
        const theme = forceLight ? "light" : storedTheme || "system";

        if (forceLight) localStorage.setItem("theme", "light");

        function applyTheme(doc) {
          if (doc.dataset.forceLight === "true") {
            doc.classList.remove("dark");
            if (faviconLink) faviconLink.href = "/favicon-dark.svg";
            return;
          }
          const isDark =
            theme === "dark" || (theme === "system" && mediaQuery.matches);
          if (isDark) {
            doc.classList.add("dark");
            if (faviconLink) faviconLink.href = "/favicon-light.svg";
          } else {
            doc.classList.remove("dark");
            if (faviconLink) faviconLink.href = "/favicon-dark.svg";
          }
        }

        applyTheme(root);

        if (theme === "system" && !forceLight) {
          mediaQuery.addEventListener("change", function () {
            applyTheme(root);
          });
        }

        document.addEventListener("astro:before-swap", function (e) {
          document.documentElement.classList.remove("dark");
          const theme = localStorage.getItem("theme") || "system";
          const newRoot = e.newDocument.documentElement;
          if (newRoot.dataset.forceLight === "true") {
            newRoot.classList.remove("dark");
            return;
          }
          const isDark =
            theme === "dark" || (theme === "system" && mediaQuery.matches);
          if (isDark) {
            newRoot.classList.add("dark");
          } else {
            newRoot.classList.remove("dark");
          }
        });
      })();
    </script><link rel="stylesheet" href="/_astro/_slug_.BXXS2qrV.css">
