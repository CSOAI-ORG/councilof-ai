                    <li id="dropdownContainer" class="nav-item inline-block dropdown research-dropdown" style="position: relative; list-style-type: none;">
                        <a id="dropdownButton" class="nav-link text-black">Research</a>
                        <div>
                            <ul id="dropdownMenu" class="hidden absolute border border-solid border-black mb-3 z-10 dropdown-content menu shadow-lg bg-base-100 rounded-box " role="menu" style="list-style-type: none; position: absolute; top: 100%; left: 0; min-width: max-content; width: auto; padding: 0.5rem 0; text-align: left; background-color: #FEFEFE;">
                                <li class="z-40 dropdown-item" style="text-align: left;"><a href="https://crfm.stanford.edu/helm" class="block px-4 py-2 hover:bg-gray-100 whitespace-nowrap" role="menuitem" style="text-align: left;">HELM</a></li>
                                <li class="z-40 dropdown-item" style="text-align: left;"><a href="https://crfm.stanford.edu/2023/06/16/levanter-1_0-release.html" class="block px-4 py-2 hover:bg-gray-100 whitespace-nowrap" role="menuitem" style="text-align: left;">Levanter</a></li>
                                <li class="z-40 dropdown-item" style="text-align: left;"><a href="https://crfm.stanford.edu/fmti" class="block px-4 py-2 hover:bg-gray-100 whitespace-nowrap" role="menuitem" style="text-align: left;">FMTI</a></li>
                                <li class="z-40 dropdown-item" style="text-align: left;"><a href="https://crfm.stanford.edu/open-fms/" class="block px-4 py-2 hover:bg-gray-100 whitespace-nowrap" role="menuitem" style="text-align: left;">Openness</a></li>
                                <li class="z-40 dropdown-item" style="text-align: left;"><a href="https://crfm.stanford.edu/ecosystem-graphs/" class="block px-4 py-2 hover:bg-gray-100 whitespace-nowrap" role="menuitem" style="text-align: left;">Ecosystem Graphs</a></li>
                            </ul>
                        </div>
