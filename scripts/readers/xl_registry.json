{
 "schema": "csoai.cross-ledger-xl-registry/0.1",
 "what_this_is": "Extension of scripts/readers/cross_ledger_assets.json for the daily top-20% loop (scripts/readers/cross_ledger_xl.py). Ledgers and assets here are MERGED over that file (same keys win here). Every deployment identifier is parsed from the issuer's own page bytes at run time; none is typed here. 'value_match' says how an asset is found in the keyless value sources, which are used for SELECTION ONLY.",
 "selection": {
  "rule": "Frame = every candidate in the value sources with a positive value (DefiLlama stablecoins: circulating x price; CoinGecko tokenised-fund categories: market_cap). Candidates are deduplicated by upper-case symbol, DefiLlama first. Ranked by value, descending; the top ceil(20% x N) are selected. Owner-named instruments are added if outside the quintile and labelled owner_named. Value is a selection rule for what to read first, never a measured fact and never a ranking of issuers.",
  "quintile": 0.2,
  "owner_named": [
   "BENJI",
   "BUIDL",
   "OUSG",
   "USDY",
   "USTB",
   "JPMD",
   "RLUSD"
  ],
  "sources": [
   {
    "id": "defillama-stablecoins",
    "url": "https://stablecoins.llama.fi/stablecoins?includePrices=true",
    "kind": "defillama_stablecoins"
   },
   {
    "id": "coingecko-tokenized-treasuries",
    "url": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&category=tokenized-treasuries&per_page=250",
    "kind": "coingecko_markets"
   },
   {
    "id": "coingecko-tokenized-mmfs",
    "url": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&category=tokenized-money-market-fund-mmfs&per_page=250",
    "kind": "coingecko_markets"
   }
  ]
 },
