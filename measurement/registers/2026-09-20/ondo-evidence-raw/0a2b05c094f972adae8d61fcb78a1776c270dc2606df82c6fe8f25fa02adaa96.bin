7294 9.40051Z" fill="#004830"></path></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">High-Quality Assets</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Backed by high-quality assets, which currently include BlackRock’s USD Institutional Digital Liquidity Fund (BUIDL), USDC, and bank deposits.</p><a target="_self" style="color:#000000" href="#holdings"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Learn More<span class="screen-reader-text MuiBox-root css-0"> <!-- -->about <!-- -->High-Quality Assets</span></p></a></div></div></div><div style="opacity:0;transform:translateY(40px)"><div class="MuiStack-root css-1yich7"><svg width="40px" height="40px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M21 7.46143L12 2.96143L3 7.46143V10.0396L3.00466 10.0812L3.75 9.99777C3.00466 10.0812 3.00479 10.0824 3.00483 10.0827L3.0051 10.0851L3.00599 10.0927L3.00915 10.119C3.01189 10.1413 3.01594 10.1731 3.02144 10.2139C3.03243 10.2953 3.04923 10.4125 3.07304 10.5602C3.12062 10.8555 3.19635 11.274 3.30988 11.7749C3.53624 12.7735 3.91634 14.1151 4.53197 15.4652C5.74905 18.1342 8.00464 21.0603 12 21.0603C15.9953 21.0603 18.2509 18.1342 19.468 15.4652C20.0837 14.1151 20.4638 12.7735 20.6901 11.7749C20.8037 11.274 20.8794 10.8555 20.927 10.5602C20.9508 10.4125 20.9676 10.2953 20.9786 10.2139C20.9841 10.1731 20.9881 10.1413 20.9909 10.119L20.994 10.0927L20.9949 10.0851L20.9952 10.0827L20.9953 10.0812L21 10.0396V7.46143ZM20.25 9.99777C20.9953 10.0812 20.9954 10.0809 20.9953 10.0812L20.25 9.99777ZM4.50797 10.0133L4.5 9.95245V8.38848L12 4.63848L19.5 8.38848V9.95245L19.492 10.0133C19.4826 10.0829 19.4677 10.1873 19.4461 10.3216C19.4028 10.5903 19.3328 10.9774 19.2272 11.4433C19.0153 12.3783 18.6632 13.6148 18.1032 14.8428C16.9691 17.3301 15.0996 19.5603 12 19.5603C8.90034 19.5603 7.03094 17.3301 5.89677 14.8428C5.33678 13.6148 4.9847 12.3783 4.77277 11.4433C4.66717 10.9774 4.59723 10.5903 4.55393 10.3216C4.5323 10.1873 4.51736 10.0829 4.50797 10.0133ZM10.675 16.0856L16.9606 9.79992L15.9 8.73926L10.675 13.9643L8.29998 11.5893L7.23932 12.6499L10.675 16.0856Z" fill="#004830"></path></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Trusted &amp; Transparent</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Full financial reporting prepared and published daily by a 3rd-party administrator.</p><a target="_blank" style="color:#000000" href="https://docs.ondo.finance/qualified-access-products/ousg/trust-and-transparency"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Learn More<span class="screen-reader-text MuiBox-root css-0"> <!-- -->about <!-- -->Trusted &amp; Transparent</span></p></a></div></div></div><div style="opacity:0;transform:translateY(40px)"><div class="MuiStack-root css-1yich7"><svg width="40px" height="40px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.25 3.25H16.75V6.15394L14.1374 12.25H20.75V17.75H3.25V12.25H9.8626L7.25 6.15394V3.25ZM11.4945 12.25H12.5055L15.25 5.84606V4.75H8.75V5.84606L11.4945 12.25ZM4.75 13.75V16.25H19.25V13.75H4.75ZM18 20.75H6V19.25H18V20.75Z" fill="#004830"></path></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Regulatory Compliance</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">OUSG represents interests in a 3(c)(7) fund and is offered and sold in reliance on Rule 506(c) of the US Securities Act.</p><a target="_blank" style="color:#000000" href="https://docs.ondo.finance/qualified-access-products/ousg/regulatory-compliance"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Learn More<span class="screen-reader-text MuiBox-root css-0"> <!-- -->about <!-- -->Regulatory Compliance</span></p></a></div></div></div></div></div></div></div><div class="MuiBox-root css-1qu51dy"><div class="product-section MuiBox-root css-16rve4n"><div class="MuiContainer-root MuiContainer-maxWidthXl css-11lxkg4" id="use-cases"><p class="MuiTypography-root MuiTypography-bodyM-gx css-148n899"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Use Cases</span></span></span></p><div class="MuiStack-root css-y02z9u"><div class="MuiStack-root css-b95f0i"><h2 class="MuiTypography-root MuiTypography-h2-os css-5mnnbg"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Institutional-Grade Meets Crypto Native.</span></span></span></h2></div><div class="MuiStack-root css-1yebqhw"><div class="MuiStack-root css-10j3jk3"><p class="MuiTypography-root MuiTypography-bodyM-az css-aw8skc"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">OUSG combines exposure to some of the historically safest, most stable, and most liquid traditional yield-bearing assets with the speed, accessibility, and utility of the blockchain.</span></span></span></p></div></div></div><div class="MuiBox-root css-wzut1n"><div style="opacity:0;transform:translateY(40px)"><div class="MuiStack-root css-1yich7"><svg width="40px" height="40px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M6 4H5.25V4.75V7H3H2.25V7.75V11.7V19.75V20.5H3H18H18.75V19.75V17.5H21H21.75V16.75V4.75V4H21H6ZM18.75 16H20.25V5.5H6.75V7H18H18.75V7.75V16ZM3.75 11V8.5H17.25V19H3.75V12.5H14V11H3.75ZM13 16H16V17.5H13V16Z" fill="currentColor"></path></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Cash Management</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Earn low-risk yield on your cash with the benefits of instant, 24/7 minting and redeeming.</p></div></div></div><div style="opacity:0;transform:translateY(40px)"><div class="MuiStack-root css-1yich7"><svg width="40px" height="40px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.0185 13.6218L14.613 18.8268V3.50932H13.198V20.4903L14.3963 21L21 14.6411L20.0185 13.6218ZM10.8394 3.50932L9.64077 3L3.03705 9.36788L4.01931 10.3865L9.42436 5.1745V20.4903H10.8394V3.50932Z" fill="currentColor"></path></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Borrowing &amp; Lending</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Keep earning yield when you pledge OUSG as collateral for borrowing.</p></div></div></div><div style="opacity:0;transform:translateY(40px)"><div class="MuiStack-root css-1yich7"><svg width="40px" height="40px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g transform="translate(1.8 2.6)"><path d="M3 0H19.5V7.75H18V1.5H4.5V3H13.75V4.5H1.5V7H10.75V8.5H1.5V15H11.75V16.5H0V3H3V0Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M16.5 3.84364L9.47718 13.5H13.8V19.2564L20.8228 9.60003H16.5V3.84364ZM12.4228 12L15 8.45641V11.1H17.8772L15.3 14.6436V12H12.4228Z" fill="currentColor"></path></g></svg><div class="MuiStack-root css-4jin6z"><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Bilateral Settlement</p><p class="MuiTypography-root MuiTypography-bodyM-gx css-4kp16v">Instantly settle transactions while continuously earning yield.</p></div></div></div></div></div></div><div class="MuiBox-root css-0"><div class="product-section MuiBox-root css-16rve4n"><div class="MuiContainer-root MuiContainer-maxWidthXl css-11lxkg4" id="holdings"><p class="MuiTypography-root MuiTypography-bodyM-gx css-1jsfnc5"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Holdings</span></span></span></p><div class="MuiBox-root css-xfkzf6"><div class="MuiStack-root css-1jt85an"><div class="MuiStack-root css-rwaagi"><h2 class="MuiTypography-root MuiTypography-h2-gx css-epbpr6"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Backed by Institutional-Grade Assets and Partners.</span></span></span></h2><p class="MuiTypography-root MuiTypography-bodyM-az css-1kd8d3u"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">The OUSG portfolio is invested in funds issued by leading asset managers such as BlackRock, Franklin Templeton, WisdomTree, Fidelity, and others, along with bank deposits and USDC for liquidity purposes.</span></span></span></p></div><div class="MuiStack-root css-wztgrz"><div style="opacity:0;transform:translateY(8px)"><a target="_blank" rel="noreferrer noopener" style="color:inherit;white-space:nowrap" href="https://app.ondo.finance/legal-documentation/us"><div class="MuiStack-root css-1wydv7a"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_4724_308431)"><path d="M7.8335 17.0001H13.6668M7.8335 13.6668H8.66683M7.8335 10.333