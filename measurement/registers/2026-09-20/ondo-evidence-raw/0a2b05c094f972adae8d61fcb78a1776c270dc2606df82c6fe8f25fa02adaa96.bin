:[[\"$\",\"$L2b\",null,{\"title\":\"Who is eligible to buy OUSG?\",\"children\":[\"$\",\"$L2c\",null,{\"children\":[\"Organizations or individuals in eligible countries - including the US - who have onboarded to our Qualified-Access Funds can invest in, redeem, or transfer, or receive OUSG. See all the ways you can qualify\",\" \",[\"$\",\"$L2d\",null,{\"target\":\"_blank\",\"href\":\"https://docs.ondo.finance/qualified-access-products/ousg/eligibility-\u0026-onboarding\",\"style\":{\"color\":\"inherit\"},\"children\":\"here\"}],\".\"]}]}],[\"$\",\"$L2b\",null,{\"title\":\"How is OUSG backed?\",\"children\":[\"$\",\"$L2c\",null,{\"children\":\"The significant majority of this portfolio is currently in the BlackRock USD Institutional Digital Liquidity Fund (BUIDL), with the remainder in BlackRock's FedFund (TFDXX), bank deposits, and USDC for liquidity purposes. The portfolio may, in the future, include other US Treasury funds and/or direct investments in US Treasuries.\"}]}],[\"$\",\"$L2b\",null,{\"title\":\"How do I invest?\",\"children\":\"$L2e\"}],\"$L2f\"]}],\"$L30\"]}]\n"])</script><script>self.__next_f.push([1,"31:I[87307,[\"4940\",\"static/chunks/1059d7ef-811472ce6753b3ee.js\",\"3249\",\"static/chunks/990a3170-72b6573bb8f462f2.js\",\"6940\",\"static/chunks/50f238d9-0f3d35bee963f64a.js\",\"8114\",\"static/chunks/be197179-fa82d6140bcdb5df.js\",\"1835\",\"static/chunks/1835-2b3cdfa80e71d68b.js\",\"625\",\"static/chunks/625-579857c4a8fc69b9.js\",\"4619\",\"static/chunks/4619-ba786849c0795044.js\",\"6455\",\"static/chunks/6455-9ea096149a4d310b.js\",\"5150\",\"static/chunks/5150-bdda039538a7e2df.js\",\"9966\",\"static/chunks/9966-b611902c3bd2d2b3.js\",\"8191\",\"static/chunks/8191-339b5aefc0fd04a0.js\",\"8616\",\"static/chunks/8616-680edaa55d6d33a4.js\",\"8301\",\"static/chunks/8301-1c6950a5e2abf72f.js\",\"2662\",\"static/chunks/2662-722fcef6f2a50160.js\",\"2383\",\"static/chunks/2383-d86a2b21761dd571.js\",\"3981\",\"static/chunks/3981-22b2d7044a764ab1.js\",\"2075\",\"static/chunks/2075-d15d097bc5e78fa0.js\",\"3358\",\"static/chunks/3358-a433b6e69d22fbc0.js\",\"8764\",\"static/chunks/8764-97a8ddafae04c636.js\",\"5756\",\"static/chunks/5756-bf818b2f9e8401fc.js\",\"413\",\"static/chunks/413-2cf23a76bf1a25e5.js\",\"9844\",\"static/chunks/9844-b79e86380b263d6f.js\",\"1916\",\"static/chunks/1916-69296399e3281ad2.js\",\"8535\",\"static/chunks/8535-8a6b39d058e8055f.js\",\"9377\",\"static/chunks/app/ousg/page-b74c1174cd334f28.js\"],\"DarkTheme\"]\n"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"$L2c\",null,{\"children\":\"To invest, you must first onboard to our Qualified-Access Funds. Once you complete onboarding, you can invest either USD via wire transfer or via any supported stablecoin.\"}]\n2f:[\"$\",\"$L2b\",null,{\"title\":\"What is the minimum I can invest in OUSG?\",\"children\":[\"$\",\"$L2c\",null,{\"children\":[\"For instant transactions, the minimum amount is\",\" \",[\"$\",\"span\",null,{\"children\":[\"$\",\"span\",null,{\"children\":[\"$$\",\"5K\",\" for both investments and redemptions\"]}]}],\". For non-instant transactions, our minimum investment and redemption amounts are $100K and $50K, respectively.\"]}]}]\n30:[\"$\",\"$L31\",null,{\"children\":\"$L32\"}]\n"])</script><script>self.__next_f.push([1,"33:I[1893,[\"4940\",\"static/chunks/1059d7ef-811472ce6753b3ee.js\",\"3249\",\"static/chunks/990a3170-72b6573bb8f462f2.js\",\"6940\",\"static/chunks/50f238d9-0f3d35bee963f64a.js\",\"8114\",\"static/chunks/be197179-fa82d6140bcdb5df.js\",\"1835\",\"static/chunks/1835-2b3cdfa80e71d68b.js\",\"625\",\"static/chunks/625-579857c4a8fc69b9.js\",\"4619\",\"static/chunks/4619-ba786849c0795044.js\",\"6455\",\"static/chunks/6455-9ea096149a4d310b.js\",\"5150\",\"static/chunks/5150-bdda039538a7e2df.js\",\"9966\",\"static/chunks/9966-b611902c3bd2d2b3.js\",\"8191\",\"static/chunks/8191-339b5aefc0fd04a0.js\",\"8616\",\"static/chunks/8616-680edaa55d6d33a4.js\",\"8301\",\"static/chunks/8301-1c6950a5e2abf72f.js\",\"2662\",\"static/chunks/2662-722fcef6f2a50160.js\",\"2383\",\"static/chunks/2383-d86a2b21761dd571.js\",\"3981\",\"static/chunks/3981-22b2d7044a764ab1.js\",\"2075\",\"static/chunks/2075-d15d097bc5e78fa0.js\",\"3358\",\"static/chunks/3358-a433b6e69d22fbc0.js\",\"8764\",\"static/chunks/8764-97a8ddafae04c636.js\",\"5756\",\"static/chunks/5756-bf818b2f9e8401fc.js\",\"413\",\"static/chunks/413-2cf23a76bf1a25e5.js\",\"9844\",\"static/chunks/9844-b79e86380b263d6f.js\",\"1916\",\"static/chunks/1916-69296399e3281ad2.js\",\"8535\",\"static/chunks/8535-8a6b39d058e8055f.js\",\"9377\",\"static/chunks/app/ousg/page-b74c1174cd334f28.js\"],\"NewsView\"]\n"])</script><script>self.__next_f.push([1,"32:[\"$\",\"$L31\",null,{\"children\":[\"$\",\"$L33\",null,{\"featuredPosts\":[{\"_createdAt\":\"2025-04-02T22:19:34Z\",\"_id\":\"652f63c0-6daf-4e82-bb82-cd8c2e595c00\",\"_rev\":\"sXVsSmU81EJjEYkHCx9KJg\",\"_type\":\"newsPost\",\"_updatedAt\":\"2025-04-02T22:20:32Z\",\"altText\":\"Ondo Finance Expands Institutional Reach with OUSG Deployment on the XRP Ledger\",\"author\":\"Ondo Finance\",\"body\":\"Ondo Finance will deploy Ondo Short-Term US Government Treasuries (OUSG), its tokenized US Treasury fund, on the XRP Ledger (XRPL), a decentralized layer-1 blockchain. This deployment, set to go live within the next six months, will bring OUSG to the XRPL's broad institutional user base, introducing a composable and compliance-first asset to a blockchain built for financial institutions. This integration establishes an avenue for institutional DeFi and advanced cash management solutions, bringing DeFi and traditional finance closer than ever.\",\"href\":\"https://blog.ondo.finance/ondo-finance-expands-institutional-reach-with-ousg-deployment-on-the-xrp-ledger/\",\"id\":\"652f63c0-6daf-4e82-bb82-cd8c2e595c00\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-3ed6c3a4a787a15bb2f06a463f027f5944e5bb1c-1600x900-png\",\"_type\":\"reference\"}},\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/3ed6c3a4a787a15bb2f06a463f027f5944e5bb1c-1600x900.png\",\"publishedAt\":\"2025-01-28T19:00:00.000Z\",\"tags\":[\"Blog\"],\"title\":\"Ondo Finance Expands Institutional Reach with OUSG Deployment on the XRP Ledger\"},{\"_createdAt\":\"2025-04-14T14:39:37Z\",\"_id\":\"c88ad6c5-7a8f-4259-adcf-f1d90e25e721\",\"_rev\":\"gL8gM3I7LMSWCEjtb67xLt\",\"_type\":\"newsPost\",\"_updatedAt\":\"2025-04-14T14:40:55Z\",\"altText\":\"The Liquidity Advantage: How OUSG Provides Robust, Multi-Venue Instant Liquidity\",\"author\":\"Ondo Finance\",\"body\":\"Bringing real-world assets onchain demands institutional-grade infrastructure. At Ondo Finance, we're committed to building such infrastructure, and our tokenized US Treasuries fund, OUSG, exemplifies this commitment.\\n\\nThe launch of BlackRock and Securitize’s BlackRock USD Institutional Digital Liquidity Fund (BUIDL) in March 2024 introduced a meaningful step forward for tokenized Treasuries, particularly through its integration with Circle to enable instant redemptions to USDC.\",\"href\":\"https://blog.ondo.finance/the-liquidity-advantage-how-ousg-provides-robust-multi-venue-instant-liquidity/\",\"id\":\"c88ad6c5-7a8f-4259-adcf-f1d90e25e721\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-24e6d3637a76d4b74254d06b904d8b6c547d0313-1600x960-png\",\"_type\":\"reference\"}},\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/24e6d3637a76d4b74254d06b904d8b6c547d0313-1600x960.png\",\"publishedAt\":\"2025-04-14T14:40:00.000Z\",\"tags\":[\"Blog\"],\"title\":\"The Liquidity Advantage: How OUSG Provides Robust, Multi-Venue Instant Liquidity\"},{\"_createdAt\":\"2025-05-29T07:54:47Z\",\"_id\":\"ef629f50-2d52-485e-889b-0d4127d13682\",\"_rev\":\"VOOXsQOKRNXVz2VOUB554t\",\"_type\":\"newsPost\",\"_updatedAt\":\"2025-05-29T07:55:30Z\",\"altText\":\"Zodia Custody Now Supports USDY, with OUSG Support Coming Soon, Enabling Institutions to Access Secure, Yield-Bearing Digital Assets\",\"author\":\"Ondo Finance\",\"body\":\"Ondo Finance is pleased to announce that Zodia Custody now supports USDY, with OUSG support coming soon. Institutional clients can utilize Zodia’s compliant custody solution to securely deposit yield-generating assets, and utilize them across their cash management needs. This marks another key access point for institutions and family offices to tap into efficient, composable cash management solutions backed by short-term US Treasuries.\",\"href\":\"https://blog.ondo.finance/zodia-custody-now-supports-usdy-with-ousg-support-coming-soon-enabling-institutions-to-access-secure-yield-bearing-digital-assets/\",\"id\":\"ef629f50-2d52-485e-889b-0d4127d13682\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f85de48ea5db8a9fba47b75c4fc277409e3c5b8c-1600x960-png\",\"_type\":\"reference\"}},\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/f85de48ea5db8a9fba47b75c4fc277409e3c5b8c-1600x960.png\",\"publishedAt\":\"2025-05-29T07:55:00.000Z\",\"tags\":[\"Blog\"],\"title\":\"Zodia Custody Now Supports USDY, with OUSG Support Coming Soon, Enabling Institutions to Access Secure, Yield-Bearing Digital Assets\"},{\"_createdAt\":\"2025-06-11T12:23:30Z\",\"_id\":\"f8d39a3d-8e99-4b09-b282-c6b5194de577\",\"_rev\":\"xK9UQKrcG4OWEgDsKf5gZx\",\"_type\":\"newsPost\",\"_updatedAt\":\"2025-06-11T12:24:05Z\",\"altText\":\"Ondo Finance Brings Tokenized Treasuries to the XRP Ledger with Seamless Mint \u0026 Redeem via Ripple’s RLUSD Stablecoin\",\"author\":\"Ondo Finance\",\"body\":\"Ondo Finance has launched its flagship tokenized US treasury fund, Ondo Short-Term US Government Treasuries (OUSG), on the XRP Ledger (XRPL), a decentralized layer-1 blockchain.\",\"href\":\"https://blog.ondo.finance/ondo-finance-brings-tokenized-treasuries-to-the-xrp-ledger-with-seamless-mint-redeem-via-ripples-rlusd-stablecoin/\",\"id\":\"f8d39a3d-8e99-4b09-b282-c6b5194de577\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-89835588164e255b27f8a213b6d0bfbb929fc2b9-1600x960-png\",\"_type\":\"reference\"}},\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/89835588164e255b27f8a213b6d0bfbb929fc2b9-1600x960.png\",\"publishedAt\":\"2025-06-11T12:24:00.000Z\",\"tags\":[\"Blog\"],\"title\":\"Ondo Finance Brings Tokenized Treasuries to the XRP Ledger with Seamless Mint \u0026 Redeem via Ripple’s RLUSD Stablecoin\"}],\"researchPosts\":[{\"id\":\"6738fc86-274b-450f-a48b-7c37d7410a44\",\"title\":\"Strengthening American Leadership In Digital Financial Technology\",\"body\":\"The digital asset industry plays a crucial role in innovation and economic development in the United States, as well as our Nation’s international leadership. It is therefore the policy of my Administration to support the responsible growth and use of digital assets, blockchain technology, and related technologies across all sectors of the economy, including by:\",\"altText\":\"Strengthening American Leadership In Digital Financial Technology\",\"publishedAt\":\"2025-07-17T21:20:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://www.whitehouse.gov/wp-content/uploads/2025/07/digital-Assets-Report-EO14178.pdf\",\"author\":\"The White House\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/2919aa6fe794c719d4715e4a3c8501f2bc04103a-1280x720.png\"},{\"id\":\"204777a0-0dbe-4e2b-9991-86355a480544\",\"title\":\"Asset Tokenization in Financial Markets: The Next Generation of Value Exchange\",\"body\":\"Tokenization offers a new model of digital asset ownership that enhances transparency, efficiency and accessibility. This report analyses asset class use cases in issuance, securities financing and asset management, identifying factors that enable successful tokenization implementation.\",\"altText\":\"World Economic Forum\",\"publishedAt\":\"2025-05-21T15:18:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://www.weforum.org/publications/asset-tokenization-in-financial-markets-the-next-generation-of-value-exchange/\",\"author\":\"World Economic Forum\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/903553643c22266010e3e3ff938ce366c2c72056-2200x1137.webp\"},{\"id\":\"32df0cdd-c5c0-4838-909f-4c20d7ab2f4d\",\"title\":\"Treasury Presentation to TBAC\",\"body\":\"Tokenized Treasury Funds: Provides investors access to “tokenized” forms of Treasuries on blockchains that behave in many ways like Treasury ETFs or government MMFs. The largest of these funds are BlackRock's BUIDL Fund and Franklin Templeton’s OnChain U.S.\\nGovernment Money Fund. Other notable funds or projects include Ondo Financial, Hashnote, and CoinShares.\",\"altText\":\"The department of treasury logo\",\"publishedAt\":\"2024-10-29T23:08:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://home.treasury.gov/system/files/221/CombinedChargesforArchivesQ42024.pdf\",\"author\":\"US Treasury Department\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/382ada4c9c78f6dd44d96ee36d12f3d89a839de9-1200x675.png\"},{\"id\":\"e9a04c48-cdc7-4a7c-9d5a-5ed52e71c57f\",\"title\":\"Money Tokens: The Digital Revolution Reshaping Money\",\"body\":\"Imagine a world where your money is no longer just a number in a bank account, but a digital token that can be programmed, transferred instantly, and used across various financial platforms.\",\"altText\":\"Bretton Woods Committee logo\",\"publishedAt\":\"2024-10-18T23:12:00.000Z\",\"tags\":[\"Article\"],\"href\":\"https://www.brettonwoods.org/article/money-tokens-the-digital-revolution-reshaping-money\",\"author\":\"Bretton Woods\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/b7f4f79f02778ba3ef42bcd709b0fd196607dfd4-1200x675.png\"}]}]}]\n"])</script></body></html>