-1tgg7h0"><div class="MuiStack-root css-95g4uk"><div class="MuiStack-root css-isog2r"><p class="MuiTypography-root MuiTypography-h5-gx css-gk5mde">$<!-- -->116.6054</p><div class="MuiStack-root css-u4p24i"><p class="MuiTypography-root MuiTypography-monoXS css-1rses7c">$0.0000<!-- --> <span>today</span></p></div></div><div class="MuiStack-root css-eps869"><div class="MuiBox-root css-dubjyx" role="button" tabindex="0" aria-pressed="false"><p class="MuiTypography-root MuiTypography-labelS css-198mdxh">1W</p></div><div class="MuiBox-root css-dubjyx" role="button" tabindex="0" aria-pressed="false"><p class="MuiTypography-root MuiTypography-labelS css-198mdxh">1M</p></div><div class="MuiBox-root css-dubjyx" role="button" tabindex="0" aria-pressed="false"><p class="MuiTypography-root MuiTypography-labelS css-198mdxh">1Y</p></div><div class="MuiBox-root css-1krwjbl" role="button" tabindex="0" aria-pressed="true"><p class="MuiTypography-root MuiTypography-labelS css-198mdxh">ALL</p></div></div></div><div class="MuiBox-root css-bowuv7"></div></div></div></div></div><div class="MuiBox-root css-n4lw85"><div class="MuiContainer-root MuiContainer-maxWidthXl css-11lxkg4"><p class="MuiTypography-root MuiTypography-bodyM-gx css-148n899"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">OUSG in Detail</span></span></span></p><div class="MuiStack-root css-1ggmqy8"><div class="MuiStack-root css-1hw5xvz"><h2 class="MuiTypography-root MuiTypography-h2-os css-1upubpv"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Sustainable Yield, Transparent Fees.</span></span></span></h2><div class="MuiStack-root css-atvd6t"><p class="MuiTypography-root MuiTypography-bodyM-az css-aw8skc"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">OUSG provides Qualified Purchasers with exposure to short-term US Treasuries and money market funds with 24/7 stablecoin mints and redemptions.</span></span></span></p><p class="MuiTypography-root MuiTypography-bodyM-az css-aw8skc"><span style="display:flex;flex-direction:column"><span style="display:block;overflow:hidden;padding-block:0.1em;margin-block:-0.1em;padding-inline:0.1em;margin-inline:-0.1em"><span style="display:block;opacity:0;transform:translateY(100%)">Fund expenses are capped at 0.15%. Management fees are capped at 0.15% and waived until January 1, 2027.</span></span></span></p><div style="opacity:0;transform:translateY(8px)"><a component="a" target="_blank" href="https://docs.ondo.finance/qualified-access-products/ousg/fees-and-taxes" class="base-Button-root css-1hx4d4f">Learn More<span class="screen-reader-text MuiBox-root css-0"> <!-- -->about OUSG fees and taxes</span></a></div></div></div><div class="MuiBox-root css-75qdog"><div class="MuiBox-root css-1rvclbr"><svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M11 4.75C9.75736 4.75 8.75 5.75736 8.75 7C8.75 8.24264 9.75736 9.25 11 9.25C12.2426 9.25 13.25 8.24264 13.25 7C13.25 5.75736 12.2426 4.75 11 4.75ZM7.25 7C7.25 4.92894 8.92893 3.25 11 3.25C13.0711 3.25 14.75 4.92894 14.75 7C14.75 9.07107 13.0711 10.75 11 10.75C8.92893 10.75 7.25 9.07107 7.25 7ZM5.75 19C5.75 16.1005 8.1005 13.75 11 13.75C13.8995 13.75 16.25 16.1005 16.25 19V19.25L5.75 19.25V19ZM4.25 19.25V19C4.25 15.2721 7.27208 12.25 11 12.25C14.7279 12.25 17.75 15.2721 17.75 19V19.25H19V20.75L3 20.75V19.25H4.25ZM21.4697 7.46973L18 10.9394L16.5303