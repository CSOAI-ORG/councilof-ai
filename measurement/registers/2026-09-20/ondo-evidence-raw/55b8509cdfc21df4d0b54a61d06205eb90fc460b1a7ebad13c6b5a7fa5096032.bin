-ba786849c0795044.js\",\"6455\",\"static/chunks/6455-9ea096149a4d310b.js\",\"5150\",\"static/chunks/5150-bdda039538a7e2df.js\",\"5697\",\"static/chunks/5697-292b89b75cec7f78.js\",\"9966\",\"static/chunks/9966-b611902c3bd2d2b3.js\",\"8191\",\"static/chunks/8191-339b5aefc0fd04a0.js\",\"8616\",\"static/chunks/8616-680edaa55d6d33a4.js\",\"8301\",\"static/chunks/8301-1c6950a5e2abf72f.js\",\"3981\",\"static/chunks/3981-22b2d7044a764ab1.js\",\"2075\",\"static/chunks/2075-d15d097bc5e78fa0.js\",\"3358\",\"static/chunks/3358-a433b6e69d22fbc0.js\",\"413\",\"static/chunks/413-2cf23a76bf1a25e5.js\",\"9844\",\"static/chunks/9844-b79e86380b263d6f.js\",\"1916\",\"static/chunks/1916-69296399e3281ad2.js\",\"2185\",\"static/chunks/2185-5acd9555423c96d0.js\",\"4514\",\"static/chunks/4514-7c9d6aa059092e43.js\",\"8974\",\"static/chunks/app/page-433810f1a62fa3e5.js\"],\"LandingPageNewsView\"]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"$L37\",null,{\"featuredPosts\":[{\"id\":\"7a5f3af2-5763-4bf6-ab2e-601ba739e6b0\",\"title\":\"US Regulator Opens Markets To Tokenised Stock Trading \",\"body\":\"The US Securities and Exchange Commission has greenlit trading in tokenised stocks in a move that is expected to push crypto companies more firmly into traditional equity markets.\",\"altText\":\"US Regulator Opens Markets To Tokenized Stock Trading\",\"publishedAt\":\"2026-09-17T22:44:00.000Z\",\"tags\":[\"Article\"],\"href\":\"https://www.ft.com/content/b528698e-9b04-4497-9d22-67e401be21d3\",\"author\":\"Financial Times\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/1d2ab10b1189662182af4dda0dad1857649218c6-700x394.avif\"},{\"id\":\"d6e6da75-1e95-4cd7-aa73-e7e4c070058e\",\"title\":\"Ondo’s Oasis Pro Markets Joins DTCC’s Fund/SERV Processing Network\",\"body\":\"Ondo Finance’s broker-dealer subsidiary Oasis Pro Markets has joined DTCC’s Fund/SERV platform, becoming the network’s first tokenization-company participant, according to a joint announcement.\",\"altText\":\"Ondo’s Oasis Pro Markets Joins DTCC’s Fund/SERV Processing Network\",\"publishedAt\":\"2026-09-16T20:14:00.000Z\",\"tags\":[\"Article\"],\"href\":\"https://thedefiant.io/converge/tradfi-and-fintech/ondo-s-oasis-pro-markets-joins-dtcc-s-fund-serv-processing-network\",\"author\":\"The Defiant\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/0c45ba1632b7ab9d33b794fb9996dcb3eb72571f-1600x960.webp\"},{\"id\":\"7c41121b-0331-402c-b622-cb02afb2de15\",\"title\":\"Ondo Finance Taps Former GFMA Executive Director Allison Parent as Chief Policy Officer\",\"body\":\"Blockchain platform Ondo Finance is bolstering its policy work with the appointment of a career regulatory titan, Allison Parent, as the company's chief policy officer.\",\"altText\":\"Ondo Finance Taps Former GFMA Executive Director Allison Parent as Chief Policy Officer\",\"publishedAt\":\"2026-08-28T15:11:00.000Z\",\"tags\":[\"Article\"],\"href\":\"https://www.theblock.co/news/regulation/2026-08-28-ondo-finance-taps-former-gfma-executive-director-allison-parent-chief-policy-officer-413022?page=1\",\"author\":\"The Block\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/43a0bd9609ed4686fd3d9941700fd2e6d4148dec-1600x900.webp\"},{\"id\":\"b39ecb91-9273-42df-913f-aed8c54157e7\",\"title\":\"Ondo's Tokenized Stocks Hit $1B in 8 Months: John Hoffman\",\"body\":\"John Hoffman spent 18 years in traditional finance at Invesco, most recently running its ETF business in the Americas. Three months before this interview he joined Ondo Finance as Managing Director, and he argues the two careers are the same career.\",\"altText\":\"Ondo's Tokenized Stocks Hit $1B in 8 Months: John Hoffman\",\"publishedAt\":\"2026-08-27T15:33:00.000Z\",\"tags\":[\"Podcast\"],\"href\":\"https://www.youtube.com/watch?v=4LcUHKVq8Sw\",\"author\":\"The Block\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/15bd7aa897a67e1ca577f979eb487150a5891f84-1280x720.jpg\"}],\"featuredResearchPosts\":[{\"id\":\"6738fc86-274b-450f-a48b-7c37d7410a44\",\"title\":\"Strengthening American Leadership In Digital Financial Technology\",\"body\":\"The digital asset industry plays a crucial role in innovation and economic development in the United States, as well as our Nation’s international leadership. It is therefore the policy of my Administration to support the responsible growth and use of digital assets, blockchain technology, and related technologies across all sectors of the economy, including by:\",\"altText\":\"Strengthening American Leadership In Digital Financial Technology\",\"publishedAt\":\"2025-07-17T21:20:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://www.whitehouse.gov/wp-content/uploads/2025/07/digital-Assets-Report-EO14178.pdf\",\"author\":\"The White House\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/2919aa6fe794c719d4715e4a3c8501f2bc04103a-1280x720.png\"},{\"id\":\"204777a0-0dbe-4e2b-9991-86355a480544\",\"title\":\"Asset Tokenization in Financial Markets: The Next Generation of Value Exchange\",\"body\":\"Tokenization offers a new model of digital asset ownership that enhances transparency, efficiency and accessibility. This report analyses asset class use cases in issuance, securities financing and asset management, identifying factors that enable successful tokenization implementation.\",\"altText\":\"World Economic Forum\",\"publishedAt\":\"2025-05-21T15:18:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://www.weforum.org/publications/asset-tokenization-in-financial-markets-the-next-generation-of-value-exchange/\",\"author\":\"World Economic Forum\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/903553643c22266010e3e3ff938ce366c2c72056-2200x1137.webp\"},{\"id\":\"32df0cdd-c5c0-4838-909f-4c20d7ab2f4d\",\"title\":\"Treasury Presentation to TBAC\",\"body\":\"Tokenized Treasury Funds: Provides investors access to “tokenized” forms of Treasuries on blockchains that behave in many ways like Treasury ETFs or government MMFs. The largest of these funds are BlackRock's BUIDL Fund and Franklin Templeton’s OnChain U.S.\\nGovernment Money Fund. Other notable funds or projects include Ondo Financial, Hashnote, and CoinShares.\",\"altText\":\"The department of treasury logo\",\"publishedAt\":\"2024-10-29T23:08:00.000Z\",\"tags\":[\"Research\"],\"href\":\"https://home.treasury.gov/system/files/221/CombinedChargesforArchivesQ42024.pdf\",\"author\":\"US Treasury Department\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/382ada4c9c78f6dd44d96ee36d12f3d89a839de9-1200x675.png\"},{\"id\":\"e9a04c48-cdc7-4a7c-9d5a-5ed52e71c57f\",\"title\":\"Money Tokens: The Digital Revolution Reshaping Money\",\"body\":\"Imagine a world where your money is no longer just a number in a bank account, but a digital token that can be programmed, transferred instantly, and used across various financial platforms.\",\"altText\":\"Bretton Woods Committee logo\",\"publishedAt\":\"2024-10-18T23:12:00.000Z\",\"tags\":[\"Article\"],\"href\":\"https://www.brettonwoods.org/article/money-tokens-the-digital-revolution-reshaping-money\",\"author\":\"Bretton Woods\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/b7f4f79f02778ba3ef42bcd709b0fd196607dfd4-1200x675.png\"}]}]\n"])</script></body></html>