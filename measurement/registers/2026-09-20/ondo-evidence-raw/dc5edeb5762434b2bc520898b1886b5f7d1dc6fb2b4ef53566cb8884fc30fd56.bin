rByAria\":\"Filter by {label}\",\"sortByAria\":\"Sort by {label}\",\"moreCategories\":{\"aria\":\"More categories\",\"placeholder\":\"More\"},\"categories\":{\"all-assets\":\"All assets\",\"24-7-available\":\"24/7 Available\",\"etf\":\"ETF\",\"technology\":\"Technology\",\"consumer-discretionary\":\"Consumer\",\"financials\":\"Financials\",\"large-cap\":\"Large Cap\",\"growth\":\"Growth\",\"value\":\"Value\"},\"sort\":{\"most-popular\":\"Most Popular\",\"least-popular\":\"Least Popular\",\"top-gainer\":\"Top Gainer\",\"top-loser\":\"Top Loser\",\"newest\":\"Newest\",\"oldest\":\"Oldest\",\"token-price-high-low\":\"Price: High to Low\",\"token-price-low-high\":\"Price: Low to High\"},\"dynamicLists\":{\"top-gainer\":\"Top Gainers\",\"most-popular\":\"Trending\",\"newest\":\"Newly Added\"},\"sortToggle\":{\"token-price\":\"Price\",\"24h-percent\":\"24H (%)\",\"24h-volume\":\"24H Volume\",\"created-at\":\"Created At\"},\"mobileFilter\":{\"filter\":\"Filter\",\"sort\":\"Sort\",\"view\":\"View\",\"cancel\":\"Cancel\",\"confirm\":\"Confirm\"},\"assetList\":{\"errorLine1\":\"Something is wrong.\",\"errorLine2\":\"Please try again later.\",\"noResults\":\"No results found\"},\"apiError\":\"Something went wrong. Please try again later.\",\"marketIndicesError\":\"We couldn’t load market index data. Try reloading the page.\",\"pill24h\":\"24H\",\"toggleList\":\"Toggle {title} list\",\"assetLogoAlt\":\"{name} logo\",\"portfolioBanner\":{\"connected\":{\"totalValue\":\"Total Portfolio Value\",\"period24h\":\"24H\",\"period1w\":\"1W\",\"period1m\":\"1M\",\"viewPortfolio\":\"View Portfolio\"}}},\"assetPage\":{\"loading\":{\"about\":\"About\",\"statistics\":\"Statistics\",\"pay\":\"Pay\",\"receive\":\"Receive\"},\"pageTitleIconAlt\":\"{symbol}-icon\",\"about\":{\"title\":\"About\",\"supportedChains\":\"Supported Chains\",\"onchainAddress\":\"Onchain Address\",\"category\":\"Category\",\"underlyingAssetName\":\"Underlying Asset Name\",\"underlyingAssetTicker\":\"Underlying Asset Ticker\",\"sharesPerToken\":\"Shares Per Token\",\"showMore\":\"Show More\",\"showLess\":\"Show Less\"},\"statistics\":{\"title\":\"Statistics\",\"price\":\"Price\",\"currentApy\":\"Current APY¹\",\"tvl\":\"TVL\",\"tokenPrice\":\"Token Price\",\"underlyingAssetPrice\":\"Underlying Asset Price\",\"underlyingAssetStatistics\":\"Underlying Asset Statistics\",\"underlyingAssetDividend\":\"Underlying Asset Dividend\",\"open\":\"Open\",\"high\":\"High\",\"low\":\"Low\",\"totalMarketCap\":\"Total Market Cap\",\"volume24h\":\"24h Volume\",\"averageVolume\":\"Average Volume\",\"dividendYield\":\"Dividend Yield\",\"payoutFrequency\":\"Payout Frequency\",\"lastDividendAmount\":\"Last Dividend Amount\",\"close\":\"Close\",\"totalMarketCapTooltip\":\"The total market capitalization of the asset on the traditional exchanges (ex. NYSE, NASDAQ) from which we source liquidity.\",\"volume24hTooltip\":\"The 24h volumes of the asset on the traditional exchanges (ex. NYSE, NASDAQ) from which we source liquidity.\",\"averageVolumeTooltip\":\"The average daily volumes for the past year of the asset on the traditional exchanges (ex. NYSE, NASDAQ) from which we source liquidity.\",\"dividendYieldTooltipOverridden\":\"Stated annualized dividend yield, exclusive of \u003clink\u003etax withholdings\u003c/link\u003e.\",\"dividendYieldTooltipDefault\":\"Dividend yield is calculated using dividends paid over the past 12 months and is \u003clink\u003eexclusive of tax withholdings\u003c/link\u003e.\",\"payoutFrequencyTooltip\":\"The frequency at which dividends are paid out, if applicable.\",\"lastDividendAmountTooltip\":\"The most recent cash dividend paid per share, if applicable.\"},\"mintRedemption\":{\"title\":\"Mint and Redemption Capabilities\",\"minimumAmount\":\"Minimum Amount\",\"supportedPurchaseMethods\":\"Supported Purchase Methods\",\"purchaseMethodsTooltip\":\"When you purchase Ondo tokenized stocks with other stablecoins such as USDC, our platform \u003clink\u003eatomically swaps that stablecoin for USDon\u003c/link\u003e and then uses USDon to buy the tokenized stock. (Similarly, when you sell your tokenized stock for USDC, our platform first redeems for USDon and then swaps that for USDC, all in one atomic transaction).\"},\"ecosystem\":{\"title\":\"Ecosystem\",\"name\":\"Name\",\"network\":\"Network\",\"type\":\"Type\",\"asset\":\"Asset\",\"tokenIconAlt\":\"Token Icon\",\"tokenIconAltWithSymbol\":\"{symbol} Token Icon\"},\"topHoldings\":{\"title\":\"Top 10 Holdings\",\"name\":\"Name\",\"ticker\":\"Ticker\",\"allocation\":\"Allocation\",\"asOf\":\"As of {date}\"},\"recommendations\":{\"title\":\"Investors Also Own\",\"disclaimer\":\"This data is generated based on Ondo Stocks data. It's not investment advice.\"},\"legalDocuments\":{\"title\":\"Legal Documents\"},\"chart\":{\"selectRange\":\"Select range\",\"selectMetric\":\"Select metric\",\"metricPrice\":\"{symbol} Price\",\"metricTvl\":\"{symbol} TVL\",\"error\":\"Oops! Something went wrong. Please refresh the page and try again later.\",\"errorRetry\":\"Oops! Something went wrong. Please try again later.\",\"noData\":\"No data available\"},\"holdings\":{\"portfolioOverview\":\"Portfolio Overview\",\"valueOfUsdyOutstanding\":\"Value of USDY Outstanding³\",\"valueOfUnderlyingAssets\":\"Value of Underlying Assets\",\"valueOfUnderlyingAssetsFootnote\":\"Value of Underlying Assets⁴\",\"collateralizationRatio\":\"Collateralization Ratio⁵\",\"position\":\"Position\",\"currentValueUsdy\":\"Current Value⁶\",\"wam\":\"WAM⁷\",\"ytm\":\"YTM⁸\",\"currentValueOusg\":\"Current Value³\",\"sevenDayYield\":\"7-Day Yield²\",\"thirtyDayYield\":\"30-Day Yield²\",\"showMorePositions\":\"Show {count, plural, one {# More Position} other {# More Positions}}\",\"asOf\":\"As of {date}\",\"days\":\"day(s)\"},\"sessionLimits\":{\"title\":\"Session Limits\",\"description\":\"The following table highlights the maximum single trade size for each asset for the given trading session. For example if the maximum trade size for {symbol} is $1M in the regular session, you may submit 3 subsequent trades of $1M to acquire $3M worth of {symbol}. The off-hours limit reflects a maximum net position (buys and sells offset) while the U.S. market is closed.\",\"marketHoursTitle\":\"Market Hours\",\"marketHoursWindow\":\"(Sun 8:00 PM ET - Fri 8:00 PM ET)\",\"offMarketHoursTitle\":\"Off Market Hours\",\"offMarketHoursWindow\":\"(Fri 8:00 PM ET - Sun 8:00 PM ET, Holidays)\",\"columnSession\":\"Session\",\"columnHours\":\"Hours\",\"columnLimit\":\"Limit\",\"continuous\":\"Continuous\",\"etSuffix\":\"(ET)\",\"dollarSuffix\":\"($)\"},\"tokenholderProtections\":{\"title\":\"Tokenholder Protections\",\"viewReports\":\"View Reports\",\"yes\":\"Yes\",\"bankruptcyRemoteLabel\":\"Bankruptcy Remote\",\"bankruptcyRemoteTooltip\":\"The assets backing {symbol} tokens are held in a bankruptcy-remote entity with distinct assets, liabilities and governance from all other entities, including Ondo Finance Inc. This structure is designed to ringfence and protect these assets in the event of a bankruptcy or insolvency of any other entity. \u003clearnMore\u003eLearn More\u003c/learnMore\u003e\",\"securityInterestLabel\":\"Security Interest in Collateral\",\"securityInterestTooltipEquities\":\"{symbol} token holders get the benefit of a first priority security interest in the equities or ETFs that back their tokens. That security interest is held by an independent third-party collateral agent who can seize and liquidate the collateral to pay tokenholders. \u003clearnMore\u003eLearn More\u003c/learnMore\u003e\",\"securityInterestTooltipTreasuries\":\"{symbol} token holders get the benefit of a first priority security interest in the U.S. Treasuries that back their tokens. That security interest is held by an independent third-party collateral agent who can seize and liquidate the collateral to pay tokenholders. \u003clearnMore\u003eLearn More\u003c/learnMore\u003e\",\"reportsDaily\":\"Daily Attestation Reports\",\"reportsMonthly\":\"Monthly Attestation Reports\",\"reportsDailyUsdyLlc\":\"Daily Attestation Reports - Ondo USDY LLC\",\"reportsMonthlyUsdyLlc\":\"Monthly Attestation Reports - Ondo USDY LLC\",\"reportsDailyGmBvi\":\"Daily Attestation Reports - Ondo Global Markets (BVI) Limited\",\"reportsMonthlyGmBvi\":\"Monthly Attestation Reports - Ondo Global Markets (BVI) Limited\"},\"sharesPerToken\":{\"tooltip\":\"Each Ondo Stocks token tracks the total return of the underlying stock, including reinvested dividends (net of tax withholdings) and stock splits.\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eInstead of issuing payouts or new shares, these returns are compounded into the token's value—which may cause each token to represent an increasing number of underlying shares over time.\u003cbr\u003e\u003c/br\u003e\u003cbr\u003e\u003c/br\u003eThe Shares Per Token multiplier reflects this exposure. \u003clink\u003eLearn More\u003c/link\u003e\"},\"chartAll\":\"ALL\",\"chartRange\":{\"oneDay\":\"1D\",\"oneMonth\":\"1M\",\"threeMonths\":\"3M\",\"sixMonths\":\"6M\",\"oneYear\":\"1Y\",\"ytd\":\"YTD\",\"allTime\":\"All Time\"},\"portfolio\":{\"priceUnavailable\":\"Price unavailable\",\"aum\":\"AUM\",\"otherSector\":\"Other\",\"categories\":{\"income\":\"Income\",\"allocation\":\"Allocation\",\"thematic\":\"Thematic\",\"other\":\"Other\"},\"about\":{\"modelProvider\":\"Model Provider\",\"holdings\":\"Number of Constituents\",\"rebalanceFrequency\":\"Rebalance Frequency\",\"rebalanceFrequencyTooltip\":\"How often portfolio constituents are adjusted back to their base weights.\",\"reconstitution\":\"Reconstitution\",\"reconstitutionTooltip\":\"How often portfolio constituents may be added or removed. 'Fixed' means the portfolio composition does not change after inception{cadence, select, monthly {, but weights may rebalance approximately every month} quarterly {, but weights may rebalance approximately every quarter} semiAnnually {, but weights may rebalance approximately every six months} annually {, but weights may rebalance approximately once a year} other {}}.\",\"inceptionDate\":\"Inception Date\"},\"composition\":{\"title\":\"Composition\",\"sectorTab\":\"Sector\",\"holdingsTab\":\"Constituents\",\"showAll\":\"Show All {count}\",\"showTop\":\"Show Top {count}\",\"empty\":\"No composition data available.\",\"colNumber\":\"#\",\"colName\":\"Name\",\"colSymbol\":\"Symbol\",\"colBaseWeight\":\"Base Weight\",\"colCurrentWeight\":\"Current Weight\",\"colQuantity\":\"Quantity\",\"colOnchainAddress\":\"Onchain Address\",\"colAssetClass\":\"Type\",\"colSector\":\"Sector\",\"colAssetValue\":\"% of Asset Value\",\"helperTargetAllocation\":\"Target allocation by asset type as of {inceptionDate}.\",\"helperCurrentAllocation\":\"Current allocation based on market value as of {asOfDate}. Actual portfolio compositions may differ and are subject to {cadence, select, monthly {rebalancing changes approximately every month from inception date} quarterly {rebalancing changes approximately every quarter from inception date} semiAnnually {rebalancing changes approximately every six months from inception date} annually {rebalancing changes approximately once a year from inception date} other {change}}.\",\"helperPartialCurrentWeight\":\"*Current Weight excludes constituents without a current price, so it does not cover the full portfolio.\",\"helperAllocations\":\"Actual portfolio compositions may differ. Subject to change.\"},\"viewToggle\":{\"pie\":\"Pie chart view\",\"list\":\"Table view\",\"line\":\"Line chart view\",\"selectView\":\"Select chart view\"},\"income\":{\"title\":\"Income and Distributions\",\"dividendYield\":\"Dividend Yield\",\"dividendYieldTooltip\":\"Weighted average annual dividend yield aggregated across the portfolio's underlying assets, before tax withholding.\",\"dividendAfterWithholding\":\"After-withholding Yield\",\"dividendAfterWithholdingTooltip\":\"Weighted average annual dividend yield aggregated across the portfolio's underlying assets, net of tax withholding. Dividends are reinvested into the assets that paid them at this net amount.\",\"netAssets\":\"Net Assets\",\"totalTokenSupply\":\"Total Token Supply\",\"lastRebalance\":\"Last Rebalance\",\"lastRebalanceTooltip\":\"Date of the most recent rebalance\"},\"fees\":{\"title\":\"Fees\",\"serviceFee\":\"Service Fee\",\"totalServiceFee\":\"Total Service Fee\",\"feeWaivers\":\"Fee Waivers\"},\"chart\":{\"simulatedPerformance\":\"Performance shown before portfolio inception date {inceptionDate} is based on backtesting, not actual results. Performance after inception reflects actual results. Past performance does not guarantee future results.\",\"simulatedPerformanceNoDate\":\"Performance shown before the portfolio inception date is based on backtesting, not actual results. Performance after inception reflects actual results. Past performance does not guarantee future results.\"},\"hero\":{\"ytdReturn\":\"YTD Return\",\"returnTooltip\":\"The portfolio token's price return {period}. Newly listed portfolio tokens show return since inception date (see inception date in the About section).\",\"rangeReturn\":\"{range} Return\",\"tooltipPeriod\":{\"oneDay\":\"over the past 24 hours\",\"oneMonth\":\"over the past month\",\"threeMonths\":\"over the past 3 months\",\"sixMonths\":\"over the past 6 months\",\"oneYear\":\"over the past year\",\"ytd\":\"so far this year\",\"allTime\":\"over its full history\"},\"modelProvider\":\"Model Provider\",\"modelProviderTooltip\":\"The entity that sets the asset allocations and base weights of this portfolio.\",\"holdings\":\"Constituents\",\"holdingsTooltip\":\"The tokenized assets that make up this portfolio.\",\"netAssets\":\"Net Assets\",\"ytdSuffix\":\"YTD\"},\"faqs\":{\"title\":\"FAQs\",\"questionCount\":\"{count, plural, one {# Question} other {# Questions}}\"}}},\"invest\":{\"selectNetwork\":\"Select network\",\"tab\":{\"buy\":\"Buy\",\"sell\":\"Sell\",\"convert\":\"Convert\"},\"convertOnlyEthereum\":\"Convert is only available on Ethereum\",\"label\":{\"pay\":\"Pay\",\"receive\":\"Receive\",\"swapDirection\":\"Swap direction\"},\"badge\":{\"rebasing\":\"Rebasing\",\"stablecoin\":\"Stablecoin\"},\"stablecoinMinimum\":\"Minimum: ${min}\",\"button\":{\"connectWallet\":\"Connect Wallet\",\"loading\":\"Loading\",\"completeOnboarding\":\"Complete Onboarding\",\"applicationUnderReview\":\"Application Under Review\",\"notEligible\":\"Not Eligible for {product}\",\"checkProductAccess\":\"Check Product Access\",\"proceedToPurchase\":\"Proceed To Purchase\",\"proceedToSell\":\"Proceed To Sell\",\"proceedToRedeem\":\"Proceed to Redeem\",\"signUpOrSignIn\":\"Sign Up or Sign In\",\"switchWallet\":\"Switch Wallet\",\"switchNetwork\":\"Switch Network\",\"updateWalletAccess\":\"Update Wallet Access\",\"addWalletToAccount\":\"Add Wallet to Account\",\"actionNeeded\":\"Action Needed In Wallet\",\"close\":\"Close\",\"tryAgain\":\"Try Again\",\"enterAmount\":\"Enter Amount\",\"instantRedemptionLimit\":\"Instant redemption limit reached. Please contact us.\",\"minimumAmount\":\"Minimum Amount is {amount} {symbol}\",\"insufficientBalance\":\"Insufficient {symbol} Balance\",\"approveUse\":\"Approve Use of {symbol}\",\"buy\":\"Buy {toSymbol} with {fromSymbol}\",\"redeem\":\"Redeem {fromSymbol} for {toSymbol}\",\"convert\":\"Convert {fromSymbol} to {toSymbol}\"},\"txStatus\":{\"followSteps\":\"Please follow the steps to complete the transaction\",\"approveUse\":\"Approve Use of {symbol}\",\"minimumAllowanceRequired\":\"Minimum allowance required:\",\"approved\":\"Approved\",\"current\":\"Current\",\"allowanceColon\":\"allowance:\",\"youSend\":\"You send:\",\"youSent\":\"You sent:\",\"youReceive\":\"You receive:\",\"youReceived\":\"You received:\",\"addTokenHelp\":\"If your wallet doesn't display your {symbol} balance, \u003clink\u003eclick here\u003c/link\u003e to add it manually.\"},\"metadata\":{\"unlimited\":\"Unlimited\",\"instantLimits\":\"Instant Limits\",\"minimumAmountLabel\":\"Minimum {type} Amount\",\"mint\":\"Mint\",\"redemption\":\"Redemption\",\"globalLimitRemaining\":\"Global Limit Remaining\",\"individualLimitRemaining\":\"Individual Limit Remaining\",\"availableLiquidity\":\"Available Liquidity\",\"limitExceeded\":\"To request an investment or redemption that exceeds your instant limit, please contact us at \u003cmail\u003e{email}\u003c/mail\u003e. The amount you can instantly redeem is dictated by several factors, including restrictions put in place by Circle.\"},\"errorFallback\":{\"message\":\"Something went wrong. Please try refreshing the page or try again shortly.\",\"buttonLabel\":\"Something went wrong\",\"balanceEmpty\":\"Balance: -\",\"max\":\"Max\"},\"gm\":{\"spend\":\"Spend\",\"receive\":\"Receive\",\"receiveAtLeast\":\"Receive at least\",\"buyAndSell\":\"Buy and Sell\",\"auto\":\"Auto\",\"tradeOn\":\"Trade {symbol}\",\"buy\":\"Buy {symbol}\",\"sell\":\"Sell {symbol}\",\"tradeOnHeading\":\"Where to trade {symbol}\",\"venuesDisclaimer\":\"Prices and fees on these venues vary, and may include spreads.\",\"buyLower\":\"buy\",\"sellLower\":\"sell\",\"button\":{\"actionNeeded\":\"Action Needed\",\"checkingWallet\":\"Checking wallet\",\"addingWallet\":\"Adding Wallet to Account...\",\"updatingWalletAccess\":\"Updating Wallet Access...\",\"marketClosed\":\"Market Closed\",\"marketPaused\":\"Market Paused\",\"assetPaused\":\"Asset Paused\",\"orderTooSmall\":\"Order size too small\",\"orderTooLarge\":\"Order size too large\",\"waitingForApproval\":\"Waiting for Approval\",\"waitingForConfirmation\":\"Waiting for Confirmation\",\"fillingOrder\":\"Filling Your Order\",\"waitingForQuote\":\"Waiting for Quote\",\"submitOrder\":\"Submit Order\"},\"metadata\":{\"youPaid\":\"You Paid\",\"youSold\":\"You Sold\",\"youReceived\":\"You Received\",\"orderDetails\":\"Order Details\",\"quote\":\"Quote\",\"quoteTooltipIllustrative\":\"This quote is for illustrative purposes only as this asset is not currently tradable. \",\"quoteTooltipDefault\":\"This quote generally represents the expected execution price for your order. The final execution price will depend on market conditions at the time the trade is processed.\",\"networkCost\":\"Network Cost\",\"networkCostTooltip\":\"Fees paid to the network to process your transaction. These are included in the quote. Ondo Finance does not receive any portion of these fees.\",\"maxSlippage\":\"Max Slippage\",\"maxSlippageTooltipL1\":\"Max Slippage is the maximum price movement allowed between when you submit your order and when it executes.\",\"maxSlippageTooltipL2\":\"This value is set automatically based on current market conditions to help your transaction complete smoothly, but may be adjusted manually. If prices move beyond this set allowance, the order will not execute.\",\"highAllowance\":\"High allowance\",\"custom\":\"Custom\",\"guaranteedMinimum\":\"Guaranteed Minimum\",\"guaranteedMinimumTooltip\":\"The minimum amount you agreed to receive when you submitted this order.\",\"guaranteedMinimumCallout\":\"You received {pct}% more than your guaranteed minimum.\",\"receiveAtLeastTooltip\":\"The minimum amount you will receive if the order executes. The final amount may be higher depending on market conditions.\"},\"transactions\":{\"error\":\"Error\",\"fillOrder\":\"Fill Order\",\"orderExpired\":\"Order expired\",\"buyOrder\":\"Buy ≈{toAmount} {toSymbol} with {fromAmount} {fromSymbol}\",\"sellOrder\":\"Sell {fromAmount} {fromSymbol} for ≈{toAmount} {toSymbol}\",\"bought\":\"Bought {prefix}{toAmount} {toSymbol} with {fromAmount} {fromSymbol}\",\"sold\":\"Sold {fromAmount} {fromSymbol} for {prefix}{toAmount} {toSymbol}\",\"orderExpiresIn\":\"Order expires in {label}\",\"orderExpiry\":\"Order Expiry: {label}\",\"expiryDefault\":\"3 minutes\"},\"orderInfo\":{\"approvalFailed\":\"Approval failed. Please try again.\",\"orderSubmissionFailed\":\"Order submission failed. Please try again.\",\"takingLonger\":\"This is taking longer than usual. Try checking your wallet for an update on your transaction status.\",\"multisig\":\"We detected that you may be using a multisig wallet, which is not yet fully supported. Please note that you may need to refresh this page between transactions in order to submit your order.\",\"expiredNoFunds\":\"Your {action} order of ≈{amount} {symbol} could not be processed. No funds were withdrawn. Please try again shortly.\",\"lowOrderAmount\":\"Your order amount is low compared to network cost. Consider increasing the order size in order to improve your price and execution probability.\",\"orderSubmitted\":\"Your order has been submitted and will remain open for 3 minutes. Stay on this page to monitor your order's progress.\",\"orderFilledTitle\":\"Order Filled\",\"orderFilled\":\"Your {action} order of {gmAmount} {gmSymbol} was filled for a total value of {quoteAmount} {quoteSymbol} (${usd}).\",\"orderExpiredTitle\":\"Order Expired\",\"ok\":\"OK\"},\"disclaimer\":{\"attestation\":\"By submitting an order, you acknowledge that you have reviewed the offering documentation available under \\\"Legal Documents\\\" below and agree that your purchase is subject to the applicable terms and disclosures.\",\"securities\":\"Ondo Stocks have not been registered under the US Securities Act of 1933, as amended, or the securities or other laws of any other jurisdiction, and may not be offered or sold in the US or to US persons unless registered under the Act or exempt therefrom. The tokens are offered and sold in the EEA and UK solely to qualified investors, and in Switzerland solely to professional clients. Other prohibitions and restrictions apply. See additional information below.*\"}},\"root\":{\"selectAsset\":\"Select Asset\",\"balance\":\"Balance: {amount}\",\"balanceError\":\"Balance: -.--\",\"loadingBalance\":\"Loading balance\",\"needHelp\":\"Need help?\",\"reachOut\":\"Reach out to \u003cmail\u003e{email}\u003c/mail\u003e or \u003cdocs\u003eview our docs\u003c/docs\u003e.\",\"disclaimers\":{\"notApplied\":\"It looks like you haven't applied for {productName} yet. Start your application to access {productName}.\",\"multisig\":\"Looks like you are using a multisig wallet. You will need to sign and execute the proposed transaction there. You may need to refresh this page to view your allowance and balance changes.\",\"walletNotApprovedSignUp\":\"Your connected wallet isn't approved for {productName}. \u003clink\u003eSwitch to an approved wallet\u003c/link\u003e or sign up to get started.\",\"walletNotApprovedSwitch\":\"Your connected wallet isn't approved for {productName}. Please \u003clink\u003eswitch to an approved wallet\u003c/link\u003e.\"},\"altMintRedeem\":{\"otherNetworksTitle\":\"Looking to mint and redeem on other networks?\",\"otherNetworksBody\":\"To mint and redeem {productName} on {otherNetworks}, please contact \u003cmail\u003e{email}\u003c/mail\u003e\",\"altOptionsTitle\":\"Alternative mint and redeem options\",\"contactToGetStarted\":\"Please contact \u003cmail\u003e{email}\u003c/mail\u003e to get started.\",\"altRedeemTitle\":\"Alternative redemption option\"},\"ousgAltMethods\":\"We also support bank wire or onchain exchange transfers (including USDC, PYUSD, and RLUSD) to mint OUSG, and USDC and RLUSD to redeem OUSG.\",\"usdyAltRedeem\":\"To redeem USDY via Ondo USDY LLC, please contact\"},\"attestationError\":{\"title\":\"Something went wrong\",\"message\":\"We encountered an issue while creating your attestation. Please try again later or contact support if the problem persists.\"},\"usdyDisabledTitle\":\"Important Notice\",\"usdyDisabledBody\":\"Onboarding to and purchases of USDY via the Ondo Finance App are temporarily disabled as we implement contract upgrades. Existing holders may continue to sell USDY during this time. For any questions, please reach out to our support team at \u003cmail\u003e{email}\u003c/mail\u003e.\",\"attestation\":{\"acknowledgePrompt\":\"Please acknowledge that you've reviewed the documents.\",\"cancel\":\"Cancel\",\"continue\":\"Continue\",\"usdyBanner\":\"USDY is now issued by Ondo Stocks. Please review and sign the documents to proceed.\",\"documentsError\":\"We have trouble loading the documents.\"},\"usdyLimited\":{\"logIn\":\"Log In\",\"unavailable\":\"Temporarily Unavailable\",\"sell\":\"Sell USDY\"}},\"convert\":{\"pageTitle\":\"Ondo Converter\",\"about\":{\"heading\":\"About\",\"description\":\"Most Ondo tokens are yield-bearing. This yield can be paid out either in a distributing form or in an accumulating form.\\n\\nFor distributing tokens, the yield accrues daily via additional tokens distributed to your wallet. The redemption value per token stays stable at $1, and the amount of tokens in your wallet increases.\\n\\nFor accumulating tokens, the yield accrues daily via an increasing redemption value per token. The quantity of tokens in your wallet remains the same, but the redemption value per token has increased.\\n\\nYou can convert anytime between these two forms with no slippage.\",\"readMore\":\"Read More\"},\"section\":{\"convert\":\"Convert\",\"history\":\"History\"},\"addressTable\":{\"contracts\":\"Contracts\",\"nameOn\":\"{token} on {network}\"},\"button\":{\"connectWallet\":\"Connect Wallet\",\"switchNetwork\":\"Switch Network\",\"enterAmount\":\"Enter amount\",\"insufficientBalance\":\"Insufficient {symbol} balance\",\"acceptTerms\":\"Accept terms\",\"approveUse\":\"Approve use of {symbol}\",\"convert\":\"Convert\"},\"terms\":\"I have read and agree to the \u003clink\u003eTerms and Conditions\u003c/link\u003e.\",\"history\":{\"connectWallet\":\"Connect Wallet\",\"connectWalletDesc\":\"Connect your wallet to see your history\",\"empty\":\"No transfers yet\",\"emptyDesc\":\"Once you Convert tokens, your transaction history will appear here\",\"showMore\":\"Show More\",\"for\":\"for\"},\"details\":{\"conversionOf\":\"Conversion of {sourceSymbol} to {destSymbol}\",\"from\":\"From\",\"to\":\"To\",\"value\":\"Value\",\"status\":\"Status\",\"chain\":\"Chain\",\"trans