"9903\",\"static/chunks/9903-bab16d840ffd1508.js\",\"906\",\"static/chunks/906-1c55ca4ef3c4af35.js\",\"7784\",\"static/chunks/7784-57fef3962f64656a.js\",\"974\",\"static/chunks/974-346163f45013f278.js\",\"8631\",\"static/chunks/8631-5b1a2487bffce945.js\",\"4167\",\"static/chunks/4167-e7d24194e2f7e387.js\",\"799\",\"static/chunks/799-6c9dcda57106fe92.js\",\"5990\",\"static/chunks/5990-4475b4959365593d.js\",\"1379\",\"static/chunks/1379-9578b6a435f75a12.js\",\"1634\",\"static/chunks/1634-7661eeb752b5574c.js\",\"7177\",\"static/chunks/app/layout-392d6a2ba6d62977.js\"],\"ReactiveIntlProvider\"]\n"])</script><script>self.__next_f.push([1,"4:[\"$\",\"$L10\",null,{\"children\":[\"$\",\"$L11\",null,{\"defaultView\":\"table\",\"children\":[\"$\",\"$L12\",null,{\"marketStatus\":{\"timestamp\":\"2026-09-20T02:25:40Z\",\"isOpen\":false,\"marketStatus\":\"closed\",\"nextOpenSession\":\"overnight\",\"nextOpen\":\"2026-09-21T00:05:00Z\",\"nextClose\":\"2026-09-21T07:55:00Z\",\"reason\":{\"code\":\"MARKET_CLOSED\",\"message\":\"Weekend or Holiday\",\"documentation\":\"https://docs.ondo.finance/api-reference/error-codes#market_closed\"},\"offhours\":{\"isOpen\":true,\"nextOpen\":\"2026-09-26T00:05:00Z\",\"nextClose\":\"2026-09-20T23:55:00Z\"}},\"banners\":[{\"backgroundColor\":\"green\",\"body\":\"Always-on minting and burning means you can trade with deep liquidity anytime.\",\"ctaLabel\":\"Trade Now\",\"ctaLink\":\"/?sort=most-popular\u0026view=grid\u0026tagFilters=24-7-available\",\"desktopImageHeight\":424,\"desktopImageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/2f43f6baa3eb9ac983d84fafe969315e7e2d6407-424x424.svg\",\"desktopImageWidth\":424,\"headline\":\"Buy and Sell Tokenized Stocks 24/7\",\"mobileImageHeight\":430,\"mobileImageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/3d143a4472bbe6f8f339365ac7c1545a15da9f75-430x430.svg\",\"mobileImageWidth\":430}],\"isOndoPortfoliosEnabled\":\"$undefined\",\"hadWalletSession\":false,\"comingSoonPortfolios\":[]}]}]}]\n"])</script><script>self.__next_f.push([1,"2:[\"$\",\"html\",null,{\"lang\":\"en\",\"style\":{\"scrollBehavior\":\"smooth\"},\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"WebApplication\\\",\\\"@id\\\":\\\"https://app.ondo.finance/#webapp\\\",\\\"name\\\":\\\"Ondo\\\",\\\"url\\\":\\\"https://app.ondo.finance\\\",\\\"applicationCategory\\\":\\\"FinanceApplication\\\",\\\"operatingSystem\\\":\\\"Web browser\\\",\\\"description\\\":\\\"Ondo is the platform for qualified users to buy and sell tokenized stocks, ETFs, and Treasuries onchain.\\\",\\\"publisher\\\":{\\\"@id\\\":\\\"https://ondo.finance/#organization\\\"}}]}\"}}]}],[\"$\",\"body\",null,{\"className\":\"__variable_adca9f __variable_1c2bf7 __variable_d8459a __variable_ab8fce\",\"children\":[\"$\",\"$c\",null,{\"children\":[\"$\",\"$L13\",null,{\"initialLocale\":\"en\",\"initialMessages\":{\"privateClient\":{\"page\":{\"title\":\"Ondo\\nPrivate Client\",\"memberSince\":\"Member since {date}\",\"unavailableTitle\":\"Private Client is not available\",\"unavailableBody\":\"Please return home and continue exploring Ondo.\",\"errorState\":{\"title\":\"Private Client is temporarily unavailable\",\"body\":\"We couldn’t load your membership details. Please try again.\",\"retry\":\"Retry\",\"retrying\":\"Retrying…\"}},\"landing\":{\"hero\":{\"title\":\"Ondo\\nPrivate Client\",\"body\":\"Ondo Private Client is for Ondo Stocks' largest holders and most active traders, with priority support, early product access, and exclusive invitations.\",\"cta\":\"View Benefits\"},\"benefits\":{\"sectionTitle\":\"Benefits of Private Clients\"},\"overview\":{\"sectionTitle\":\"Program Overview\"},\"banner\":{\"heading\":\"Access a Higher Standard\",\"subheading\":\"Join Private Client\",\"cta\":\"Start Trading\"}},\"accountOverview\":{\"memberLabel\":\"{tier} Member\",\"assetsHeld\":\"Assets Held\",\"totalVolume\":\"Total Volume\",\"metricAriaLabel\":\"{metric}: {value}\",\"levelUpTitle\":\"Level Up\",\"levelUpDescription\":\"Acquire more assets or grow your total volume to reach {nextTier} status.\",\"assetsNeeded\":\"Assets Needed\",\"volumeNeeded\":\"Total Volume Needed\",\"or\":\"or\"},\"dashboardBenefits\":{\"sectionTitle\":\"Benefits of Private Clients\",\"items\":{\"personalizedSupport\":{\"title\":\"Personalized Support\",\"description\":\"A dedicated relationship manager available around the clock.\"},\"memberGifts\":{\"title\":\"Member Gifts\",\"description\":\"Receive limited-edition Ondo merchandise curated exclusively for members.\"},\"earlyAccess\":{\"title\":\"Early Access to New Features\",\"description\":\"Receive product updates and early access to new offerings.\"},\"privateEvents\":{\"title\":\"Private Events\",\"description\":\"Get invited to private Ondo events and connect with leaders from across the industry.\"},\"shapeWhatsNext\":{\"title\":\"Shape What's Next\",\"description\":\"Share feedback directly with Ondo product teams to help inform future products and experiences.\"},\"reducedFees\":{\"title\":\"Reduced Fees\",\"comingSoon\":\"Coming soon...\"}}},\"tierComparison\":{\"sectionTitle\":\"Program Overview\",\"volumeRequirements\":\"Volume Requirements\",\"fulfillPrompt\":\"Fulfill either of the following to reach {nextTier}:\",\"assetsHeld\":\"Assets Held*\",\"spotVolume\":\"Spot Volume*\",\"orLabel\":\"or\",\"assetsHeldTooltip\":\"Metrics are calculated over a 90-day rolling period and updated hourly. Data includes activity on Ethereum and BNB Chain, and is subject to change.\",\"spotVolumeTooltip\":\"Metrics are calculated over a 30-day rolling period and updated hourly. Data includes activity on Ethereum and BNB Chain, and is subject to change.\",\"disclaimer\":\"*The Private Client program is offered solely by the Ondo Foundation, a Cayman Islands foundation company. Benefits have no monetary value, are not exchangeable, and may be limited in certain jurisdictions. The program is available only to persons who are eligible to acquire and hold the qualifying Ondo products under the applicable jurisdiction-based prohibitions, restrictions, and other \u003clink\u003eeligibility criteria\u003c/link\u003e; Prohibited Persons, including U.S. persons, are not eligible to participate. The Ondo Foundation may amend, suspend, or terminate the program, its terms, or any person's eligibility or tier status at any time in its sole discretion. Void where prohibited.\",\"docsCta\":\"View Full Program Details\"},\"programOverview\":{\"included\":\"Included\",\"notIncluded\":\"Not included\",\"rows\":{\"personalizedSupport\":\"Personalized Support\",\"earlyAccess\":\"Early Access to New Features\",\"invitationToSelectEvents\":\"Invitation to Select Events\",\"memberGifts\":\"Member Gifts\",\"hostedExperiences\":\"Hosted Experiences\",\"shapeWhatsNext\":\"Shape What's Next\",\"signatureEvents\":\"Signature Events and Experiences\"}},\"concierge\":{\"yourPrivateClientTeam\":\"Your Private Client Team\",\"setUpChannelHeading\":\"Set Up a Private Support Channel\",\"setUpPrivateChannel\":\"Set Up Private Channel\",\"getStarted\":\"Get Started\",\"telegram\":\"Telegram\",\"telegramQrCodeTitle\":\"QR code: scan to join your private Telegram channel\",\"email\":\"Email\",\"telegramChannelActive\":\"Your channel is set up\",\"verifyWalletAccess\":\"Verify wallet access\",\"verifying\":\"Verifying…\",\"reverifyErrorMessage\":\"We couldn't verify your wallet. Please try again.\",\"team\":{\"directorStrategicOps\":\"Director of Strategic Operations\",\"apacDirector\":\"APAC Director\"},\"copyAria\":\"Copy {label}\",\"copiedLabel\":\"Copied!\"},\"faq\":{\"sectionTitle\":\"FAQ\",\"items\":{\"program\":{\"question\":\"What is the Ondo Private Client Program?\",\"answer\":\"The Ondo Private Client Program is a loyalty program offered by the Ondo Foundation to our ecosystem's greatest supporters. Private Clients are entitled to personalized support channels, gifts, early access to new features, and events. Private Client tiers are separated by account activity levels, which the program tracks directly from your qualifying wallet.\"},\"eligibility\":{\"question\":\"Who is eligible?\",\"answer\":\"Eligible non-U.S. wallets may qualify for Private Client status by meeting either an assets-held threshold or a cumulative spot trading-volume threshold. For Platinum status, users must hold at least $1M in qualifying assets, such as Ondo Stocks and USDY, or reach at least $1M in rolling 30-day spot trading volume. Diamond and Obsidian unlock at higher qualifying thresholds.\"},\"qualification\":{\"question\":\"How do I check if I qualify?\",\"answer\":\"Connect your wallet directly at {privateClientUrl}. If you qualify, your tier and benefits display immediately.\"},\"cost\":{\"question\":\"Is there a cost to join?\",\"answer\":\"No. Private Client status is earned through onchain activity. It cannot be purchased and doesn’t require an application.\"},\"notQualified\":{\"question\":\"What if I don't qualify yet?\",\"answer\":\"Keep building your position on Ondo Stocks. Status as an Ondo Private Client unlocks automatically the moment eligible users cross the qualifying threshold.\"},\"tierCalculation\":{\"question\":\"How is my Private Client tier calculated?\",\"answer\":\"Private Client tier status is earned through qualifying onchain holdings and/or spot trading activity. Qualifying assets may include Ondo Stocks, USDY, and other eligible Ondo products. For further details on eligibility and thresholds to qualify for each tier, see our \u003clink\u003eDocs page\u003c/link\u003e.\"},\"nextTier\":{\"question\":\"How do I move to the next tier?\",\"answer\":\"The Level Up module on your Private Client dashboard shows the additional qualifying holdings or trading volume needed to reach the next tier. Once you hit the threshold, your Private Client status updates automatically.\"},\"benefits\":{\"question\":\"How do I use my Private Client benefits?\",\"answer\":\"Some benefits are available automatically, while others may require coordination with your Private Client team. For questions about events, gifts, hosted experiences, or support, contact your team via Telegram \u003clink\u003ehere\u003c/link\u003e, or send an email to \u003cemail\u003e\u003c/email\u003e.\"},\"team\":{\"question\":\"How do I reach my Private Client team?\",\"answer\":\"Contact your Private Client team directly via Telegram \u003clink\u003ehere\u003c/link\u003e, or send an email to \u003cemail\u003e\u003c/email\u003e.\"},\"security\":{\"question\":\"How do I know an offer is really from Ondo?\",\"answer\":\"We will never ask you to click a link in a direct message to claim status. Always navigate directly to {privateClientUrl} and connect your wallet there to verify.\"}}},\"tierChipAriaLabel\":\"{name} tier\",\"tier\":{\"platinum\":{\"name\":\"Platinum\",\"thresholds\":{\"assetsRange\":\"$$1M - $5M\",\"volumeRange\":\"$$1M - $10M\"}},\"diamond\":{\"name\":\"Diamond\",\"thresholds\":{\"assetsRange\":\"$$5M - $15M\",\"volumeRange\":\"$$10M - $25M\"}},\"obsidian\":{\"name\":\"Obsidian\",\"thresholds\":{\"assetsRange\":\"$$15M+\",\"volumeRange\":\"$$25M+\"}}},\"welcomeFlow\":{\"temporarilyUnavailableMessage\":\"This service is temporarily unavailable. Please try again.\",\"step1Title\":\"Welcome to Ondo\\nPrivate Client\",\"step1Body\":\"Based on your trading patterns, you’ve unlocked priority support, early product access, and exclusive invitations.\",\"getStartedLabel\":\"Get Started\",\"step3aTitle\":\"Set Up Personalized Support\",\"step3aTelegramBody\":\"Let's set you up with a private Telegram channel with our Ondo Private Client team.\",\"step3aTelegramInputLabel\":\"Enter your Telegram ID:\",\"step3aTelegramPlaceholder\":\"satoshinakamoto\",\"step3aEmailBody\":\"You can also reach your Ondo Private Client support team via email:\",\"step3aEmailPlaceholder\":\"Enter Email Address\",\"verifyTitle\":\"Verify Ownership\",\"verifyBody1\":\"To protect your account, we need to verify you are the owner of this wallet. \",\"verifyBody2\":\"Sign the message to complete verification. This step is only to confirm your identity – no funds will be moved and no transaction will be made.\",\"verifyDisclaimer\":\"Ensure the URL is {host}.\",\"loadingTextTelegram\":\"Creating Private Channel\",\"loadingTextEmail\":\"Preparing Your Private Client Access\",\"channelCreatedTitle\":\"Private Channel Created\",\"channelCreatedScanPrompt\":\"Scan the QR code to join your private Telegram channel\",\"channelPendingBody\":\"Your private channel is being set up. We'll send your invite link to you shortly.\",\"channelInviteUnavailableBody\":\"Your private channel already exists, but we couldn't retrieve its invite link right now. Try again or open the channel in Telegram if you've already joined it.\",\"channelCreatedDescription\":\"Use this dedicated support channel to speak to the Ondo Private Client team and receive timely market updates.\",\"setupCompleteTitle\":\"Set Up Complete\",\"setupCompleteBody\":\"You're all set! Start exploring Ondo Private Client benefits.\",\"continueLabel\":\"Continue\",\"submitLabel\":\"Submit\",\"backLabel\":\"Back\",\"skipLabel\":\"Skip\",\"verifyLabel\":\"Verify\",\"confirmInWalletLabel\":\"Confirm in your wallet\",\"verifyingLabel\":\"Verifying\",\"finishLabel\":\"Finish\",\"goToPrivateClientLabel\":\"Go to Private Client\",\"joinTelegramLabel\":\"Join Telegram Channel\",\"retryInviteLinkLabel\":\"Retry Invite Link\",\"telegramIdAriaLabel\":\"Telegram ID\",\"emailAriaLabel\":\"Email address\",\"closeAriaLabel\":\"Close\",\"unavailableTitle\":\"Private Channels Temporarily Unavailable\",\"unavailableBody\":\"Telegram channels are at capacity right now. Your Private Client team is still here for you — reach out via email and we'll get you set up.\",\"unavailableEmailPrompt\":\"Enter your email so we can follow up:\",\"contactPrivateClientTeamLabel\":\"Contact Private Client Team\",\"verifyErrorMessage\":\"We couldn't verify your wallet. Please try again — if the problem persists, contact support.\",\"attestationLabel\":\"To access Ondo Private Client, please confirm that you are not a U.S. person, are not located in a restricted jurisdiction, and that you agree to the\",\"attestationTosLink\":\"Terms of Service\",\"attestationErrorMessage\":\"An unexpected error occurred. Please try again.\"},\"validation\":{\"tgRequired\":\"Please enter your Telegram username\",\"tgTooShort\":\"Username must be at least 5 characters\",\"tgTooLong\":\"Username must be 32 characters or fewer\",\"tgInvalidChars\":\"Username must start with a letter and contain only letters, numbers, and underscores\",\"emailRequired\":\"Please enter your email address\",\"emailInvalid\":\"Please enter a valid email address\"}},\"common\":{\"button\":{\"close\":\"Close\",\"cancel\":\"Cancel\",\"continue\":\"Continue\",\"proceed\":\"Proceed\",\"dismiss\":\"Dismiss\"},\"onboardingActionRequired\":{\"title\":\"Action Needed to Complete Onboarding\",\"body1\":\"We need extra documents specific to your profile before you are approved to purchase Ondo Stocks.\",\"body2\":\"Please email our support team and we will assist you in completing your application.\"},\"resetConfirmation\":{\"title\":\"Return to Previous Page?\",\"body\":\"Going back will reset this order and clear your current selections. You will need to re-enter your order details again.\"},\"redirectConfirmation\":{\"title\":\"You Are About to Exit the Ondo Site\",\"body\":\"By clicking \\\"Proceed\\\", you acknowledge that you are leaving Ondo's websites and applications (including ondo.finance, Ondo's web and mobile applications, and any associated sites operated by Ondo or its affiliates). You will be redirected to a third-party website owned and operated independently of Ondo (a \\\"Third-Party Website\\\"). Your use of any Third-Party Website is entirely at your own risk and subject to that website's terms and policies. Ondo does not control, endorse, recommend, or approve of any content or services provided by any Third-Party Website, and makes no warranties or representations regarding them. Ondo is not responsible for, and expressly disclaims liability for, any loss or damage arising from your use of a Third-Party Website.\"},\"googleTranslate\":{\"title\":\"Google Chrome Translation\",\"body\":\"It looks like you are using a translation service to view this page. Due to known issues with browser translation services such as Google Translate, you may experience errors while using this application. You may choose to disable Google Translate for an uninterrupted experience or use a different browser.\"},\"restrictedAccess\":{\"suspectTitle\":\"Your wallet is associated with suspicious activities\",\"suspectBody\":\"You cannot use this app with this wallet. If you think this is a mistake, please contact {email}.\",\"unavailableTitle\":\"Unable to determine wallet eligibility.\",\"unavailableBody\":\"Please try again later. If you are unable to proceed after some time please contact {email}.\"},\"requestProductAccess\":{\"title\":\"Request {product} Access\",\"eligibility\":\"To be eligible to purchase {product}, you (an entity or an individual) must meet the following criteria:\",\"emailPrompt\":\"To request access, please email our support team and we will assist you.\"},\"authenticating\":\"Authenticating\",\"loading\":\"Loading\"},\"header\":{\"nav\":{\"tools\":\"Tools\",\"resources\":\"Resources\",\"explore\":{\"label\":\"Explore\",\"subLabel\":\"Discover tokenized stocks, ETFs, and other on-chain assets\"},\"portfolio\":{\"label\":\"Portfolio\",\"subLabel\":\"Track your tokenized holdings\"},\"invest\":{\"label\":\"Invest\",\"subLabel\":\"Invest in Ondo US Dollar Yield\"},\"overview\":{\"label\":\"Overview\",\"subLabel\":\"View your OUSG portfolio\"},\"bridge\":{\"label\":\"Bridge\",\"subLabel\":\"Transfer Ondo tokens across chains\"},\"convert\":{\"label\":\"Convert\",\"subLabel\":\"Convert Ondo tokens between different forms\"},\"faq\":{\"label\":\"FAQ\",\"subLabel\":\"Quick answers to common questions\"},\"docs\":{\"label\":\"Documentation\",\"subLabel\":\"In-depth technical and integration guides\"},\"ondoLearn\":{\"label\":\"Ondo Learn\",\"subLabel\":\"Learn about tokenization and blockchain technology.\"},\"privateClient\":{\"label\":\"Private Client\",\"subLabel\":\"Access exclusive opportunities with dedicated support.\"}},\"auth\":{\"signUpLogIn\":\"Sign Up / Log In\"},\"walletMenu\":{\"openMenu\":\"Open wallet menu\",\"connect\":\"Connect Wallet\",\"copyAddress\":\"Copy Address\",\"copied\":\"Copied!\",\"viewOnExplorer\":\"View on Explorer\",\"disconnect\":\"Disconnect Wallet\",\"unknownWallet\":\"Unknown Wallet\",\"unrecognizedChain\":\"Unrecognized Chain\",\"updateAccess\":\"Update Wallet Access\",\"addToAccount\":\"Add Wallet to Account\",\"verificationPending\":\"Verification Pending\",\"tooltip\":{\"whitelist\":\"This wallet is connected but needs additional verification for {products}. Tap to update wallet access.\",\"add\":\"This wallet is not linked to your account for {products}. Tap to add it.\"},\"privateClientChip\":\"Private Client\"},\"search\":{\"assets\":\"Search assets\",\"byNameOrTicker\":\"Search asset name or ticker\",\"title\":\"Search\",\"errorLine1\":\"Something is wrong.\",\"errorLine2\":\"Please try again later.\",\"trending\":\"Trending\",\"noResults\":\"No results found\"},\"onboardingCta\":{\"actionNeeded\":\"Action Needed\",\"underReview\":\"Under Review\",\"applicationUnderReview\":\"Application Under Review\",\"complete\":\"Complete Onboarding\",\"additionalInfoNeeded\":\"Additional Info Needed\"},\"additionalInfoToast\":{\"title\":\"Additional Information Needed\",\"message\":\"Our team requires more information from you. Please check your email for details.\"},\"additionalInfoNeededModal\":{\"title\":\"Additional Information Needed\",\"message\":\"Your application has been reviewed. Our team requires more information from you. Please check your email to follow up.\",\"support\":\"For any questions or support, you can reach our team at \u003csupport\u003esupport@ondo.finance\u003c/support\u003e.\",\"cancel\":\"Cancel\",\"ok\":\"OK\",\"close\":\"Close\"},\"underReviewModal\":{\"title\":\"Needs Further Review\",\"message\":\"Our team needs more time to review your application. We'll notify you by email as soon as there's an update.\",\"support\":\"For any questions or support, you can reach our team at \u003csupport\u003esupport@ondo.finance\u003c/support\u003e.\",\"cancel\":\"Cancel\",\"ok\":\"OK\",\"close\":\"Close\"},\"networkSelect\":{\"network\":\"Network\",\"unrecognizedChain\":\"Unrecognized Chain\"}},\"footer\":{\"legal\":{\"termsOfService\":\"Terms of Service\",\"privacyPolicy\":\"Privacy Policy\"},\"selectLanguage\":\"Select language\"},\"notFound\":{\"line1\":\"The page you are looking for does not exist.\",\"line2\":\"Try a different page or check your browser URL.\",\"backToHome\":\"Back to Home\"},\"geofence\":{\"notice\":{\"accessRestricted\":\"Access Restricted\",\"notAvailable\":\"The content you are trying to access is not accessible in your jurisdiction.\",\"viewEligibility\":\"View Eligibility Restrictions\",\"backToHome\":\"Back to Home\"},\"banner\":{\"ousg\":{\"title\":\"US Users: OUSG is available in your region\",\"description\":\"Built for institutional investors, OUSG offers exposure to short-term US Treasuries with 24/7 instant mints and redemptions.\",\"linkText\":\"View Details\"}},\"disclaimer\":{\"usdy\":\"USDY tokens are not registered under the Securities Act of 1933, as amended (the \\\"Act\\\"). USDY tokens are not offered or sold in the US, to US persons (as defined in Rule 902(k) of the Act), or for the account or benefit of US persons, or in or to persons in other restricted jurisdictions.\",\"globalMarkets\":\"Ondo Stocks are not registered under the Securities Act of 1933, as amended (the \\\"Act\\\"). Ondo Stocks are not offered or sold in the US, to US persons (as defined in Rule 902(k) of the Act), or for the account or benefit of US persons, or in or to persons in other restricted jurisdictions.\"}},\"welcomeModal\":{\"title\":\"Welcome to Ondo\",\"description\":\"Gain global access to tokenized assets at any time. To mint and redeem assets, complete the onboarding process, which takes approximately 10 minutes.\",\"skip\":\"Skip for Now\",\"startOnboarding\":\"Start Onboarding\"},\"signin\":{\"title\":\"Sign up or Sign in\",\"checkEmailTitle\":\"Check Your Email\",\"subtitle\":\"Enter your email to sign in to your account. If you don't have an account yet, one will be created for you.\",\"emailSentBody\":\"We sent an email to {email} with instructions on how to sign in to your account.\",\"magicLink\":\"The magic link is in your email.\",\"linkExpires\":\"The link expires in 2 minutes.\",\"dontShare\":\"Don't share this link. It's only meant for you.\",\"didntReceive\":\"Didn't receive this link?\",\"tryAgain\":\"Try again.\",\"emailLabel\":\"Email Address\",\"emailError\":\"Please enter a valid email address\",\"continue\":\"Continue\",\"checkInbox\":\"Check your inbox\",\"or\":\"Or\",\"continueWithGoogle\":\"Continue with Google\",\"agreement\":\"By continuing you agree to Ondo's \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e and \u003cterms\u003eTerms of Service\u003c/terms\u003e.\",\"help\":\"Forgot your email or need help? Get assistance via\"},\"onboarding\":{\"autoDecision\":{\"reviewing\":{\"title\":\"Reviewing\",\"message\":\"We're reviewing your application. This usually takes just a few moments.\"},\"reviewTakingLonger\":{\"title\":\"Taking longer than expected\",\"message\":\"You can safely leave this page and continue exploring Ondo. We'll notify you here and by email as soon as there's an update.\",\"exploreCta\":\"Explore Assets\",\"portfolioCta\":\"View Portfolio\"},\"furtherReview\":{\"title\":\"Needs Further Review\",\"message\":\"Our team needs more time to review your application. We'll notify you by email as soon as there's an update.\",\"exploreCta\":\"Explore Assets\",\"portfolioCta\":\"View Portfolio\"},\"toasts\":{\"reviewingTitle\":\"Reviewing Application\",\"reviewingMessage\":\"We're reviewing your application. This usually takes just a few moments.\",\"underReviewTitle\":\"Needs Further Review\",\"underReviewMessage\":\"Your application is still under review. We'll email you as soon as there's an update.\"},\"approved\":{\"connectWalletCta\":\"Connect Wallet\",\"switchNetworkCta\":\"Switch Network\",\"addWalletCta\":\"Add Wallet To Account\",\"steps\":{\"connectWallet\":{\"title\":\"Connect Wallet\",\"description\":\"Connect your wallet to Ondo on Ethereum or BSC.\",\"descriptionOusg\":\"Connect your wallet to Ondo on Ethereum.\"},\"addWallet\":{\"title\":\"Add Wallet to Account\",\"description\":\"Link your wallet to your account to start investing.\"}},\"gm\":{\"title\":\"You're Approved for Ondo Stocks\",\"message\":\"Congratulations! You can now buy and sell tokenized stocks and ETFs on Ondo Stocks, 24/7, with holdings settled on-chain and always in your control.\",\"finalStep\":{\"title\":\"Buy Tokenized Stocks\",\"description\":\"Invest in tokenized stocks and ETFs directly from your wallet.\"},\"finalCta\":\"Buy Tokenized Stocks\"},\"ousg\":{\"title\":\"You're Approved for OUSG\",\"message\":\"Congratulations! You can now invest in Ondo Short-Term U.S. Government Treasuries Fund (OUSG).\",\"finalStep\":{\"title\":\"Invest in OUSG\",\"description\":\"Purchase OUSG directly from your connected wallet.\"},\"finalCta\":\"Invest in OUSG\"},\"both\":{\"title\":\"You're Approved for Ondo Stocks \u0026 OUSG\",\"message\":\"Congratulations! You can now buy and sell tokenized stocks, ETFs, and OUSG.\",\"finalStep\":{\"title\":\"Start Investing\",\"description\":\"Invest in tokenized stocks, ETFs, and OUSG from your wallet.\"},\"finalCta\":\"Start Investing\"}}},\"steps\":{\"BASIC_INFORMATION\":\"Welcome\",\"INVESTOR_PROFILE\":\"Investor Profile\",\"QUALIFIED_PRODUCTS\":\"Qualified Products\",\"IDENTITY_VERIFICATION\":\"Identity Verification\"},\"chrome\":{\"title\":\"Ondo Finance Onboarding\",\"supportEmail\":\"For questions, email\",\"reset\":\"Reset\",\"exit\":\"Exit\"},\"error\":{\"loadFailed\":\"We're having trouble loading the form. Please refresh the page and try again.\",\"refresh\":\"Refresh Page\"},\"applicationSubmitted\":{\"title\":\"Application Submitted\",\"messageEntity\":\"Thank you for submitting your onboarding application. You can check your onboarding status in your account.\",\"messageIndividual\":\"Thanks for submitting your onboarding application! Due to overwhelming demand, it may take longer than expected for your application to be reviewed. You will be notified of your application acceptance via email and you can check your onboarding status in your account at any time.\",\"viewAccount\":\"View My Account\",\"exploreAssets\":\"Explore Assets\"},\"basicInformation\":{\"title\":\"Basic Information\",\"welcomeTitle\":\"Welcome to Ondo\",\"welcomeSubtitle\":\"Gain global access to tokenized assets at any time. By law, we need to collect specific information to provide our products and services.\",\"subtitle\":\"By law, we need to collect specific information to provide our products and services.\",\"investorType\":\"Investor Type\",\"individual\":\"I am an individual investor\",\"business\":\"I represent a business\",\"legalFirstName\":\"Legal First Name\",\"legalLastName\":\"Legal Last Name\",\"email\":\"Email\",\"residence\":\"Location of Residence\",\"residenceTooltip\":\"The country (and, if applicable, state or province) where you are legally domiciled and tax-resident, as shown on your official proof of address.\",\"principalPlace\":\"Principal Place of Business\",\"principalPlaceTooltip\":\"The main location where your business operates and conducts its day-to-day activities. This is typically where management and key operations take place.\",\"incorporation\":\"Country of Incorporation\",\"incorporationTooltip\":\"The country where your company is legally registered and incorporated. This is the jurisdiction that issued your company's formation documents.\",\"businessName\":\"Business Name\",\"investmentAmount\":\"Investment Amount\",\"selectCountry\":\"Select a country\",\"continue\":\"Continue\",\"errorToastTitle\":\"Your inputs aren't saved.\",\"errorToastMessage\":\"Try again later. If the issue continues, contact {email}.\",\"validation\":{\"investorTypeRequired\":\"Please select an investor type\",\"legalFirstNameRequired\":\"Legal first name is required\",\"legalLastNameRequired\":\"Legal last name is required\",\"emailRequired\":\"Email is required\",\"emailInvalid\":\"Please enter a valid email address\",\"residenceRequired\":\"Location of residence is required\",\"businessNameRequired\":\"Business name is required\",\"investmentAmountRequired\":\"Investment amount is required\",\"incorporationRequired\":\"Country of incorporation is required\",\"principalPlaceRequired\":\"Principal place of business is required\"}},\"qualifiedProducts\":{\"title\":\"Qualified Products\",\"subtitleQualified\":\"Based on your information, here are the products you qualify for.\",\"subtitleNotQualified\":\"Based on your information, you’re not qualified to directly purchase Ondo assets. If the situation changes, please return to complete the onboarding.\",\"usdyFooter\":\"Ondo Stocks users will automatically qualify for USDY.\",\"goBack\":\"Go back\",\"continue\":\"Continue\",\"exitOnboarding\":\"Exit Onboarding\",\"selectionRequiredTitle\":\"Selection Required\",\"selectionRequiredMessage\":\"Please select at least one product to continue.\",\"errorTitle\":\"Error\",\"errorGoBack\":\"Failed to go back. Please try again.\",\"errorContinue\":\"Failed to continue. Please try again.\",\"cards\":{\"global-markets\":{\"description\":\"Bring traditional public securities like stocks and ETFs on-chain, with tokens that are freely transferable and usable in DeFi.\"},\"ousg\":{\"description\":\"Built for institutional investors, OUSG offers exposure to short-term US Treasuries with 24/7 instant mints and redemptions.\",\"chipLabel\":\"Accredited Investor Only\"}}},\"identityVerification\":{\"title\":\"Identity Verification\",\"goBack\":\"Go back\",\"agreement\":\"Ondo uses Persona, a secure, leading identity verification solution, to help us verify your identity. The process will take around 5 minutes.\",\"errorTitle\":\"Something went wrong.\",\"errorMessage\":\"Please try again or contact {email} if the problem persists.\",\"missingProductsMessage\":\"Something went wrong. Please refresh the page to try again. If this persists, contact {email}\",\"savedErrorTitle\":\"Your inputs aren't saved.\",\"savedErrorMessage\":\"Try again later. If the issue continues, contact {email}.\",\"kyc\":{\"description\":\"Our KYC, powered by Persona, protects you from fraud and identity theft while ensuring regulatory compliance. Please prepare the following items before starting KYC.\",\"cta\":\"Start KYC\",\"requirements\":{\"photo-id\":{\"title\":\"Photo ID\",\"description\":\"ID card, passport, driver license supported.\"},\"proof-of-address\":{\"title\":\"Proof of Address\",\"description\":\"Documents that can prove the address, such as utility bills, etc.\"},\"facial-recognition\":{\"title\":\"Facial Recognition\",\"description\":\"Confirm that the portrait matches the picture on the identification document.\"}}},\"kyb\":{\"description\":\"Our KYB solution, powered by Persona, protects your business from fraud and identity theft while ensuring compliance. After you apply, our team will reach out to complete the KYB process. Please have the necessary documents ready.\",\"cta\":\"Start KYB\",\"requirements\":{\"memorandum-and-articles-of-association\":{\"title\":\"Memorandum and Articles of Association (or equivalent)\"},\"articles-of-existence\":{\"title\":\"Articles of Existence\",\"description\":\"Accepted documents include Certificate of Incorporation, Certificate of Formation, Certificate of Registration or licensing.\"},\"entity-proof-of-address\":{\"title\":\"Entity Proof of Address\",\"description\":\"Documents must be current (within 90 days) and validate your entity's Legal Registered Address. Accepted documents include correspondence from a government agency, bank statements, utility bills, or lease/mortgage statements.\"},\"other-documents\":{\"title\":\"Other Documents\",\"description\":\"Entity Structure Chart and Accredited Investor Evidence may be required.\"}}}},\"investorProfile\":{\"title\":\"Investor Profile\",\"subtitle\":\"We'll ask a few quick questions to ensure you qualify under local regulations.\",\"selectOne\":\"Select one that fits you.\",\"selectAll\":\"Select all that apply.\",\"warning\":\"Please confirm you have the proof before proceeding, as you will need to verify your selection later.\",\"goBack\":\"Go back\",\"continue\":\"Continue\",\"errorTitle\":\"Error\",\"errorGoBack\":\"Failed to go back. Please try again.\",\"errorContinue\":\"Failed to continue. Please try again.\",\"options\":{\"NET_WORTH\":\"My net worth exceeds USD $1,000,000\\n(excluding my primary residence)\",\"INCOME\":\"My income exceeds USD $200,000 individually (or USD $300,000 jointly) for the past two years, and I expect the same this year.\",\"FINANCIAL_LICENSE\":\"I hold a qualifying financial license\\n(Series 7, 65, or 82).\",\"NOT_QUALIFIED\":\"I do not meet these criteria.\",\"QUALIFIED_INVESTOR\":\"I am a Qualified Investor (BRL 1M+ in financial investments or certified qualification).\",\"PROFESSIONAL_INVESTOR\":\"I am a Professional Investor (BRL 10M+ in financial investments or equivalent accreditation).\",\"MALAYSIA_NET_ASSETS\":\"My net assets exceed MYR 3M (excluding my primary residence).\",\"MALAYSIA_INCOME\":\"My annual income exceeds MYR 300K individually or RM 400K jointly.\",\"MALAYSIA_NOT_QUALIFIED\":\"I do not meet these criteria.\",\"SINGAPORE_NET_ASSETS\":\"My net personal assets exceed SGD 2M (maximum SGD 1M from primary residence).\",\"SINGAPORE_FINANCIAL_ASSETS\":\"My financial assets exceed SGD 1M (net of liabilities).\",\"SINGAPORE_INCOME\":\"My annual income exceeds SGD 300K.\",\"SINGAPORE_NOT_QUALIFIED\":\"I do not meet these criteria.\",\"HONG_KONG_PORTFOLIO\":\"I have HKD 8M+ financial portfolio\\n(individually or jointly with associates).\",\"HONG_KONG_NOT_QUALIFIED\":\"I do not meet this criterion.\",\"SWITZERLAND_ASSETS_AND_KNOWLEDGE\":\"I have more than CHF 500K in assets and sufficient financial knowledge.\",\"SWITZERLAND_ASSETS_2M\":\"I have more than CHF 2M in assets.\",\"SWITZERLAND_PROFESSIONAL_STRUCTURE\":\"I invest through a professional private investment structure.\",\"SWITZERLAND_NOT_QUALIFIED\":\"I do not meet this criterion.\",\"EEA_PORTFOLIO\":\"I have EUR 500K+ financial portfolio.\",\"EEA_TRANSACTIONS\":\"I have 10 significant transactions each quarter over 4 quarters.\",\"EEA_FINANCIAL_EXPERIENCE\":\"I have 1+ year financial sector experience.\",\"EEA_NONE\":\"None of the above.\"}},\"resetModal\":{\"title\":\"Reset Application\",\"body\":\"Resetting the application will erase all your data. Do you want to continue?\",\"cancel\":\"Cancel\",\"reset\":\"Reset\",\"errorTitle\":\"Something went wrong\",\"errorBody\":\"We were unable to reset your application. Please try again or contact \u003cmail\u003e{email}\u003c/mail\u003e if the issue persists.\",\"dismiss\":\"Dismiss\"}},\"account\":{\"nav\":{\"title\":\"My Account\",\"access\":\"Access\",\"wallets\":\"Wallets\",\"bankDetails\":\"Bank Details\",\"documents\":\"Documents\",\"settings\":\"Settings\",\"contactSupport\":\"Contact Support\",\"logOut\":\"Log Out\"},\"documents\":{\"empty\":\"You currently don't have any documents\",\"download\":\"Download\"},\"contactSupport\":{\"needAssistanceTitle\