-scroll::-webkit-scrollbar-thumb {\n  background-color: rgba(0, 0, 0, 0.3);\n  border-radius: 5px;\n}\n\n.wide-table-scroll::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(0, 0, 0, 0.5);\n}\n\n.dark .wide-table-scroll {\n  background-image:\n    linear-gradient(to left, #0e1116, rgba(14, 17, 22, 0)),\n    linear-gradient(to left, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0));\n  scrollbar-color: rgba(255, 255, 255, 0.4) transparent;\n}\n\n.dark .wide-table-scroll::-webkit-scrollbar-thumb {\n  background-color: rgba(255, 255, 255, 0.3);\n}\n\n.dark .wide-table-scroll::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(255, 255, 255, 0.5);\n}\n\n.wide-table-scroll table {\n  border-collapse: separate;\n  border-spacing: 0;\n  width: max-content;\n  min-width: 100%;\n}\n\n.wide-table-scroll table th:first-child,\n.wide-table-scroll table td:first-child {\n  position: sticky;\n  left: 0;\n  z-index: 1000;\n  background-color: white !important;\n  padding-left: 0.75rem !important;\n  padding-right: 0.75rem !important;\n  box-shadow: 2px 0 4px -2px rgba(0, 0, 0, 0.15);\n}\n\n.dark .wide-table-scroll table th:first-child,\n.dark .wide-table-scroll table td:first-child {\n  background-color: #0e1116 !important;\n  box-shadow: 2px 0 4px -2px rgba(0, 0, 0, 0.5);\n}\n"])</script><script>self.__next_f.push([1,"45:[\"$\",\"$L46\",null,{\"theme\":\"mint\",\"pageMetadata\":{\"title\":\"Trust \u0026 Security\",\"description\":null,\"href\":\"/trust-and-security\"},\"children\":[\"$\",\"$L47\",null,{\"value\":{\"apiReferenceData\":{},\"graphqlReferenceData\":\"$undefined\"},\"children\":[\"$\",\"$L48\",null,{\"value\":{\"pageMetadata\":\"$45:props:pageMetadata\",\"lastModified\":\"2026-09-18T16:06:34.654Z\",\"gitLastModified\":\"$undefined\",\"originalFileLocation\":\"trust-and-security.mdx\",\"description\":null,\"mdxExtracts\":{\"tableOfContents\":[{\"title\":\"Institutional Partners\",\"slug\":\"institutional-partners\",\"depth\":2,\"children\":[]},{\"title\