/* Scroll affordances for wide tables (partner-docs/tokens, partner-docs/ofts) */

.wide-table-scroll > div.overflow-x-auto {
  overflow: visible !important;
  margin: 0 !important;
}

.wide-table-scroll {
  overflow-x: auto;
  background-image:
    linear-gradient(to left, white, rgba(255, 255, 255, 0)),
    linear-gradient(to left, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0));
  background-position: right center, right center;
  background-size: 40px 100%, 24px 100%;
  background-repeat: no-repeat, no-repeat;
  background-attachment: local, scroll;
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 0, 0, 0.4) transparent;
}

.wide-table-scroll::-webkit-scrollbar {
  height: 10px;
}

.wide-table-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.wide-table-scroll::-webkit-scrollbar-thumb {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 5px;
}

.wide-table-scroll::-webkit-scrollbar-thumb:hover {
