  scrollbar-color: rgba(255, 255, 255, 0.4) transparent;
}

.dark .wide-table-scroll::-webkit-scrollbar-thumb {
  background-color: rgba(255, 255, 255, 0.3);
}

.dark .wide-table-scroll::-webkit-scrollbar-thumb:hover {
  background-color: rgba(255, 255, 255, 0.5);
}

.wide-table-scroll table {
  border-collapse: separate;
  border-spacing: 0;
  width: max-content;
  min-width: 100%;
}

.wide-table-scroll table th:first-child,
.wide-table-scroll table td:first-child {
  position: sticky;
  left: 0;
  z-index: 1000;
  background-color: white !important;
  padding-left: 0.75rem !important;
  padding-right: 0.75rem !important;
  box-shadow: 2px 0 4px -2px rgba(0, 0, 0, 0.15);
}

.dark .wide-table-scroll table th:first-child,
.dark .wide-table-scroll table td:first-child {
  background-color: #0e1116 !important;
  box-shadow: 2px 0 4px -2px rgba(0, 0, 0, 0.5);
}
