itle\":\"Global Markets\"},{\"id\":\"1e5696f7-4f32-4c7a-9198-5bdc4f052df2\",\"title\":\"Ondo Chain \"},{\"id\":\"a62fa25f-e678-4c03-9e4a-059dc71c69d5\",\"title\":\"USDY\"}],\"blogCarouselPosts\":[{\"altText\":\"Ondo Finance’s Oasis Pro Markets Secures FINRA Authorizations to Offer Broad Range of Tokenized Equities and Funds to U.S. Investors\",\"author\":{\"id\":\"d836f05a-e7bd-47c8-b4b7-121891b90519\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/721e2e3edb6efe6472b4dbad446079199a216cef-200x200.png\",\"name\":\"Ondo Finance\",\"title\":\"Official Blog\"},\"backgroundColor\":\"#E0ECFF\",\"body\":\"$16\",\"id\":\"13de1fc0-4fb3-4512-a2c3-d3e4733550d4\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/27395d5a366983d36774eacef36423280bca8619-1600x960.png\",\"isGeofenced\":false,\"previewText\":\"New FINRA authorizations allow Ondo, via Oasis Pro Markets, to launch regulated markets and services for tokenized securities in the U.S. under SEC and FINRA oversight.\",\"publishedAt\":\"2026-07-23T12:30:00.000Z\",\"readLength\":\"5 min\",\"routeName\":\"finra-authorizations-to-offer-tokenized-equities\",\"tags\":[\"Announcement\"],\"title\":\"Ondo Finance’s Oasis Pro Markets Secures FINRA Authorizations to Offer Broad Range of Tokenized Equities and Funds to U.S. Investors\"},{\"altText\":\"Ondo and SBI Group Partner \",\"author\":{\"id\":\"d836f05a-e7bd-47c8-b4b7-121891b90519\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/721e2e3edb6efe6472b4dbad446079199a216cef-200x200.png\",\"name\":\"Ondo Finance\",\"title\":\"Official Blog\"},\"backgroundColor\":\"#E0ECFF\",\"body\":\"$17\",\"id\":\"4ae7bf5e-56da-437c-b3e1-d5972b510212\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/1f4e26df806d6fa8fc0f8a3ac78af3a4d485e761-1600x900.png\",\"isGeofenced\":true,\"previewText\":\"Ondo Finance and SBI Group, one of Japan's largest financial conglomerates, today announced a strategic partnership. Under the partnership, the companies will bring Japanese equities onchain, distribute Ondo tokenized products across the SBI Group ecosystem, and adopt SBI's JPYSC stablecoin for onchain settlement and collateral.\",\"publishedAt\":\"2026-07-16T12:00:00.000Z\",\"readLength\":\"2 min\",\"routeName\":\"ondo-partners-with-sbi-group\",\"tags\":[\"Ondo Stocks\"],\"title\":\"Ondo and SBI Group Partner to Bring Japanese Equities Onchain\"},{\"altText\":\"Ondo Finance and DTCC\",\"author\":{\"id\":\"d836f05a-e7bd-47c8-b4b7-121891b90519\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/721e2e3edb6efe6472b4dbad446079199a216cef-200x200.png\",\"name\":\"Ondo Finance\",\"title\":\"Official Blog\"},\"backgroundColor\":\"#EBF0E7\",\"body\":\"$18\",\"id\":\"6a2e4638-041d-4af9-ae98-f5d2c6e6900c\",\"imageUrl\":\"https://cdn.sanity.io/images/8k2tqa6n/production/20d4d83a3672dcb6dfc5d1adebfab4444fa24463-1600x960.png\",\"isGeofenced\":false,\"previewText\":\"Ondo Finance today launched the first tokenized stock representations based on DTC tokenized entitlements to DTC-held securities generated through the DTCC Tokenization Service.\",\"publishedAt\":\"2026-07-15T11:00:00.000Z\",\"readLength\":\"4 min\",\"routeName\":\"ondo-and-dtcc-collaborate-on-tokenized-stocks\",\"tags\":[\"Ondo Stocks\"],\"title\":\"Ondo Finance Debuts First-Ever Tokenized Stocks Based on DTC Tokenized Entitlements to DTC-Held Securities \"}]}]\n"])</script></body></html>