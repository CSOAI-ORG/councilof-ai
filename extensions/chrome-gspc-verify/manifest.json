{
  "manifest_version": 3,
  "name": "GSPC Verify — Council of AI",
  "version": "0.2.0",
  "description": "Shows the live GSPC measurement board (councilof.ai/api/gspc), a signed-card badge on Hugging Face model pages, and verifies a pasted card offline. Measurement, not certification. Verify is free.",
  "homepage_url": "https://councilof.ai",
  "action": {
    "default_title": "GSPC — live board · verify a card",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://huggingface.co/*"
      ],
      "js": [
        "content/hf-badge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://councilof.ai/*",
        "https://meok.ai/*"
      ],
      "js": [
        "content/ai-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.mjs"
      ],
      "matches": [
        "https://huggingface.co/*"
      ]
    }
  ],
  "host_permissions": [
    "https://councilof.ai/*",
    "https://huggingface.co/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://nicholastempleman-meok-sov6-abstraction-overlay.hf.space/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://api.anthropic.com/*",
    "https://router.huggingface.co/*",
    "https://integrate.api.nvidia.com/*"
  ]
}
