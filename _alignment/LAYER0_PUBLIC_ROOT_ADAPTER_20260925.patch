@@ -0,0 +1,41 @@
+"""Fail-closed controls for the isolated public-root CLI adapter."""
+
+import contextlib
+import io
+import json
+import sys
+import unittest
+from unittest import mock
+
+from sovos_layer0_harness import cli, root_verify
+
+
+class PublicRootCliTests(unittest.TestCase):
+    def test_unavailable_sources_exit_nonzero_and_remain_uncheckable(self):
+        seen = []
+
+        def unavailable(url):
+            seen.append(url)
+            return None, "test: unavailable"
+
+        output = io.StringIO()
+        with mock.patch.object(sys, "argv", ["sovos-l0", "verify-public-root"]), \
+                mock.patch.object(root_verify, "fetch", side_effect=unavailable), \
+                contextlib.redirect_stdout(output):
+            self.assertEqual(cli.main(), 2)
+
+        result = json.loads(output.getvalue())
+        self.assertEqual(result["overall"], "UNCHECKABLE")
+        self.assertEqual(seen, [root_verify.ROOT_URL, root_verify.MIRROR_URL, root_verify.DID_URL])
+        self.assertEqual({c["status"] for c in result["checks"]}, {"UNCHECKABLE"})
+
+    def test_cli_cannot_redirect_trust_sources(self):
+        with mock.patch.object(sys, "argv", ["sovos-l0", "verify-public-root", "--did-url", "https://example.com/did.json"]), \
+                contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as exit_state:
+                cli.main()
+        self.assertEqual(exit_state.exception.code, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
