diff --git a/scripts/learning-coverage.node-test.mjs b/scripts/learning-coverage.node-test.mjs
new file mode 100644
index 000000000..2802c46fe
--- /dev/null
+++ b/scripts/learning-coverage.node-test.mjs
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  learningBoardUrl,
+  learningCoverageLabel,
+  readBoardAxisCount,
+} from "../client/src/lib/learningCoverage.ts";
+
+test("learning coverage uses only the current board's numeric axis count", () => {
+  assert.equal(readBoardAxisCount({ totals: { axes: 23 } }), 23);
+  for (const value of [null, {}, { totals: { axes: "23" } }, { totals: { axes: -1 } }]) {
+    assert.equal(readBoardAxisCount(value), null);
+  }
+});
+
+test("learning copy distinguishes snapshot lessons from current board axes", () => {
+  assert.equal(learningCoverageLabel(22, 23), "22 snapshot paths · 23 live board axes");
+  assert.equal(learningCoverageLabel(22, null), "22 snapshot paths");
+});
+
+test("local review reads the public board", () => {
+  assert.equal(learningBoardUrl("localhost"), "https://councilof.ai/api/gspc");
+  assert.equal(learningBoardUrl("councilof.ai"), "/api/gspc");
+});
