@@ -0,0 +1,96 @@
+import {
+  ArrowRight,
+  FileSearch,
+  ShieldCheck,
+  TriangleAlert,
+} from "lucide-react";
+import { Link } from "wouter";
+
+const EVIDENCE_DOORS = [
+  {
+    title: "Read the measurement board",
+    description:
+      "See what has been measured, the source for each axis, and the limits of each result.",
+    href: "/dashboard?tab=board",
+    icon: FileSearch,
+  },
+  {
+    title: "Verify a signed card",
+    description:
+      "Check an existing card's signature and body hash in the free verifier.",
+    href: "/dashboard?tab=verify",
+    icon: ShieldCheck,
+  },
+  {
+    title: "Read the corrections ledger",
+    description:
+      "Review published corrections and the evidence behind the Council's own claims.",
+    href: "/dashboard?tab=attestations",
+    icon: TriangleAlert,
+  },
+] as const;
+
+export default function DashboardWatchdogPane() {
+  return (
+    <section
+      aria-labelledby="dashboard-watchdog-title"
+      className="mx-auto max-w-5xl px-5 py-8 pb-[calc(13rem+env(safe-area-inset-bottom))] sm:px-8 lg:pb-8"
+      data-testid="dashboard-watchdog-pane"
+    >
+      <header className="max-w-3xl">
+        <p className="text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-800">
+          Public evidence · read only
+        </p>
+        <h1
+          id="dashboard-watchdog-title"
+          className="mt-2 text-3xl font-semibold tracking-tight text-foreground"
+        >
+          Watchdog evidence
+        </h1>
+        <p className="mt-3 text-sm leading-relaxed text-muted-foreground">
+          Follow the public record from a measurement to any available signed
+          card and published correction. These are evidence-reading tools;
+          viewing them does not file an incident or create a case.
+        </p>
+      </header>
+
+      <div className="mt-7 grid gap-3 md:grid-cols-3">
+        {EVIDENCE_DOORS.map(({ title, description, href, icon: Icon }) => (
+          <Link
+            key={href}
+            href={href}
+            className="group rounded-2xl border border-border bg-card p-5 shadow-sm transition hover:border-emerald-700/35 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700"
+          >
+            <Icon className="h-5 w-5 text-emerald-800" aria-hidden="true" />
+            <h2 className="mt-4 text-sm font-semibold text-foreground">
+              {title}
+            </h2>
+            <p className="mt-2 text-xs leading-relaxed text-muted-foreground">
+              {description}
+            </p>
+            <span className="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 group-hover:underline">
+              Open in dashboard
+              <ArrowRight className="h-3.5 w-3.5" aria-hidden="true" />
+            </span>
+          </Link>
+        ))}
+      </div>
+
+      <aside
+        aria-label="Incident report availability"
+        className="mt-6 rounded-2xl border border-amber-700/25 bg-amber-50 p-5 text-amber-950"
+        data-testid="watchdog-intake-state"
+      >
+        <p className="text-[10px] font-bold uppercase tracking-[0.16em]">
+          Incident filing · unavailable
+        </p>
+        <h2 className="mt-2 text-base font-semibold">No report is filed here</h2>
+        <p className="mt-2 max-w-3xl text-xs leading-relaxed">
+          Durable report submission, storage, case numbers and signed
+          acknowledgements are not implemented. Nothing entered in Council chat
+          should be treated as a filed incident report.
+        </p>
+      </aside>
+    </section>
+  );
+}
