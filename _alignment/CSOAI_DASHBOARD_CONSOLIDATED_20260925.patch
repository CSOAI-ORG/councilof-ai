@@ -0,0 +1,25 @@
+export function learningBoardUrl(hostname?: string): string {
+  const path = "/api/gspc";
+  const local = hostname === "127.0.0.1" || hostname === "localhost";
+  return local ? `https://councilof.ai${path}` : path;
+}
+
+/** A count is displayed only when the current public board supplied it. */
+export function readBoardAxisCount(value: unknown): number | null {
+  if (!value || typeof value !== "object") return null;
+  const totals = (value as { totals?: unknown }).totals;
+  if (!totals || typeof totals !== "object") return null;
+  const count = (totals as { axes?: unknown }).axes;
+  return typeof count === "number" && Number.isSafeInteger(count) && count >= 0
+    ? count
+    : null;
+}
+
+export function learningCoverageLabel(
+  lessonCount: number,
+  boardAxes: number | null,
+): string {
+  return boardAxes === null
+    ? `${lessonCount} snapshot paths`
+    : `${lessonCount} snapshot paths · ${boardAxes} live board axes`;
+}
