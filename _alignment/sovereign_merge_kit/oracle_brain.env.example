# SOV33 Oracle brain — source this before running OWEM to route L4 through Oracle GenAI.
# Fill ORACLE_GENAI_MODEL with the exact model string from your Oracle console
# (Generative AI → Playground → the model dropdown; e.g. cohere.command-r-plus-08-2024).
export ORACLE_GENAI_KEY='sk-...'                                   # your Oracle GenAI API key
export ORACLE_GENAI_ENDPOINT='https://inference.generativeai.uk-london-1.oci.oraclecloud.com'
export ORACLE_GENAI_MODEL='cohere.command-r-plus-08-2024'          # <- confirm exact name in console
# then:  source oracle_brain.env && python3 sov33_generals_bridge.py
