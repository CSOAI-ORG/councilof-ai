+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  learningBoardUrl,
+  learningCoverageLabel,
+  readBoardAxisCount,
+  readBoardAxisIds,
+} from "../client/src/lib/learningCoverage.ts";
+
+test("learning coverage uses only the current board's numeric axis count", () => {
+  assert.equal(readBoardAxisCount({ totals: { axes: 23 } }), 23);
+  for (const value of [
+    null,
+    {},
+    { totals: { axes: "23" } },
+    { totals: { axes: -1 } },
+  ]) {
+    assert.equal(readBoardAxisCount(value), null);
+  }
+});
+
+test("learning gap names only validated live board axis ids", () => {
+  assert.deepEqual(
+    readBoardAxisIds({
+      axes: [{ axis: "governance" }, { axis: "effect-binding" }],
+    }),
+    ["governance", "effect-binding"],
+  );
+  for (const value of [
+    null,
+    {},
+    { axes: [{}] },
+    { axes: [{ axis: "" }] },
+    { axes: [{ axis: "same" }, { axis: "same" }] },
+  ]) {
+    assert.equal(readBoardAxisIds(value), null);
