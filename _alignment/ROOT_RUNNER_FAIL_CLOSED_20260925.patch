-# run_ceremony.sh — one-shot ROOT ceremony runner.
+# run_ceremony.sh — retired one-shot ROOT ceremony runner.
 #
 # Runs phases 0–6 of the ceremony checklist. You provide the dice rolls;
 # everything else is automated.
@@ -15,6 +15,15 @@
 # responsibility to physically destroy after Phase 6 distribution.
 set -euo pipefail
 
+# This historical shortcut is NOT a production genesis ceremony. It used the
+# same Shamir implementation for both sides of its purported independent
+# cross-check, accepted roll material through process arguments, created a
+# directory without proving disposable-medium placement, and printed
+# "CEREMONY COMPLETE" before custody/disposal. Never let it mint a card #0.
+printf '%s\n' 'REFUSING: run_ceremony.sh cannot establish ROOT-alpha/ROOT-beta custody.' >&2
+printf '%s\n' 'Use docs/operations/root-ceremony/ROOT-CEREMONY-CHECKLIST-2026-09-12.md on an airgapped disposable medium with an independently pinned Shamir checker.' >&2
+exit 78
+
 SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
 REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
 TEMPLATE="$REPO_ROOT/docs/operations/root-ceremony/card0-genesis.template.json"
