diff --git a/mcp/csoai-governance/gateway-sign.mjs b/mcp/csoai-governance/gateway-sign.mjs
new file mode 100644
index 000000000..cb8f96a8b
--- /dev/null
+++ b/mcp/csoai-governance/gateway-sign.mjs
@@ -0,0 +1,65 @@
+import { validateGatewaySeal } from "./verify-seal.mjs";
+
+const HEX_32 = /^[0-9a-fA-F]{64}$/;
+
+/** A signing tool is advertised only when an operator names both its endpoint and expected key. */
+export function signingConfigured(endpoint, expectedPublicKey) {
+  if (!HEX_32.test(expectedPublicKey || "")) return false;
+  try {
+    const url = new URL(endpoint);
+    return url.protocol === "https:" && !url.username && !url.password && !url.search && !url.hash;
+  } catch {
+    return false;
+  }
+}
+
+export function advertisedTools(tools, endpoint, expectedPublicKey) {
+  return signingConfigured(endpoint, expectedPublicKey)
+    ? tools
+    : tools.filter((tool) => tool.name !== "csoai_sign");
+}
+
+/** Request a seal without treating an HTML fallback or a self-declared key as authority. */
+export async function requestGatewaySeal(artifact, { endpoint, expectedPublicKey, fetchImpl = fetch } = {}) {
+  if (typeof artifact !== "string" || !artifact.length) {
+    return { verdict: "UNCHECKABLE", reason: "artifact must be nonempty text" };
+  }
+  if (!signingConfigured(endpoint, expectedPublicKey)) {
+    return {
+      verdict: "UNAVAILABLE",
+      reason: "signing is not configured: an HTTPS CSOAI_SIGN_ENDPOINT and pinned CSOAI_SIGNER_PUBLIC_KEY are required; no signature was issued",
+    };
+  }
+
+  let response;
+  try {
+    response = await fetchImpl(endpoint, {
+      method: "POST",
+      headers: { "content-type": "application/json", accept: "application/json", "user-agent": "csoai-governance-mcp/0.1" },
+      body: JSON.stringify({ message: artifact }),
+    });
+  } catch {
+    return { verdict: "UNAVAILABLE", reason: "configured signing endpoint could not be reached; no signature was issued" };
+  }
+  if (!response.ok) {
+    return { verdict: "UNAVAILABLE", reason: `configured signing endpoint returned HTTP ${response.status}; no signature was issued` };
+  }
+  const contentType = response.headers?.get?.("content-type") || "";
+  if (!/^application\/(?:[\w.-]+\+)?json(?:\s*;|\s*$)/i.test(contentType)) {
+    return { verdict: "UNAVAILABLE", reason: "configured signing endpoint returned non-JSON content (possibly a static HTML fallback); no signature was issued" };
+  }
+  let seal;
+  try {
+    seal = await response.json();
+  } catch {
+    return { verdict: "UNAVAILABLE", reason: "configured signing endpoint returned invalid JSON; no signature was issued" };
+  }
+  if (typeof seal?.publicKey !== "string" || seal.publicKey.toLowerCase() !== expectedPublicKey.toLowerCase()) {
+    return { verdict: "INVALID", reason: "gateway public key does not match the pinned signer; no seal accepted" };
+  }
+  const check = validateGatewaySeal(artifact, seal);
+  if (check.verdict !== "VALID") {
+    return { verdict: check.verdict, reason: `gateway seal failed exact-byte verification: ${check.reason || check.verdict}` };
+  }
+  return { verdict: "VALID", seal };
+}
diff --git a/mcp/csoai-governance/gateway-sign.test.mjs b/mcp/csoai-governance/gateway-sign.test.mjs
new file mode 100644
index 000000000..045259498
--- /dev/null
+++ b/mcp/csoai-governance/gateway-sign.test.mjs
@@ -0,0 +1,74 @@
+import assert from "node:assert/strict";
+import { generateKeyPairSync, sign } from "node:crypto";
+import test from "node:test";
+import { advertisedTools, requestGatewaySeal, signingConfigured } from "./gateway-sign.mjs";
+
+const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+const expectedPublicKey = publicKey.export({ format: "der", type: "spki" }).subarray(-32).toString("hex");
+const artifact = "sha256:77caae06\n";
+const endpoint = "https://signer.example.invalid/api/sign";
+
+function response(status, contentType, payload) {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    headers: { get: () => contentType },
+    json: async () => payload,
+  };
+}
+
+test("unconfigured signer is unavailable without making a request", async () => {
+  let called = false;
+  const result = await requestGatewaySeal(artifact, { fetchImpl: async () => { called = true; } });
+  assert.equal(result.verdict, "UNAVAILABLE");
+  assert.match(result.reason, /no signature was issued/);
+  assert.equal(called, false);
+  assert.equal(signingConfigured("https://os.meok.ai/api/sign", ""), false);
+  assert.deepEqual(advertisedTools([{ name: "csoai_sign" }, { name: "csoai_verify" }], "", ""), [{ name: "csoai_verify" }]);
+  assert.equal(advertisedTools([{ name: "csoai_sign" }], endpoint, expectedPublicKey).length, 1);
+});
+
+test("a 405 from the absent POST /api/sign route is unavailable, not signed", async () => {
+  const result = await requestGatewaySeal(artifact, {
+    endpoint,
+    expectedPublicKey,
+    fetchImpl: async (url, options) => {
+      assert.equal(url, endpoint);
+      assert.equal(options.method, "POST");
+      assert.equal(options.headers["content-type"], "application/json");
+      assert.deepEqual(JSON.parse(options.body), { message: artifact });
+      return response(405, "text/html; charset=utf-8", null);
+    },
+  });
+  assert.equal(result.verdict, "UNAVAILABLE");
+  assert.match(result.reason, /HTTP 405.*no signature was issued/);
+  assert.equal(result.seal, undefined);
+});
+
+test("a 200 static HTML /api/sign fallback is unavailable, not a valid seal", async () => {
+  const result = await requestGatewaySeal(artifact, {
+    endpoint,
+    expectedPublicKey,
+    fetchImpl: async () => response(200, "text/html; charset=utf-8", "<html>SPA</html>"),
+  });
+  assert.equal(result.verdict, "UNAVAILABLE");
+  assert.match(result.reason, /non-JSON content.*no signature was issued/);
+  assert.equal(result.seal, undefined);
+});
+
+test("a valid gateway signature must match the pinned key and exact bytes", async () => {
+  const seal = {
+    canonical: artifact,
+    publicKey: expectedPublicKey,
+    signature: sign(null, Buffer.from(artifact, "utf8"), privateKey).toString("hex"),
+  };
+  const fetchImpl = async () => response(200, "application/json; charset=utf-8", seal);
+  assert.equal((await requestGatewaySeal(artifact, { endpoint, expectedPublicKey, fetchImpl })).verdict, "VALID");
+  assert.equal((await requestGatewaySeal(artifact + "!", { endpoint, expectedPublicKey, fetchImpl })).verdict, "INVALID");
+  assert.equal((await requestGatewaySeal(artifact, { endpoint, expectedPublicKey: "00".repeat(32), fetchImpl })).verdict, "INVALID");
+});
+
+test("non-HTTPS and query-string credentials never enable signing", () => {
+  assert.equal(signingConfigured("http://signer.example.invalid/api/sign", expectedPublicKey), false);
+  assert.equal(signingConfigured("https://signer.example.invalid/api/sign?token=secret", expectedPublicKey), false);
+});
