+    boundary: "A declared slot is not a measured result.",
+  },
+  get_axis: {
+    glyph: "1", label: "Read one GSPC axis",
+    useFor: "Inspect the evidence and status behind a named axis on the public board.",
+    returns: "That axis row, its run or bank reference, and its dates.",
+    boundary: "An UNMEASURED axis remains a visible gap, never a zero score.",
+  },
+  verify_card: {
+    glyph: "✓", label: "Verify a signed card",
+    useFor: "Check one published measurement card or a card you paste.",
