+  },
+  list_cards: {
+    glyph: "▤", label: "Browse signed cards",
+    useFor: "Find recent cards, optionally filtered to one axis.",
+    returns: "Index rows and separately labelled index/store counts.",
+    boundary: "Index presence is not independent verification of every card.",
+  },
+  get_root: {
+    glyph: "◇", label: "Read the public root",
+    useFor: "Get the current public-root snapshot and its date.",
+    returns: "Root hash, card count and stated gaps.",
+    boundary: "Fetching the root is not a signature or Bitcoin-anchor check.",
+  },
+  get_card: {
+    glyph: "□", label: "Fetch a root card",
+    useFor: "Retrieve a public-root leaf by its full SHA-256 digest.",
+    returns: "One card-v0 leaf or an explicit unavailable state.",
+    boundary: "A root leaf is not the same as a signed GSPC measurement card.",
+  },
+  verify_inclusion: {
+    glyph: "⊂", label: "Check root inclusion",
+    useFor: "Test whether a digest is included in the current public root.",
+    returns: "VALID, INVALID or UNCHECKABLE for the Merkle inclusion check.",
+    boundary: "Inclusion alone does not verify an Ed25519 signature.",
+  },
+  x402_trust: {
+    glyph: "402", label: "x402 catalogue checks",
+    useFor: "Read the latest public census of x402 resources that answer on the wire.",
