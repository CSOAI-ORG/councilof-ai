--- a/client/src/lib/mcpTools.test.ts
+++ b/client/src/lib/mcpTools.test.ts
@@ -1,6 +1,7 @@
 import { describe, expect, it } from "vitest";
 import { readFileSync } from "node:fs";
 import { ALL_TOOL_NAMES, FREE_TOOL_NAMES, PAID_TOOL_NAMES, toolSummary } from "./mcpTools";
+import { TOOL_META } from "./sovTools";
 
 const J = (rel: string) => JSON.parse(readFileSync(new URL(rel, import.meta.url), "utf8"));
 
@@ -57,3 +58,16 @@ describe("no component keeps its own copy of the door's tool set", () => {
     });
   }
 });
+
+describe("the callable fleet has an end-user explanation", () => {
+  it("covers every tool in the manifests without falling back to code names", () => {
+    expect(ALL_TOOL_NAMES.filter((name) => !TOOL_META[name])).toEqual([]);
+    for (const name of ALL_TOOL_NAMES) {
+      const guide = TOOL_META[name];
+      expect(guide.label).not.toBe(name);
+      expect(guide.useFor.length).toBeGreaterThan(20);
+      expect(guide.returns.length).toBeGreaterThan(20);
+      expect(guide.boundary.length).toBeGreaterThan(20);
+    }
+  });
+});
