+// Human guidance for the current published MCP fleet. The live tools/list
+// remains the authority for availability, inputs and payment state; this copy
+// only helps a reader choose a tool. A test compares these names with the two
+// manifests used by /mcp so a fleet change cannot silently leave raw names in
+// the interface again.
+export type ToolPresentation = {
+  glyph: string;
+  label: string;
+  useFor: string;
+  returns: string;
+  boundary: string;
+};
+
+export const TOOL_META: Record<string, ToolPresentation> = {
+  board_totals: {
+    glyph: "#", label: "Board totals",
+    useFor: "See how many axis positions exist and how many have admitted measurements.",
