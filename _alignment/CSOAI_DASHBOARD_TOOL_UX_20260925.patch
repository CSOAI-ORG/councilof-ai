+  commission_card: {
+    glyph: "+", label: "Commission a card",
+    useFor: "Request a scoped receipt for a named subject already represented on the frozen bank.",
+    returns: "A free preview or 402 challenge first; the paid route assembles existing evidence.",
+    boundary: "Payment does not create a new measured cell or guarantee a fresh run.",
+  },
+  art50_marking_evidence: {
+    glyph: "50", label: "Check output marking",
+    useFor: "Inspect one generative output for detectable machine-readable marking.",
