-    if (d.kind === "inclusion") return { state: "VALID", sha256: sha, merkle_root: d.merkle_root ?? null, not_a_certification: true };
-    if (d.error === "not_found") return { state: "INVALID", sha256: sha, reason: d.reason ?? "not a leaf", not_a_certification: true };
-    return { state: "UNCHECKABLE", sha256: sha, reason: d.reason ?? "unexpected proof body", not_a_certification: true };
+    if (d && typeof d === "object" && !Array.isArray(d) && d.kind === "inclusion") {
+      if (String(d.sha256 ?? d.sha ?? "").toLowerCase() !== sha ||
+          !Number.isSafeInteger(d.index) || (d.index as number) < 0 ||
+          !Number.isSafeInteger(d.card_count) || (d.card_count as number) <= (d.index as number) ||
+          !Array.isArray(d.proof) || !/^[0-9a-f]{64}$/i.test(String(d.merkle_root ?? ""))) {
+        return { state: "UNCHECKABLE", sha256: sha, reason: "Proof response is missing or contradicts required inclusion fields.", not_a_certification: true };
+      }
+      return {
+        state: "REPORTED_UNVERIFIED",
+        reported_inclusion: true,
+        sha256: sha,
+        merkle_root: d.merkle_root,
+        reason: "The proof endpoint reports inclusion; this tool has not recomputed the path or verified the signed root.",
+        not_a_certification: true,
+      };
+    }
+    if (d && typeof d === "object" && !Array.isArray(d) && d.error === "not_found") {
+      return { state: "REPORTED_UNVERIFIED", reported_inclusion: false, sha256: sha, reason: "The proof endpoint reports no leaf in its current root; absence is not independently verified.", not_a_certification: true };
+    }
+    return { state: "UNCHECKABLE", sha256: sha, reason: d?.reason ?? "unexpected proof body", not_a_certification: true };
   } catch (e) {
     if (isHttp404(e)) {
-      return { state: "INVALID", sha256: sha, reason: "not a leaf", not_a_certification: true };
+      return { state: "UNCHECKABLE", sha256: sha, reason: "Proof endpoint returned HTTP 404; this does not prove non-inclusion.", not_a_certification: true };
+    }
+    if (e instanceof SyntaxError) {
+      return { state: "UNCHECKABLE", sha256: sha, reason: "Proof response is not readable JSON.", not_a_certification: true };
     }
-    return { ...unreachablePayload(origin, `/api/proof?sha=${sha}`, e), state: "UNCHECKABLE", sha256: sha };
+    return { ...unreachablePayload(origin, `/api/proof?sha=${sha}`, e), sha256: sha, not_a_certification: true };
   }
 }
