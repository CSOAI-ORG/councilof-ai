   } catch (e) {
+    if (e instanceof SyntaxError) {
+      return { state: "UNCHECKABLE", source: `${origin}/root.json`, reason: "Root response is not readable JSON.", not_a_certification: true, not_gspc: true };
+    }
     return { ...unreachablePayload(origin, "/root.json", e), state: "UNREACHABLE", not_gspc: true };
   }
 }
