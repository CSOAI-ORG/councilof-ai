diff --git a/functions/mcp/_board.node-test.ts b/functions/mcp/_board.node-test.ts
new file mode 100644
index 000000000..6f5137e9b
--- /dev/null
+++ b/functions/mcp/_board.node-test.ts
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { getRootTool, verifyInclusionTool } from "./_board.ts";
+
+const origin = "https://fixture.invalid";
+const sha = "a".repeat(64);
+const merkle = "b".repeat(64);
+
+async function callWithFetch<T>(response: Response | Error, fn: () => Promise<T>): Promise<T> {
+  const previous = globalThis.fetch;
+  globalThis.fetch = async () => {
+    if (response instanceof Error) throw response;
+    return response;
+  };
+  try {
+    return await fn();
+  } finally {
+    globalThis.fetch = previous;
+  }
+}
+
+const json = (body: unknown, status = 200) => Response.json(body, { status });
+
+test("HTTP get_root reports fetched fields without a verification verdict", async () => {
+  const result = await callWithFetch(json({ kind: "public-root", card_count: 2, merkle_root: merkle }), () => getRootTool(origin));
+  assert.equal(result.state, "RETRIEVED_UNVERIFIED");
+  assert.equal(result.verification, "NOT_PERFORMED");
+  assert.match(result.reason, /not checked.*Merkle tree.*Ed25519/i);
+  assert.equal(result.card_count, 2);
+});
+
+test("HTTP get_root rejects a syntactically incomplete root", async () => {
+  const result = await callWithFetch(json({ merkle_root: merkle }), () => getRootTool(origin));
+  assert.equal(result.state, "UNCHECKABLE");
+});
+
+test("HTTP get_root reports an unreachable source distinctly", async () => {
+  const result = await callWithFetch(new Error("offline"), () => getRootTool(origin));
+  assert.equal(result.state, "UNREACHABLE");
+});
+
+test("HTTP inclusion reports endpoint inclusion without certifying the path", async () => {
+  const body = { kind: "inclusion", sha256: sha, index: 0, card_count: 1, proof: [], merkle_root: merkle };
+  const result = await callWithFetch(json(body), () => verifyInclusionTool(origin, { sha256: sha }));
+  assert.equal(result.state, "REPORTED_UNVERIFIED");
+  assert.equal(result.reported_inclusion, true);
+  assert.match(result.reason, /not recomputed.*verified/i);
+});
+
+test("HTTP inclusion reports endpoint absence without claiming INVALID", async () => {
+  const result = await callWithFetch(json({ error: "not_found", sha }), () => verifyInclusionTool(origin, { sha256: sha }));
+  assert.equal(result.state, "REPORTED_UNVERIFIED");
+  assert.equal(result.reported_inclusion, false);
+});
+
+test("HTTP inclusion rejects a mismatched digest and does not treat 404 as proof", async () => {
+  const mismatched = { kind: "inclusion", sha256: "c".repeat(64), index: 0, card_count: 1, proof: [], merkle_root: merkle };
+  assert.equal((await callWithFetch(json(mismatched), () => verifyInclusionTool(origin, { sha256: sha }))).state, "UNCHECKABLE");
+  assert.equal((await callWithFetch(json({ error: "not_found" }, 404), () => verifyInclusionTool(origin, { sha256: sha }))).state, "UNCHECKABLE");
+});
+
+test("HTTP inclusion reports transport failure as UNREACHABLE", async () => {
+  const result = await callWithFetch(new Error("offline"), () => verifyInclusionTool(origin, { sha256: sha }));
+  assert.equal(result.state, "UNREACHABLE");
+});
